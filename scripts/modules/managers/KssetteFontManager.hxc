package kassettehud.util;

import kassettehud.util.KassetteHUDElement;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.data.notestyle.NoteStyleRegistry;
import Std;

class KssetteFontManager extends Module {
    public static var instance:Dynamic = null;
    public var _cachedHudFont:String = "";
    public var _cachedHudStyleId:String = "";
    public var lastFontKey:String = "";
    public var cachedCustomFontPath:String = "";
    public var lastPixelFontKey:String = "";
    public var cachedCustomPixelFontPath:String = "";

    /**
     * Constructor for the component.
     */
    public function new() {
        super("KssetteFontManager");
        this.active = true;
        KssetteFontManager.instance = this;
    }

    /**
     * Clears cached font resolutions.
     * Forces the manager to re-evaluate the NoteStyle or user preference on the 
     * next request, ensuring fonts update dynamically when switching songs or options.
     */
    public function invalidateCache() {
        _cachedHudFont = "";
        _cachedHudStyleId = "";
        lastFontKey = "";
        lastPixelFontKey = "";
        cachedCustomFontPath = "";
        cachedCustomPixelFontPath = "";
    }

    /**
     * Retrieves a complete font definition object using its configuration identifier.
     * Uses a mapping to resolve the physical font file from the user's setting.
     * 
     * @param id The font key to resolve (e.g. 'kssette_font_hud').
     * @return A dynamic object with font attributes, or a fallback to VCR/Pixel.
     */
    public function getHudFont():String {
        var styleId:String = "funkin";
        
        if (PlayState.instance != null) {
            if (PlayState.instance.currentChart != null) {
                var pData = PlayState.instance.currentChart?.playData;
                if (pData != null) {
                    var nStyle = pData?.noteStyle;
                    if (nStyle != null) styleId = Std.string(nStyle);
                } else {
                    var nStyle = PlayState.instance.currentChart?.noteStyle;
                    if (nStyle != null) styleId = Std.string(nStyle);
                }
            }
        }

        if (_cachedHudFont != "" && _cachedHudStyleId == styleId) return _cachedHudFont;

        var currentStyleId:String = styleId;
        var depth:Int = 0;
        var maxDepth:Int = 5;
        
        while (currentStyleId != null && depth < maxDepth) {
            var styleEntry = NoteStyleRegistry.instance.fetchEntry(currentStyleId);
            if (styleEntry == null) break;
            
            var data = styleEntry?._data;

            if (data != null) {
                var assets = data?.assets;

                if (assets != null) {
                    var note = assets?.note;

                    if (note != null) {
                        var isPixelVal:Dynamic = note?.isPixel;
                        
                        if (isPixelVal == true || isPixelVal == "true") {
                            _cachedHudStyleId = styleId;
                            _cachedHudFont = getCustomPixelFont();
                            return _cachedHudFont;
                        } else if (isPixelVal == false || isPixelVal == "false") {
                            break;
                        }
                    }
                }
                
                var fallbackStyle = data?.fallback;

                if (fallbackStyle != null && Std.string(fallbackStyle) != "" && Std.string(fallbackStyle) != "null") {
                    currentStyleId = Std.string(fallbackStyle);
                } else {
                    currentStyleId = null;
                }
            } else {
                currentStyleId = null;
            }
            depth++;
        }
        
        _cachedHudStyleId = styleId;
        _cachedHudFont = getCustomFont();
        return _cachedHudFont;
    }

    /**
     * Resolves the true file path of a custom font from its user-facing key.
     * Interfaces with the Asset datahunter to map display names to `.ttf`/`.otf` paths.
     * Falls back to VCR OSD Mono if the key is invalid or "None".
     * 
     * @param fontKey The name of the font selected by the user.
     * @return The absolute/relative asset path to the font file.
     */
    public function resolveCustomFont(fontKey:String):String {
        var assetHunter = KassetteHUDDatahunter.asset;
        if (assetHunter != null) return assetHunter.resolveCustomFont(fontKey);
        return "VCR OSD Mono";
    }

    /**
     * Resolves the string path for the primary custom font selected by the user.
     * 
     * @param key The option key to read the preferred font from.
     * @return The file path to the .ttf/.otf, or "VCR OSD Mono" if unavailable.
     */
    public function getCustomFont():String {
        var optionsManager = KssetteOptionsManager.instance;
        var fontKey:String = "None";
        if (optionsManager != null) {
            fontKey = Std.string(optionsManager.getKssValue("kssette_custom_font"));
        }
        if (fontKey == lastFontKey && cachedCustomFontPath != "") return cachedCustomFontPath;
        var resolved = resolveCustomFont(fontKey);
        lastFontKey = fontKey;
        cachedCustomFontPath = resolved;
        return resolved;
    }

    /**
     * Resolves the string path for the secondary pixel-style custom font.
     * 
     * @param key The option key to read the preferred pixel font from.
     * @return The file path to the pixel font, or "pixel.otf" natively.
     */
    public function getCustomPixelFont():String {
        var optionsManager = KssetteOptionsManager.instance;
        var fontKey:String = "None";
        if (optionsManager != null) {
            fontKey = Std.string(optionsManager.getKssValue("kssette_custom_pixel_font"));
        }
        if (fontKey == lastPixelFontKey && cachedCustomPixelFontPath != "") return cachedCustomPixelFontPath;
        var resolved = resolveCustomFont(fontKey);
        lastPixelFontKey = fontKey;
        cachedCustomPixelFontPath = resolved;
        return resolved;
    }
}
