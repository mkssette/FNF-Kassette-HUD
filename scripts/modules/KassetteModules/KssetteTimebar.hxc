package khudlite.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import Std;
import funkin.Preferences;

class KssetteTimeBar extends Module {
    public var timeBar:FlxSprite; 
    public var timeBarBG:FlxSprite;
    var barSize:Float = 11; 
    var cachedActive:Bool = false;
    var timeBarPos:String = "Bottom";
    var apiModule:Dynamic = null;

    var cachedX:Float = 0;
    var cachedY:Float = 0;

    public function new() { 
        super("KssetteTimeBar"); 
    }

    function setupProgressHUD(state:PlayState) {
        if (timeBar != null) { 
            timeBar.destroy(); 
            state.remove(timeBar); 
        }
        if (timeBarBG != null) { 
            timeBarBG.destroy(); 
            state.remove(timeBarBG); 
        }

        var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        var isInHealth:Bool = (timeBarPos == "In Health");
        var isMini:Bool = (timeBarPos == "Bottom Left" || timeBarPos == "Bottom Right" || timeBarPos == "Top Left" || timeBarPos == "Top Right");

        var currentBgW:Int = isVertical ? Std.int(barSize + 4) : (isMini ? 360 : (isInHealth ? 360 : FlxG.width));
        var currentBgH:Int = isVertical ? FlxG.height : Std.int(barSize + 4);
        var currentBarW:Int = isVertical ? Std.int(barSize) : currentBgW;
        var currentBarH:Int = isVertical ? currentBgH : Std.int(barSize);

        timeBarBG = new FlxSprite(0, 0).makeGraphic(currentBgW, currentBgH, 0xFF000000);
        timeBarBG.origin.set(0, 0); 
        timeBarBG.scrollFactor.set(0, 0); 
        timeBarBG.zIndex = 998;
        if (state.camHUD != null) timeBarBG.cameras = [state.camHUD];
        state.add(timeBarBG);
        
        timeBar = new FlxSprite(0, 2).makeGraphic(currentBarW, currentBarH, 0xFFFFFFFF);
        timeBar.origin.set(0, isVertical ? currentBarH : 0); 
        timeBar.scrollFactor.set(0, 0); 
        timeBar.zIndex = 999;
        if (state.camHUD != null) timeBar.cameras = [state.camHUD];
        state.add(timeBar);

        var paddingX:Float = 0; 
        var paddingY:Float = 20;

        if (timeBarPos == "Top") {
            cachedY = 0;
            cachedX = (FlxG.width - currentBgW) / 2;
        } else if (timeBarPos == "Top Left") {
            cachedX = paddingX; cachedY = paddingY;
        } else if (timeBarPos == "Top Right") {
            cachedX = FlxG.width - currentBgW - paddingX; cachedY = paddingY;
        } else if (timeBarPos == "Bottom Left") {
            cachedX = paddingX; cachedY = FlxG.height - currentBgH - paddingY;
        } else if (timeBarPos == "Bottom Right") {
            cachedX = FlxG.width - currentBgW - paddingX; cachedY = FlxG.height - currentBgH - paddingY;
        } else if (timeBarPos == "Vertical Left") {
            cachedX = paddingX; cachedY = 0;
        } else if (timeBarPos == "Vertical Right") {
            cachedX = FlxG.width - currentBgW - paddingX; cachedY = 0;
        } else if (timeBarPos == "In Health") {
            var hbX:Float = (FlxG.width - currentBgW) / 2;
            var downscrollValue:Bool = Preferences.downscroll;
            var hbY:Float = downscrollValue ? FlxG.height * 0.11 : FlxG.height * 0.89;
            var hbH:Float = 19;
            if (state.healthBarBG != null) {
                hbX = state.healthBarBG.x + (state.healthBarBG.width - currentBgW) / 2;
                hbY = state.healthBarBG.y;
                hbH = state.healthBarBG.height;
            }
            cachedX = hbX;
            cachedY = downscrollValue ? hbY + hbH : hbY - currentBgH;
        } else {
            cachedY = FlxG.height - currentBgH;
            cachedX = (FlxG.width - currentBgW) / 2;
        }

        timeBarBG.x = cachedX;
        timeBarBG.y = cachedY; 
        
        if (isVertical) {
            timeBar.x = cachedX + 2;
            timeBar.y = cachedY;
        } else {
            timeBar.x = cachedX;
            timeBar.y = cachedY + 2;
        }
    }

    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule != null) {
            apiModule.scriptCall("registerModule", ["KssetteTimeBar", this]);
            cachedActive = apiModule.scriptCall("getKssValue", ["kssette_show_timebar"]) == true;
            timeBarPos = Std.string(apiModule.scriptCall("getKssValue", ["kssette_timebar_pos"]));
        }
        if (cachedActive && PlayState.instance != null) setupProgressHUD(PlayState.instance);
    }

    override public function onUpdate(event) {
        super.onUpdate(event);
        
        if (!cachedActive || timeBar == null || !timeBar.exists || apiModule == null) return;
        
        // Funciona 100% al estilo ticks usando scriptCall de FNF 
        var progress:Dynamic = apiModule.scriptCall("getSongProgressTicks", []);
        if (progress != null) {
            var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isVertical) {
                if (timeBar.scale.y != progress) timeBar.scale.y = progress;
                if (timeBar.scale.x != 1.0) timeBar.scale.x = 1.0;
            } else {
                if (timeBar.scale.x != progress) timeBar.scale.x = progress;
                if (timeBar.scale.y != 1.0) timeBar.scale.y = 1.0;
            }
        }
    }
}