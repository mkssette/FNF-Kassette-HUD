package khudlite.util;

import flixel.FlxG;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.play.PlayState;
import funkin.play.notes.Strumline;
import funkin.util.Constants;
import funkin.Preferences;
import Std;
import Math;
import StringTools;

class KssMiddlescroll extends Module {
    var cachedMode:String = "Off";
    var cachedOppPos:String = "Left";
    var cachedOppBg:Bool = false;
    var hasShifted:Bool = false;
    var apiModule:Dynamic = null;
    var cachedOppStrum:Dynamic = null;
    var cachedReceptors:Dynamic = null;
    var cachedSplashes:Dynamic = null;
    var cachedHasSplashOffsets:Bool = false;
    var cachedSplashOffsetX:Float = 0.0;
    var splashUpdateTimer:Float = 0.0;

    public function new() {
        super('KssMiddlescroll'); 
    }

    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    function isPixelNote(obj:Dynamic = null):Bool {
        if (obj != null && obj.antialiasing == false) {
            return true;
        }
        var ps = PlayState.instance;
        if (ps == null) return false;
        return ps.currentChart != null && ps.currentChart.noteStyle == 'pixel';
    }

    override function onCountdownStart(event:ScriptEvent):Void {
        hasShifted = false;
        cachedOppStrum = null;
        cachedReceptors = null;
        cachedSplashes = null;
        cachedHasSplashOffsets = false;
        cachedSplashOffsetX = 0.0;
        splashUpdateTimer = 0.0;
        
        var isMobLayout = false;
        apiModule = ModuleHandler.getModule("KssetteApi");
        
        if (apiModule != null) {
            apiModule.scriptCall("registerModule", ["KssMiddlescroll", this]);
            
            var rawMode:Dynamic = apiModule.scriptCall("getKssValue", ["kssette_middlescroll"]);
            if (rawMode == true) cachedMode = "On";
            else if (rawMode == false) cachedMode = "Off";
            else cachedMode = Std.string(rawMode);

            cachedOppPos = Std.string(apiModule.scriptCall("getKssValue", ["kssette_opponent_pos"]));
            var rawOppBg:Dynamic = apiModule.scriptCall("getKssValue", ["kssette_opponent_bg"]);
            cachedOppBg = isOn(rawOppBg);
            
            var isMob = FlxG.onMobile;
            var isMobPC = apiModule.scriptCall("isMobileLikePC", []) == true;
            
            if (isMob && !isMobPC) isMobLayout = true;
        }

        var state = PlayState.instance;
        if (state == null) return;

        var isModActive = (cachedMode != "Off" && cachedMode != "null");

        var pRealWidth:Float = 0;
        var pStartX:Float = 0;
        var padding:Float = 12;

        if (state.playerStrumline != null) {
            pStartX = state.playerStrumline.x;
            var pNotes = state.playerStrumline.strumlineNotes.members;
            
            if (pNotes != null && pNotes.length > 0) {
                var firstNote = pNotes[0];
                var lastNote = pNotes[pNotes.length - 1];
                pRealWidth = (lastNote.x + lastNote.width) - firstNote.x;
                pStartX = firstNote.x;
            }
            
            if (pRealWidth <= 0) pRealWidth = state.playerStrumline.width;
            if (pRealWidth <= 0) pRealWidth = 448; 

            var pBg = state.playerStrumline.background;
            if (pBg != null) {
                var fWidth:Float = pBg.frameWidth;
                if (fWidth <= 0) fWidth = pBg.width;
                if (fWidth > 0) {
                    pBg.scale.x = (pRealWidth + padding * 2) / fWidth;
                    pBg.updateHitbox();
                    pBg.x = pStartX - padding;
                }
            }
        }

        if (state.opponentStrumline != null) {
            var bg = state.opponentStrumline.background;
            if (bg != null) {
                if (!isModActive && cachedOppBg && !isMobLayout) {
                    bg.visible = true;
                    var realWidth:Float = 0;
                    var startX:Float = state.opponentStrumline.x;
                    var oNotes = state.opponentStrumline.strumlineNotes.members;
                    
                    if (oNotes != null && oNotes.length > 0) {
                        var firstNote = oNotes[0];
                        var lastNote = oNotes[oNotes.length - 1];
                        realWidth = (lastNote.x + lastNote.width) - firstNote.x;
                        startX = firstNote.x;
                    }
                    
                    if (realWidth <= 0) realWidth = state.opponentStrumline.width;
                    if (realWidth <= 0) realWidth = 448; 
                    
                    var fWidth:Float = bg.frameWidth;
                    if (fWidth <= 0) fWidth = bg.width;
                    if (fWidth > 0) {
                        bg.scale.x = (realWidth + padding * 2) / fWidth;
                        bg.updateHitbox();
                        bg.x = startX - padding;
                    }
                } else {
                    bg.visible = false;
                }
            }
        }

        if (isModActive) {
            state.comboPopUps.offsets = [480, -50];
        }

        if (state.playerStrumline != null && isModActive) {
            var centeredX:Float = (FlxG.width - pRealWidth) * 0.5;
            var shift:Float = centeredX - pStartX;
            state.playerStrumline.x += shift;

            var pBg = state.playerStrumline.background;
            if (pBg != null) {
                pBg.x = centeredX - padding;
            }
        }

        if (state.opponentStrumline != null) {
            if (isModActive) hideAllCovers(state);

            if (cachedMode == "Hidden Notes") {
                state.opponentStrumline.x = -5000;
                var oNotes = state.opponentStrumline.strumlineNotes.members;
                if (oNotes != null) {
                    for (note in oNotes) {
                        if (note != null) note.x = -5000;
                    }
                }
            } else if (!hasShifted) {
                var receptors = state.opponentStrumline.strumlineNotes.members;
                
                if (cachedMode == "P Style" && receptors != null && receptors.length >= 4) {
                    var targetLeftX:Float = Constants.STRUMLINE_X_OFFSET;
                    var targetRightX:Float = FlxG.width - Constants.STRUMLINE_X_OFFSET - receptors[3].width;

                    receptors[0].x = targetLeftX;
                    receptors[1].x = targetLeftX + Strumline.NOTE_SPACING;
                    receptors[3].x = targetRightX;
                    receptors[2].x = targetRightX - Strumline.NOTE_SPACING;
                    
                    for (receptor in receptors) {
                        if (receptor != null) receptor.alpha = 0.6;
                    }
                    hasShifted = true;
                } 
                else if ((cachedMode == "On" || cachedMode == "Like Mobile") && receptors != null && receptors.length > 0) {
                    
                    var sizeRatio:Float = (cachedMode == "Like Mobile") ? 0.55 : 0.65;
                    state.opponentStrumline.strumlineScale.set(0.7 * sizeRatio, 0.7 * sizeRatio);

                    var targetSpacing:Float = Strumline.NOTE_SPACING * sizeRatio;

                    for (receptor in receptors) {
                        if (receptor != null) {
                            var pixel:Bool = isPixelNote(receptor);
                            var defaultScale:Float = pixel ? 6.0 : 0.7;
                            receptor.scale.set(defaultScale * sizeRatio, defaultScale * sizeRatio);
                            receptor.updateHitbox();
                            receptor.alpha = 1.0; 
                        }
                    }

                    var offsetBase:Float = (cachedMode == "Like Mobile") ? 10.0 : Constants.STRUMLINE_X_OFFSET;
                    var compactStartX:Float = offsetBase;

                    if (cachedOppPos == "Right") {
                        var exactTotalWidth:Float = (targetSpacing * (receptors.length - 1)) + receptors[receptors.length - 1].width;
                        compactStartX = FlxG.width - offsetBase - exactTotalWidth;
                    }

                    var isLikeMobile:Bool = (cachedMode == "Like Mobile");

                    for (i in 0...receptors.length) {
                        if (receptors[i] != null) {
                            receptors[i].x = compactStartX + (targetSpacing * i);
                            if (isLikeMobile) {
                                receptors[i].y = Constants.STRUMLINE_Y_OFFSET;
                            }
                            receptors[i].updateHitbox();
                            receptors[i].alpha = 1.0;
                        }
                    }
                    
                    if (isLikeMobile) {
                        state.opponentStrumline.y = Constants.STRUMLINE_Y_OFFSET;
                    }
                    
                    hasShifted = true;
                }
            }
        }

        cachedOppStrum = state.opponentStrumline;
        if (cachedOppStrum != null) {
            cachedReceptors = cachedOppStrum.strumlineNotes != null ? cachedOppStrum.strumlineNotes.members : null;
            cachedSplashes = cachedOppStrum.noteSplashes;
            
            if (cachedOppStrum.noteStyle != null) {
                var offsets = cachedOppStrum.noteStyle.getSplashOffsets();
                cachedHasSplashOffsets = (offsets != null && offsets.length > 0);
                if (cachedHasSplashOffsets) cachedSplashOffsetX = offsets[0];
            } else {
                cachedHasSplashOffsets = false;
                cachedSplashOffsetX = 0.0;
            }
        }
    }

    override function onNoteIncoming(event:ScriptEvent) {
        super.onNoteIncoming(event);
        
        var state = PlayState.instance;
        if (state == null) return;

        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Hidden Notes" || cachedMode == "Like Mobile" || cachedMode == "Glass");

        if (!isModActive) return;

        var note = event.note;

        if (note != null && !note.noteData.getMustHitNote() && state.opponentStrumline != null) {
            var opp = state.opponentStrumline;

            if (cachedMode == "Hidden Notes" || cachedMode == "Like Mobile") {
                note.x = -5000;
                note.alpha = 0;
                note.visible = false;
                
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.x = -5000;
                    note.holdNoteSprite.alpha = 0;
                    note.holdNoteSprite.visible = false;
                }
                return;
            }

            var receptors = opp.strumlineNotes.members;
            if (receptors == null || note.direction < 0 || note.direction >= receptors.length) return;
            
            var targetReceptor = receptors[note.direction];
            
            if (cachedMode == "P Style") {
                if (targetReceptor != null) {
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (note.width * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        var hold:Dynamic = note.holdNoteSprite;
                        hold.x = targetReceptor.x + (targetReceptor.width * 0.5) - (hold.width * 0.5);
                        hold.alpha = 0.6;
                    }
                }
                note.alpha = 0.6;
                return;
            } 
            
            if (cachedMode == "On" || cachedMode == "Like Mobile") {
                var pixel:Bool = isPixelNote(note);
                var targetScale:Float = 1.0;
                
                var sizeRatio:Float = (cachedMode == "Like Mobile") ? 0.55 : 0.65;
                var defaultScale:Float = pixel ? 6.0 : 0.7;
                targetScale = defaultScale * sizeRatio;
                
                if (note.scale.x != targetScale || note.scale.y != targetScale) {
                    note.scale.set(targetScale, targetScale);
                    note.updateHitbox();
                }

                note.alpha = 1.0;

                if (targetReceptor != null) {
                    var receptorW = targetReceptor.frameWidth * targetReceptor.scale.x;
                    var nw:Float = note.width > 0 ? note.width : receptorW;
                    
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (nw * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        var holdNote:Dynamic = note.holdNoteSprite;
                        holdNote.flipY = false;

                        var holdWidthMul:Float = pixel ? 0.15 : 1.05;
                        var holdScale:Float = targetScale * holdWidthMul;
                        
                        holdNote.graphicWidth = holdNote.graphicWidth * holdScale;
                        
                        holdNote.x = targetReceptor.x + (targetReceptor.width * 0.5) - (holdNote.graphicWidth * 0.5);
                        holdNote.updateClipping();
                        
                        holdNote.alpha = 0.8;
                        holdNote.visible = true;
                    }
                }
            }
        }
    }

    override function onUpdate(event:UpdateScriptEvent) {
        
        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Like Mobile");

        if (!isModActive) return;
        if (cachedMode == "Hidden Notes") return;
        if (cachedOppStrum == null) return;

        if (cachedOppStrum.holdNotes != null && cachedOppStrum.holdNotes.members != null) {
            for (hold in cachedOppStrum.holdNotes.members) {
                if (hold != null && hold.alive) {
                    if (cachedMode == "P Style") hold.alpha = 0.6;
                }
            }
        }
        
        if (cachedMode == "Like Mobile" && cachedReceptors != null) {
            for (receptor in cachedReceptors) {
                if (receptor != null && receptor.y != Constants.STRUMLINE_Y_OFFSET) {
                    receptor.y = Constants.STRUMLINE_Y_OFFSET;
                }
            }
        }

        splashUpdateTimer += event.elapsed;
        if (splashUpdateTimer >= 0.016) {
            splashUpdateTimer = 0.0;
            var splashes = cachedSplashes;
            if (splashes != null && splashes.members != null) {
                
                var receptors = cachedReceptors;
                var hasOffsets:Bool = cachedHasSplashOffsets;
                var offX:Float = cachedSplashOffsetX;
                
                for (splash in splashes.members) {
                    if (splash != null && splash.alive && splash.animation != null && splash.animation.name != null) {
                        var animName = splash.animation.name;
                        var dir:Int = -1;
                        
                        if (animName.indexOf("LEFT") != -1) dir = 0;
                        else if (animName.indexOf("DOWN") != -1) dir = 1;
                        else if (animName.indexOf("UP") != -1) dir = 2;
                        else if (animName.indexOf("RIGHT") != -1) dir = 3;

                        if (dir != -1 && receptors != null && dir < receptors.length) {
                            var receptor = receptors[dir];
                            if (receptor != null) {
                                var expectedX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                if (hasOffsets) expectedX += offX * splash.scale.x;

                                if (Math.abs(splash.x - expectedX) > 0.1 || splash.scale.x != receptor.scale.x || splash.scale.y != receptor.scale.y) {
                                    splash.scale.set(receptor.scale.x, receptor.scale.y);
                                    splash.updateHitbox();

                                    var targetX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                    if (hasOffsets) targetX += offX * splash.scale.x;

                                    splash.x = targetX;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    private function hideAllCovers(state:PlayState):Void {
        if (state.opponentStrumline == null) return;

        if (state.opponentStrumline.noteHoldCovers != null && state.opponentStrumline.noteHoldCovers.members != null) {
            state.opponentStrumline.noteHoldCovers.visible = false;
            for (cover in state.opponentStrumline.noteHoldCovers.members) {
                if (cover != null) {
                    cover.visible = false;
                    cover.alpha = 0.0;
                }
            }
        }

        if (state.opponentStrumline.holdNotes != null && state.opponentStrumline.holdNotes.members != null) {
            for (hold in state.opponentStrumline.holdNotes.members) {
                if (hold != null && hold.cover != null) {
                    hold.cover.visible = false;
                    hold.cover.alpha = 0.0;
                }
            }
        }
    }
}