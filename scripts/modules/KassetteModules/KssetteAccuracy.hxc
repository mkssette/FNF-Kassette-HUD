package khudlite.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.Preferences;
import flixel.text.FlxBitmapText;
import flixel.text.FlxTextAlign;
import flixel.util.FlxStringUtil;
import flixel.math.FlxMath;
import flixel.FlxG;
import StringTools;
import Std;

class KssetteAccuracy extends Module {
    var separator:String = " / ";

    public var uiText:FlxBitmapText;
    public var infoText:FlxBitmapText;
    public var timeText:FlxBitmapText;
    public var judgeLabels = [];
    public var judgeValues = [];
    public var judgeNames = ["sick", "good", "bad", "shit", "miss", "maxCombo"];

    var lastScore:Int = -1;
    var lastMisses:Int = -1;
    var lastMaxCombo:Int = -1;
    var lastTotalJudges:Int = -1;
    var lastVisualAcc:Float = -1;
    var lastTimeSeconds:Int = -1;
    
    var uiUpdateTimer:Float = 0.0;
    var pendingTextUpdate:Bool = false;

    var api:Dynamic = null;
    var _cShowHUD:Bool = true;
    var _cShowScore:Bool = true;
    var _cShowMisses:Bool = true;
    var _cShowRank:Bool = true;
    var _cShowTier:Bool = true;
    var _cAccMode:String = "Classic";
    var _cJudgePos:String = "Off";
    var _cShowTime:Bool = true;
    var _cShowTitle:Bool = true;
    var _cShowDiff:Bool = true;
    var _cJudgesVisible:Bool = false;

    public function new() {
        super("KssetteAccuracy");
    }

    function getJudgeName(name:String):String {
        switch(name) {
            case 'sick': return 'Sicks';
            case 'good': return "Goods";
            case 'bad': return "Bads";
            case 'shit': return "Shits";
            case 'miss': return "Misses";
            case 'maxCombo': return "Max Combo";
            default: return "???";
        }
    }

    function formatRank(id:String):String {
        if (id == null || id == "" || id == "?") return "?";
        switch (id.toUpperCase()) {
            case "PERFECT_GOLD": return "P [GOLD]";
            case "PERFECT": return "P";
            case "EXCELLENT": return "E";
            case "GREAT": return "G";
            case "GOOD": return "Go";
            case "SHIT": return "L";
            default: return id;
        }
    }

    function setupKssText(txt:FlxBitmapText, refTxt:FlxBitmapText) {
        if (refTxt == null) return;
        txt.borderColor = refTxt.borderColor;
        txt.borderStyle = refTxt.borderStyle;
        txt.borderSize = refTxt.borderSize;
        txt.borderQuality = refTxt.borderQuality;
        txt.textColor = refTxt.textColor;
        txt.letterSpacing = refTxt.letterSpacing;
        txt.wordWrap = refTxt.wordWrap;
        txt.scrollFactor.set(refTxt.scrollFactor.x, refTxt.scrollFactor.y);
        txt.offset.set(refTxt.offset.x, refTxt.offset.y);
    }

    override function onCountdownStart(event) {
        api = ModuleHandler.getModule("KssetteApi");
        if (api == null) return;
        var state = PlayState.instance;
        if (state == null) return;

        api.scriptCall("registerModule", ["KssetteAccuracy", this]);

        lastScore = -1; lastMisses = -1; lastMaxCombo = -1; lastTotalJudges = -1;
        lastVisualAcc = -1; lastTimeSeconds = -1; uiUpdateTimer = 0.0; pendingTextUpdate = false;

        if (uiText != null) uiText.destroy();
        if (infoText != null) infoText.destroy();
        if (timeText != null) timeText.destroy();
        for (t in judgeLabels) if (t != null) t.destroy();
        for (t in judgeValues) if (t != null) t.destroy();
        judgeLabels = []; judgeValues = [];

        var refText = state.scoreText;
        if (refText != null) refText.visible = false;
        var refFont = refText != null ? refText.font : null;

        var hudY = refText != null ? refText.y : (state.healthBarBG != null ? state.healthBarBG.y + 36 : FlxG.height - 50);

        uiText = new FlxBitmapText(0, hudY, "", refFont);
        setupKssText(uiText, refText);
        uiText.alignment = FlxTextAlign.CENTER;
        uiText.zIndex = 1000;
        if (state.camHUD != null) uiText.cameras = [state.camHUD];
        state.add(uiText);

        var infoPos:String = Std.string(api.scriptCall("getKssValue", ["kssette_info_pos"]));
        var scorePos:String = Std.string(api.scriptCall("getKssValue", ["kssette_score_pos"]));
        var timeBarPos:String = Std.string(api.scriptCall("getKssValue", ["kssette_timebar_pos"]));
        var showTimeBar:Bool = api.scriptCall("getKssValue", ["kssette_show_timebar"]) == true;

        if (scorePos == "Inverted" && state.healthBarBG != null) {
            if (state.healthBarBG.y < FlxG.height / 2) {
                uiText.y = FlxG.height - 40;
            } else {
                uiText.y = 20;
            }
        }

        var safeX:Float = FlxG.onMobile ? 85 : 18;
        var tX:Float = 0; var tY:Float = 0; var tA = FlxTextAlign.CENTER;
        var iX:Float = 0; var iY:Float = 0; var iA = FlxTextAlign.CENTER;

        var forceDownscrollLook:Bool = false;
        if (FlxG.onMobile && api.scriptCall("isMobileLikePC", []) != true) forceDownscrollLook = true;

        if (infoPos == "Bottom Left") {
            var yOffset:Float = (showTimeBar && timeBarPos == "Bottom Left") ? 25 : 0;
            tX = safeX; tY = FlxG.height - 85 - yOffset; tA = FlxTextAlign.LEFT;
            iX = safeX; iY = FlxG.height - 50 - yOffset; iA = FlxTextAlign.LEFT;
        } else {
            if (!Preferences.downscroll && !forceDownscrollLook) {
                tY = 15; iY = 24; tX = 0; tA = FlxTextAlign.RIGHT;
                iX = (FlxG.width / 2) + 10; iA = FlxTextAlign.LEFT;
            } else {
                if (scorePos == "Inverted") {
                    tY = state.healthBarBG != null ? state.healthBarBG.y + 36 : uiText.y + 24;
                    iY = tY + 32;
                } else {
                    tY = uiText.y + 24; iY = tY + 32;
                }
            }
        }

        timeText = new FlxBitmapText(tX, tY, "", refFont);
        setupKssText(timeText, refText);
        timeText.alignment = tA;
        timeText.zIndex = 1000;
        if (state.camHUD != null) timeText.cameras = [state.camHUD];
        state.add(timeText);

        infoText = new FlxBitmapText(iX, iY, "", refFont);
        setupKssText(infoText, refText);
        infoText.alignment = iA;
        infoText.zIndex = 1000;
        if (state.camHUD != null) infoText.cameras = [state.camHUD];
        state.add(infoText);

        var jPos:String = Std.string(api.scriptCall("getKssValue", ["kssette_judge_pos"]));
        if (jPos != "Off" && jPos != "false") {
            var jMargin:Float = FlxG.onMobile ? 85 : 6;
            
            var cOffX:Float = 0;
            var cOffY:Float = 0;
            try {
                if (Preferences.comboOffset != null && Preferences.comboOffset.length >= 2) {
                    cOffX = Preferences.comboOffset[0];
                    cOffY = Preferences.comboOffset[1];
                }
            } catch(e:Dynamic) {}

            var tw = 200; var sy = 22; var sx = jMargin + cOffX; var sY = (FlxG.height - judgeNames.length * sy) * 0.5 + cOffY;
            if (jPos == "Right") sx = FlxG.width - tw - jMargin + cOffX;
            if (jPos == "Top Left") sY = 100 + cOffY;
            if (jPos == "Top Right") { sx = FlxG.width - tw - jMargin + cOffX; sY = 100 + cOffY; }

            for (i in 0...judgeNames.length) {
                var label = new FlxBitmapText(sx, sY + (i * sy), getJudgeName(judgeNames[i]), refFont);
                setupKssText(label, refText);
                label.alignment = FlxTextAlign.LEFT;
                label.zIndex = 1000; label.cameras = [state.camHUD];
                state.add(label); judgeLabels.push(label);

                var val = new FlxBitmapText(sx + tw - 50, label.y, "0", refFont);
                setupKssText(val, refText);
                val.alignment = FlxTextAlign.RIGHT;
                val.zIndex = 1000; val.cameras = [state.camHUD];
                state.add(val); judgeValues.push(val);
            }
        }

        updateSettings();
    }

    override public function onResume(event) {
        updateSettings();
    }

    function updateSettings() {
        if (api == null) return;
        _cShowHUD = api.scriptCall("getKssValue", ["kssette_show_hud"]) == true;
        _cShowScore = api.scriptCall("getKssValue", ["kssette_show_score"]) == true;
        _cShowMisses = api.scriptCall("getKssValue", ["kssette_show_misses"]) == true;
        _cShowRank = api.scriptCall("getKssValue", ["kssette_show_rank"]) == true;
        _cShowTier = api.scriptCall("getKssValue", ["kssette_show_tier"]) == true;
        _cAccMode = Std.string(api.scriptCall("getKssValue", ["kssette_acc_mode"]));
        _cJudgePos = Std.string(api.scriptCall("getKssValue", ["kssette_judge_pos"]));
        
        var state = PlayState.instance;
        _cShowTime = api.scriptCall("getKssValue", ["kssette_show_song_time"]) == true;
        _cShowTitle = api.scriptCall("getKssValue", ["kssette_show_song_title"]) == true;
        _cShowDiff = api.scriptCall("getKssValue", ["kssette_show_song_diff"]) == true;

        _cJudgesVisible = (_cJudgePos != "Off" && _cJudgePos != "false");

        if (infoText != null && infoText.exists) {
            infoText.visible = (_cShowHUD && (_cShowTitle || _cShowDiff));
            if (infoText.visible) {
                var infoTextStr:String = "";
                if (_cShowTitle && state != null && state.currentChart != null) infoTextStr += state.currentChart.songName;
                if (_cShowDiff) {
                    if (infoTextStr != "") infoTextStr += " - ";
                    if (state != null && state.currentDifficulty != null) infoTextStr += state.currentDifficulty.toUpperCase();
                }
                infoText.text = infoTextStr;
                if (infoText.alignment == FlxTextAlign.CENTER) {
                    infoText.x = (FlxG.width - infoText.width) / 2;
                }
            }
        }

        for (i in 0...judgeLabels.length) {
            if (judgeLabels[i] != null) judgeLabels[i].visible = (_cShowHUD && _cJudgesVisible);
            if (judgeValues[i] != null) judgeValues[i].visible = (_cShowHUD && _cJudgesVisible);
        }

        if (uiText != null) uiText.visible = _cShowHUD;
    }

    override public function onUpdate(event) {
        super.onUpdate(event);
        var state = PlayState.instance;
        if (state == null || api == null) return;

        if (timeText != null && timeText.exists) {
            var showT:Bool = _cShowHUD && _cShowTime;
            timeText.visible = showT;
            if (showT && state.conductorInUse != null) {
                var remainingSeconds:Int = Math.floor((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000);
                if (remainingSeconds < 0) remainingSeconds = 0;

                if (remainingSeconds != lastTimeSeconds) {
                    lastTimeSeconds = remainingSeconds;
                    timeText.text = "[" + FlxStringUtil.formatTime(remainingSeconds, false) + "]";
                    if (timeText.alignment == FlxTextAlign.CENTER) {
                        timeText.x = (FlxG.width - timeText.width) / 2;
                    }
                }
            }
        }

        if (uiText == null || !uiText.exists || !_cShowHUD) return;

        var data:Array<Dynamic> = api.scriptCall("getAccData", []);
        if (data == null || data.length < 10) return;

        var vAcc:Float = FlxMath.roundDecimal(data[0], 2);
        var m:Int = data[1];
        var c:Int = data[2];
        var currentScoreInt:Int = data[3];
        var currentSicks:Int = data[4];
        var currentGoods:Int = data[5];
        var currentBads:Int = data[6];
        var currentShits:Int = data[7];

        var totalJudges:Int = currentSicks + currentGoods + currentBads + currentShits + m;

        var majorChange:Bool = (totalJudges != lastTotalJudges || c != lastMaxCombo);
        var minorChange:Bool = (currentScoreInt != lastScore);
        var accTextChanged:Bool = (vAcc != lastVisualAcc);

        if (majorChange) {
            if (_cJudgesVisible && judgeValues.length >= 6) {
                judgeValues[0].text = Std.string(currentSicks); 
                judgeValues[1].text = Std.string(currentGoods); 
                judgeValues[2].text = Std.string(currentBads); 
                judgeValues[3].text = Std.string(currentShits); 
                judgeValues[4].text = Std.string(m);       
                judgeValues[5].text = Std.string(c);       
            }
            lastMisses = m;
            lastMaxCombo = c;
            lastTotalJudges = totalJudges;
        }

        if (majorChange || minorChange || accTextChanged) {
            pendingTextUpdate = true;
        }

        uiUpdateTimer += event.elapsed;

        if (pendingTextUpdate && (majorChange || uiUpdateTimer >= 0.033)) {
            uiUpdateTimer = 0.0;
            pendingTextUpdate = false;

            lastScore = currentScoreInt;
            lastVisualAcc = vAcc;

            var scoreStr = FlxStringUtil.formatMoney(lastScore, false, true);
            var strMain = "";
            var needSep = false;

            if (_cShowScore) {
                strMain += "Score: " + scoreStr;
                needSep = true;
            }

            if (_cShowMisses && !_cJudgesVisible) {
                if (needSep) strMain += separator;
                strMain += "Misses: " + m;
                needSep = true;
            }

            if (_cAccMode != "Off" && _cAccMode != "null" && _cAccMode != "false") {
                if (needSep) strMain += separator;
                strMain += "Acc: " + vAcc + "%";
                needSep = true;
            }

            var cachedSuffix = "";
            var suffixNeedSep = false;

            if (_cShowRank) {
                var rankStr = formatRank(data[8]);
                cachedSuffix += "Rank: " + rankStr;
                suffixNeedSep = true;
            }

            if (_cShowTier) {
                if (suffixNeedSep) cachedSuffix += separator;
                cachedSuffix += data[9];
            }

            var newText:String = "";
            if (strMain != "") newText += strMain;

            if (cachedSuffix != "") {
                if (newText != "") newText += separator;
                newText += cachedSuffix;
            }

            if (uiText.text != newText) {
                uiText.text = newText;
                uiText.x = (FlxG.width - uiText.width) / 2;
            }
        }
    }
}