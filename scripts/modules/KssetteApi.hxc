package khudlite.util;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxBitmapText;
import flixel.text.FlxTextAlign;
import funkin.Preferences;
import funkin.save.Save;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.modding.events.StateChangeScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.play.PlayState;
import funkin.play.scoring.Scoring;
import funkin.Highscore;
import flixel.util.FlxStringUtil;
import flixel.math.FlxMath;
import StringTools;
import Std;
import Math;

class KssetteApi extends Module {
    final optionsID:String = "kassette-hud-lite";
    public var hudVersion:String = "lt.1.1";
    public var isMobileMode:Bool = false;

    public var currentScore:Int = 0;
    public var currentMisses:Int = 0;
    public var currentSicks:Int = 0;
    public var currentGoods:Int = 0;
    public var currentBads:Int = 0;
    public var currentShits:Int = 0;
    public var currentMaxCombo:Int = 0;
    
    public var currentRank:String = "?";
    public var currentTier:String = "N/A";
    
    public var targetAcc:Float = 0.0;
    public var visualAcc:Float = 0.0;

    public var songProgressTicks:Float = 0.0;

    public function new() {
        super('KssetteApi', 1000);
        isMobileMode = FlxG.onMobile; 
        initSettings();
    }

    function initSettings() {
        var options = [
            "kssette_show_hud", "kssette_show_score", "kssette_show_misses",
            "kssette_acc_mode", "kssette_show_rank", "kssette_show_tier",
            "kssette_middlescroll", "kssette_opponent_pos", "kssette_show_timebar", 
            "kssette_info_pos", "kssette_show_song_time", "kssette_judge_pos", 
            "kssette_mobile_keyboard", "kssette_timebar_pos", 
            "kssette_smooth_display", "kssette_hide_splashes"
        ];

        for (opt in options) {
            if (!Save.instance.modOptions.exists(opt)) {
                var defaultVal:Dynamic = "On"; 
                if (opt == "kssette_middlescroll" || opt == "kssette_mobile_keyboard" || opt == "kssette_hide_splashes" || opt == "kssette_judge_pos") defaultVal = "Off"; 
                if (opt == "kssette_opponent_pos") defaultVal = "Left";
                if (opt == "kssette_acc_mode") defaultVal = "Classic";
                if (opt == "kssette_info_pos") defaultVal = "Below Score";
                if (opt == "kssette_timebar_pos") defaultVal = "Bottom";
                Save.instance.modOptions.set(opt, defaultVal);
            }
        }
        Save.instance.flush();
    }

    public function registerModule(name:String, module:Dynamic) {}

    public function getKssValue(key:String):Dynamic { 
        var val = Save.instance.modOptions.get(key);
        if (FlxG.onMobile && !isMobileLikePC()) {
            if (key == "kssette_middlescroll") return "Off";
            if (key == "kssette_opponent_pos") return "Left";
        }
        if (val == "On") return true;
        if (val == "Off") return false;
        return val;
    }

    public function getSongProgressTicks():Float { return songProgressTicks; }
    
    public function getAccData():Array<Dynamic> { 
        return [visualAcc, currentMisses, currentMaxCombo, currentScore, currentSicks, currentGoods, currentBads, currentShits, currentRank, currentTier]; 
    }

    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        currentScore = 0; currentMisses = 0; currentSicks = 0; currentGoods = 0; currentBads = 0; currentShits = 0;
        currentMaxCombo = 0; currentRank = "?"; currentTier = "N/A"; targetAcc = 0.0; visualAcc = 0.0;
        songProgressTicks = 0.0;
    }

    override public function onNoteSplash(event) {
        if (getKssValue("kssette_hide_splashes") == true) event.cancel();
    }

    public function isMobileLikePC():Bool {
        if (!FlxG.onMobile) return true;
        var val = Save.instance.modOptions.get("kssette_mobile_keyboard");
        return (val == "On");
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        var state = PlayState.instance;
        if (state == null) return;

        if (state.conductorInUse != null && state.currentSongLengthMs > 0) {
            var currentPosMs:Float = state.conductorInUse.songPosition;
            if (currentPosMs < 0) currentPosMs = 0;
            var currentTick:Float = Math.floor(currentPosMs / 1000);
            var totalTicks:Float = state.currentSongLengthMs / 1000;
            songProgressTicks = currentTick / totalTicks;
            if (songProgressTicks < 0) songProgressTicks = 0;
            if (songProgressTicks > 1) songProgressTicks = 1;
        }

        var t = Highscore.tallies;
        if (t != null) {
            currentMisses = t.missed; currentSicks = t.sick; currentGoods = t.good;
            currentBads = t.bad; currentShits = t.shit; currentMaxCombo = t.maxCombo;

            var totalNotes = t.totalNotesHit + t.missed;
            if (totalNotes > 0) {
                var rawAcc = ((t.sick + t.good - t.missed) / totalNotes) * 100;
                targetAcc = FlxMath.roundDecimal(rawAcc, 2);
                if (Math.isNaN(targetAcc) || targetAcc < 0) targetAcc = 0.0;
            } else targetAcc = 0.0;

            currentScore = Math.floor(state.songScore);

            currentRank = Scoring.calculateRank({
                score: state.songScore,
                tallies: {
                    sick: t.sick, good: t.good, bad: t.bad, shit: t.shit, missed: t.missed,
                    combo: t.combo, maxCombo: t.maxCombo, totalNotesHit: t.totalNotesHit, totalNotes: totalNotes
                }
            });

            if (t.missed == 0) {
                if (t.good == 0 && t.bad == 0 && t.shit == 0) currentTier = "SFC";
                else if (t.bad == 0 && t.shit == 0) currentTier = "GFC";
                else currentTier = "FC";
            } else if (t.missed < 10) currentTier = "SDCB";
            else currentTier = "Clear";
        }

        if (getKssValue("kssette_smooth_display") == true) {
            visualAcc += (targetAcc - visualAcc) * (event.elapsed * 8);
            if (Math.abs(targetAcc - visualAcc) < 0.001) visualAcc = targetAcc;
        } else {
            visualAcc = targetAcc;
        }
    }

    override public function onStateChangeEnd(event:StateChangeScriptEvent):Void {
        var target = event.targetState;
        if (Std.isOfType(target, PlayState)) createHUDWatermark(target);
    }

    function createHUDWatermark(state:PlayState) {
        if (state == null || state.camHUD == null) return;
        var safeMargin:Float = isMobileMode ? 85 : 8;
        var timeBarPos = getKssValue("kssette_timebar_pos");
        var yPos:Float = (timeBarPos == "Bottom" || timeBarPos == "Bottom Right") ? 10 : (FlxG.height - 24);

        var refText = state.scoreText;
        var watermark = new FlxBitmapText(0, 0, "Kassette HUD LITE", refText != null ? refText.font : null);
        
        if (refText != null) {
            watermark.borderColor = refText.borderColor;
            watermark.borderStyle = refText.borderStyle;
            watermark.borderSize = refText.borderSize;
            watermark.borderQuality = refText.borderQuality;
        }

        watermark.alignment = FlxTextAlign.RIGHT;
        watermark.x = FlxG.width - watermark.width - safeMargin;
        watermark.y = yPos;
        watermark.alpha = 0.5; 
        watermark.zIndex = 1000; 
        watermark.cameras = [state.camHUD];
        
        state.add(watermark);
    }
}