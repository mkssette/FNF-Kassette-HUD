    public function preCacheIconColor(iconId:String, isPlayer:Bool = false):Void {
        if (iconId == null || iconId == "" || iconId == "generic_p1" || iconId == "generic_p2") return;
        if (ReflectUtil.hasField(_iconColorCache, iconId)) return;

        var graphic = null;
        graphic = funkin.Paths.image('icons/' + iconId);
        if (graphic == null) {
            graphic = funkin.Paths.image('icons/icon-' + iconId);
        }

        if (graphic != null) {
            var tempIcon = new flixel.FlxSprite().loadGraphic(graphic);
            extractIconColor(tempIcon, isPlayer, iconId);
            tempIcon.destroy();
        }
    }

    public function updateIconCache():Void {
        var state = PlayState.instance;
        if (state == null) return;

        if (state.iconP1 != null) {
            var prop1 = state.iconP1?.bopEvery;
            if (prop1 != null) cachedP1Bop = prop1;
            else cachedP1Bop = 4;

            var scale1:Float = 1.0;
            var isPixel1 = state.iconP1?.isPixelIcon;
            if (isPixel1 == true) scale1 = 5.0;
            else if (state.iconP1.antialiasing == false) scale1 = 5.0;
            cachedP1Scale = scale1;
        }

        if (state.iconP2 != null) {
            var prop2 = state.iconP2?.bopEvery;
            if (prop2 != null) cachedP2Bop = prop2;
            else cachedP2Bop = 4;

            var scale2:Float = 1.0;
            var isPixel2 = state.iconP2?.isPixelIcon;
            if (isPixel2 == true) scale2 = 5.0;
            else if (state.iconP2.antialiasing == false) scale2 = 5.0;
            cachedP2Scale = scale2;
        }
    }

    override public function onSongRetry(event:ScriptEvent) {
        invalidateCache();
        super.onSongRetry(event);
        clearGammodCache();
    }

    override public function onCountdownStart(event:ScriptEvent) {
        invalidateCache();

        var state = PlayState.instance;
        if (state != null && state.isChartingMode && state.isMinimalMode) {
            state.isMinimalMode = false;
            if (state.initStage != null) state.initStage();
            if (state.initCharacters != null) state.initCharacters();
            state.refresh();
        }

        super.onCountdownStart(event);
        updateIconCache();

        trace("[KssetteApi] Initialization started for song: " + getSongTitle() + " | Difficulty: " + getDifficulty());
        
        _gammodHandler = ModuleHandler.getModule("GammodModifierHandler");
        _gammodMult = ModuleHandler.getModule("GammodMult");
        _gammodRate = ModuleHandler.getModule("GammodPlaybackRate");
        _gammodAuto = ModuleHandler.getModule("GammodAutoPlay");
        _gammodSide = ModuleHandler.getModule("GammodPlayerSide");
        _gammodPlay = ModuleHandler.getModule("GammodPlayModule");

        _gammodCheckTimer = 0.25;

        if (_gammodPlay != null) {
            var gPlay:Dynamic = _gammodPlay;
            if (gPlay.curMultTxt != null) gPlay.curMultTxt.visible = false;
            if (gPlay.curNoRankTxt != null) gPlay.curNoRankTxt.visible = false;
            if (gPlay.scoreTxtFX != null) gPlay.scoreTxtFX.visible = false;
            if (gPlay.scoreTxtFXOut != null) gPlay.scoreTxtFXOut.visible = false;
        }

        clearScoreCache();
        
        _accModule = null;
        _qtModule = null;
        _integrityTimer = 0.0;

        _lastP1Id = "";
        _lastP2Id = "";
        _hbUpdateTimer = 0.0;
        
        _cColoredHB = getKssValue("kssette_colored_healthbar") == true;
        if (ReflectUtil.hasField(FlxG, "kssIconColorCache")) {
            _iconColorCache = ReflectUtil.field(FlxG, "kssIconColorCache");
        } else {
            _iconColorCache = {};
            ReflectUtil.setField(FlxG, "kssIconColorCache", _iconColorCache);
        }
        
        if (state != null && _cColoredHB) {
            if (state.iconP1 != null) {
                var p1Id = "generic_p1";
                if (state.iconP1.characterId != null) p1Id = Std.string(state.iconP1.characterId);
                if (!ReflectUtil.hasField(_iconColorCache, p1Id)) extractIconColor(state.iconP1, true, p1Id);
            }
            
            if (state.iconP2 != null) {
                var p2Id = "generic_p2";
                if (state.iconP2.characterId != null) p2Id = Std.string(state.iconP2.characterId);
                if (!ReflectUtil.hasField(_iconColorCache, p2Id)) extractIconColor(state.iconP2, false, p2Id);
            }
        }
        
        var currentChartId = getSongTitle() + "_" + getDifficulty();

        if (_lastParsedChartId != currentChartId) {
            playerNoteTimes = [];
            
            if (state != null && state.currentChart != null) {
                if (_cColoredHB && state.currentChart?.events != null) {
                    var events:Array<Dynamic> = state.currentChart.events;
                    if (events != null) {
                        for (ev in events) {
                            var evName = "";
                            if (ev?.id != null) evName = Std.string(ev.id);
                            else if (ev?.name != null) evName = Std.string(ev.name);
                            else if (ev?.e != null) evName = Std.string(ev.e);

                            if (evName == "SetHealthIcon" || evName == "ChangeCharacter") {
                                var val = null;
                                if (ev?.value != null) val = ev.value;
                                else if (ev?.v != null) val = ev.v;
                                
                                if (val != null) {
                                    var iconId = "";
                                    if (val?.id != null) iconId = Std.string(val.id);
                                    else if (val?.character != null) iconId = Std.string(val.character);
                                    
                                    var isPlayerEvent = false;
                                    if (val?.char != null) {
                                        var charVal = Std.parseInt(Std.string(val.char));
                                        if (charVal == 0) isPlayerEvent = true; 
                                    }

                                    if (iconId != "" && iconId != "null" && iconId != "generic_p1" && iconId != "generic_p2") {
                                        preCacheIconColor(iconId, isPlayerEvent);
                                    }
                                }
                            }
                        }
                    }
                }

                // Always parse chart notes (needed for breakbar AND ghosttapping "In Breaks")
                if (state.currentChart?.notes != null) {
                    var notesArray:Array<Dynamic> = state.currentChart.notes;
                    var len:Int = notesArray.length;
                    currentNoteIndex = 0;

                    trace("[KssetteApi] Parsing chart notes for break detection. Total notes: " + len);

                    for (i in 0...len) {
                        var note = notesArray[i];
                        if (note == null) continue;

                        // In V-Slice 0.8.4, SongNoteData.getMustHitNote() returns true when data < 4 (strumline 0)
                        // Use ? for safe access without try/catch
                        var isPlayer:Bool = false;
                        var mustHitResult = note?.getMustHitNote();
                        if (mustHitResult != null) {
                            isPlayer = (mustHitResult == true);
                        } else {
                            // Fallback: data < 4 = player, data >= 4 = opponent
                            var noteData = note?.data;
                            if (noteData != null) isPlayer = (noteData < 4);
                        }

                        if (isPlayer) {
                            var rawTime = note?.time;
                            var rawLen = note?.length;
                            var noteTime:Float = (rawTime != null) ? rawTime : -1.0;
                            var noteLen:Float = (rawLen != null) ? rawLen : 0.0;
                            if (noteTime >= 0) playerNoteTimes.push({start: noteTime, end: noteTime + noteLen});
                        }
                    }

                    playerNoteTimes.sort(function(a, b) {
                        if (a.start < b.start) return -1;
                        if (a.start > b.start) return 1;
                        return 0;
                    });

                    trace("[KssetteApi] Break detection: found " + playerNoteTimes.length + " player notes.");
                }
            }
            _lastParsedChartId = currentChartId;
        }
    }

    public function extractIconColor(icon:Dynamic, isPlayer:Bool = false, iconId:String = null):Int {
        var isCacheable = (iconId != null && iconId != "" && iconId != "generic_p1" && iconId != "generic_p2");
        var fallbackColor:Int = isPlayer ? 0xFF66FF33 : 0xFFFF0000;

        if (isCacheable) {
            if (ReflectUtil.hasField(_iconColorCache, iconId)) {
                return ReflectUtil.field(_iconColorCache, iconId);
            }
        }

        if (icon == null) {
            if (isCacheable) ReflectUtil.setField(_iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var bitmap = null;
        if (icon.pixels != null) bitmap = icon.pixels;
        if (bitmap == null) {
            if (icon.graphic != null && icon.graphic.bitmap != null) bitmap = icon.graphic.bitmap;
        }
        
        if (bitmap == null) {
            if (isCacheable) ReflectUtil.setField(_iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var bWidth:Int = 150;
        var bHeight:Int = 150;
        if (bitmap.width != null) bWidth = Std.int(bitmap.width);
        if (bitmap.height != null) bHeight = Std.int(bitmap.height);
        
        var w:Int = bWidth > 150 ? 150 : bWidth;
        var h:Int = bHeight > 150 ? 150 : bHeight;
        
        var detail:Int = isMobileMode ? 12 : 4; // fuck you jetsam
        var frequency:Map<Int, Int> = [-1 => 0];
        frequency.remove(-1);
        var bestColor:Int = fallbackColor;
        var maxFreq:Int = 0;
        
        var x:Int = 0;
        while (x < w) {
            var y:Int = 0;
            while (y < h) {
                var pixel32:Int = bitmap.getPixel32(x, y);
                var alpha:Int = (pixel32 >> 24) & 0xFF;
                
                if (alpha > 200) {
                    var rgb:Int = pixel32 & 0xFFFFFF;
                    if (rgb != 0x000000 && rgb != 0xFFFFFF && rgb != 0x000001) {
                        var count:Null<Int> = frequency.get(rgb);
                        if (count == null) count = 0;
                        count++;
                        frequency.set(rgb, count);
                        if (count > maxFreq) {
                            maxFreq = count;
                            bestColor = rgb;
                        }
                    }
                }
                y += detail;
            }
            x += detail;
        }
        
        if (maxFreq == 0) {
            if (isCacheable) ReflectUtil.setField(_iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var finalColor = 0xFF000000 | bestColor;
        
        if (isCacheable) {
            ReflectUtil.setField(_iconColorCache, iconId, finalColor);
        }

        return finalColor;
    }

    public function getBreakData():Dynamic {
        var state = PlayState.instance;
        if (state == null || state.conductorInUse == null || playerNoteTimes.length == 0) {
            _breakData.active = false;
            _breakData.progress = 0.0;
            _breakData.timeLeft = 0.0;
            return _breakData;
        }

        var currentTime = state.conductorInUse.songPosition;

        // Rewind if time jumped backwards (e.g. restart or seek)
        while (currentNoteIndex > 0 && playerNoteTimes[currentNoteIndex - 1].start > currentTime) {
            currentNoteIndex--;
        }

        while (currentNoteIndex < playerNoteTimes.length && playerNoteTimes[currentNoteIndex].start <= currentTime) {
            currentNoteIndex++;
        }

        if (currentNoteIndex >= playerNoteTimes.length) {
            _breakData.active = false;
            _breakData.progress = 0.0;
            _breakData.timeLeft = 0.0;
            return _breakData;
        }

        var nextTime = playerNoteTimes[currentNoteIndex].start;
        var prevTime:Float = 0;
        if (currentNoteIndex > 0) prevTime = playerNoteTimes[currentNoteIndex - 1].end;
        
        var gap = nextTime - prevTime;
        if (gap >= 2500) {
            var timeSincePrev = currentTime - prevTime;
            var timeUntilNext = nextTime - currentTime;

            if (timeSincePrev > 400 && timeUntilNext > 400) {
                var totalVisibleTime = gap - 800; 
                var currentVisibleTime = timeSincePrev - 400;
                var progress = currentVisibleTime / totalVisibleTime;
                _breakData.active = true;
                _breakData.progress = progress;
                _breakData.timeLeft = timeUntilNext;
                return _breakData;
            }
        }
        _breakData.active = false;
        _breakData.progress = 0.0;
        _breakData.timeLeft = 0.0;
        return _breakData;
    }

    public function isMobileLikePC():Bool {
        if (!FlxG.onMobile) return true;
        if (!_kssCacheReady) refreshOptionCache();
        return _mobileLikePc;
    }

        public function isForcedDownscroll():Bool {
        return isMobileMode && !_mobileLikePc;
    }

    public function getDownscroll():Bool {
        return Preferences.downscroll || isForcedDownscroll();
    }

    public function getSongTitle():String {
        if (_checkedSongName) return _cachedSongName;
        
        _checkedSongName = true;
        _cachedSongName = "Unknown";
        
        var state = PlayState.instance;
        if (state == null) return "Unknown";
        
        var titleStr = "Unknown";
        if (state.currentChart != null && state.currentChart.songName != null) {
            var s = Std.string(state.currentChart.songName);
            if (s != "" && s != "null") titleStr = s;
        }

        if (titleStr == "Unknown" || titleStr == "null") {
            if (state.currentSong != null && state.currentSong.songName != null) {
                var s = Std.string(state.currentSong.songName);
                if (s != "" && s != "null") titleStr = s;
            } else if (state.currentSong != null && state.currentSong.id != null) {
                var s = Std.string(state.currentSong.id);
                if (s != "" && s != "null") titleStr = s;
            }
        }
        
        if (titleStr != "Unknown" && titleStr != "null") _cachedSongName = titleStr;
        return _cachedSongName;
    }

    public function getSongArtist():String {
        if (_checkedSongArtist) return _cachedSongArtist;
        
        _checkedSongArtist = true;
        _cachedSongArtist = "Unknown Artist";
        
        var state = PlayState.instance;
        if (state == null) return "Unknown Artist";
        
        var artistStr = "Unknown Artist";
        if (state.currentChart != null) {
            var cArtist = state.currentChart?.songArtist;
            if (cArtist == null) cArtist = state.currentChart?.artist;
            
            var meta = state.currentChart?.metadata;
            if (cArtist == null && meta != null) cArtist = meta?.artist;

            if (cArtist != null && Std.string(cArtist) != "" && Std.string(cArtist) != "null") {
                _cachedSongArtist = Std.string(cArtist);
                return _cachedSongArtist;
            }
        }

        if (artistStr == "Unknown Artist" || artistStr == "null") {
            if (state.currentSong != null) {
                var sArtist = Std.string(state.currentSong.artist);
                if (sArtist != "" && sArtist != "null") {
                    artistStr = sArtist;
                } else if (state.currentSong.metadata != null && state.currentSong.metadata.artist != null) {
                    var mArtist = Std.string(state.currentSong.metadata.artist);
                    if (mArtist != "" && mArtist != "null") artistStr = mArtist;
                }
            }
        }
        
        if (artistStr != "Unknown Artist" && artistStr != "null") _cachedSongArtist = artistStr;
        return _cachedSongArtist;
    }

    public function getDifficulty():String {
        if (getKssValue("kssette_show_song_diff") != true) return "";
        var state = PlayState.instance;
        if (state == null) return "NORMAL";
        var diff:String = Std.string(state.currentDifficulty);
        return (diff == null || diff == "" || diff == "null") ? "NORMAL" : diff.toUpperCase();
    }

    public function getTimeRemaining():String {
        if (getKssValue("kssette_show_song_time") != true) return "";
        var state = PlayState.instance;
        if (state == null || state.conductorInUse == null) return "0:00";
        var remaining:Float = (state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000;
        if (remaining < 0) remaining = 0;
        return FlxStringUtil.formatTime(remaining, false);
    }

    public function getSongProgress():Float {
        var state = PlayState.instance;
        if (state == null || state.currentSongLengthMs <= 0) return 0.0;
        return Math.min(1.0, Math.max(0.0, state.conductorInUse.songPosition / state.currentSongLengthMs));
    }

    public function getNoteCount():Int {
        if (getKssValue("kssette_acc_mode") != "Ascending") return 0;
        var state = PlayState.instance;
        if (state == null || state.currentChart == null || state.currentChart.notes == null) return 0;
        var count:Int = 0;
        for (note in state.currentChart.notes) {
            var isPlayer = false;
            try {
                if (note.getMustHitNote() == true) isPlayer = true;
            } catch(e:Dynamic) {
                var d = note?.data;
                if (d == null) d = note?.d;
                if (d != null && Std.parseInt(Std.string(d)) >= 4) isPlayer = true;
                if (note?.mustHitNote == true) isPlayer = true;
            }
            if (isPlayer) count++;
        }
        return (count == 0) ? Std.int(state.currentChart.notes.length / 2) : count;
    }

    public function getNoteStyle():String {
        var state = PlayState.instance;
        if (state == null) return "funkin";
        if (state.currentChart != null && state.currentChart.playData != null && state.currentChart.playData.noteStyle != null) {
            return state.currentChart.playData.noteStyle;
        }
        return "funkin";
    }

    public function getRankID(state:PlayState):String {
        if (getKssValue("kssette_show_rank") != true) return "?";
        var t = Highscore.tallies;
        if (t == null || (t.totalNotesHit + t.missed) <= 0) return "?";
        
        if (state.songScore == lastRankScore && t.missed == lastRankMisses && cachedRank != "?") return cachedRank;

        lastRankScore = state.songScore;
        lastRankMisses = t.missed;
        cachedRank = Scoring.calculateRank({
            score: state.songScore,
            tallies: {
                sick: t.sick,
                good: t.good,
                bad: t.bad,
                shit: t.shit,
                miss: t.missed,
                combo: t.combo,
                maxCombo: t.maxCombo,
                totalNotesHit: t.totalNotesHit,
                totalNotes: t.totalNotesHit + t.missed
            }
        });
        return cachedRank;
    }

    public function getComboTier(state:PlayState):String {
        if (getKssValue("kssette_show_tier") != true) return "";
        var t = Highscore.tallies;
        if (t == null) return "N/A";
        
        if (t.missed == lastTierMisses && t.good == lastTierGoods && t.bad == lastTierBads && t.shit == lastTierShits && cachedTier != "N/A") return cachedTier;

        lastTierMisses = t.missed;
        lastTierGoods = t.good;
        lastTierBads = t.bad;
        lastTierShits = t.shit;

        if (t.missed == 0) {
            if (t.good == 0 && t.bad == 0 && t.shit == 0) cachedTier = "SFC";
            else if (t.bad == 0 && t.shit == 0) cachedTier = "GFC";
            else cachedTier = "FC";
        } else {
            cachedTier = (t.missed < 10) ? "SDCB" : "Clear";
        }
        return cachedTier;
    }

    public function getAccuracy(state:PlayState):Float {
        var t = Highscore.tallies;
        if (t == null) return 0.0;
        var total:Int = t.totalNotesHit + t.missed;
        if (total <= 0) return 0.0;
        var raw:Float = ((t.sick + t.good - t.missed) / total) * 100;
        return Math.floor(Math.max(0, raw) * 100) / 100;
    }

    public function getAscendingAccuracy(state:PlayState, cachedTotalNotes:Int):Float {
        if (getKssValue("kssette_acc_mode") != "Ascending") return 0.0;
        if (state == null) return 0.0;

        var realAcc:Float = getAccuracy(state);
        var totalPlayerNotes:Int = cachedTotalNotes;
        var processed:Int = 0;
        
        if (Highscore.tallies != null) {
            processed = Highscore.tallies.sick + Highscore.tallies.good + Highscore.tallies.bad + Highscore.tallies.shit + Highscore.tallies.missed;
            if (Highscore.tallies?.totalNotes != null) {
                var realTotal:Dynamic = Highscore.tallies.totalNotes;
                if (realTotal != null && realTotal > 0) totalPlayerNotes = Std.int(realTotal);
            }
        }

        if (processed > totalPlayerNotes) totalPlayerNotes = processed;

        var noteProgress:Float = (totalPlayerNotes > 0) ? (processed / totalPlayerNotes) : 1.0;
        if (noteProgress > 1.0) noteProgress = 1.0;
        
        var songProgress:Float = getSongProgress();
        if (Math.isNaN(songProgress) || songProgress < 0) songProgress = 0;
        if (songProgress >= 0.995) noteProgress = 1.0;
        
        return realAcc * noteProgress;
    }

    public function getChallenge():String {
        var msg = getModeMessage();
        var isBotting:Bool = (msg.indexOf('Botplay') != -1 || msg.indexOf('AutoPlay') != -1);
        var randomId = FlxG.random.int(100, 999);
        var challenge = 'sync_' + randomId;

        if (isBotting) {
            expectedResponse = 'err_' + (randomId * 3);
        } else {
            expectedResponse = 'ok_' + (randomId * 3);
        }
        return challenge;
    }

    public function sendResponse(response:String):Void {
        if (response == expectedResponse && expectedResponse != "") {
            heartbeatTimer = 4.0; 
            gracePeriod = 0;      
        } else {
            if (gracePeriod <= 0) isCompromised = true;
        }
    }

    public function getModeMessage():String {
        var state = PlayState.instance;
        if (state == null) return "";
        
        var gammodAutoMod = ModuleHandler.getModule("GammodAutoPlay");
        var gAutoPlay = gammodAutoPlay;
        if (gammodAutoMod != null) {
            var autoRaw:Dynamic = gammodAutoMod?.value;
            if (autoRaw == null) autoRaw = gammodAutoMod.scriptGet("value");
            gAutoPlay = (autoRaw != null && Std.string(autoRaw).toUpperCase() != "DISABLED");
            gammodAutoPlay = gAutoPlay;
        }

        var botplay:Bool = state.isBotPlayMode || (Save.instance.modOptions.get("BotMode") == true) || gAutoPlay;
        
        if (!botplay) {
            if (!_checkedSongId) {
                _checkedSongId = true;
                _cachedSongId = (state.currentSong != null && state.currentSong.id != null) ? state.currentSong.id : ((state.currentChart != null && state.currentChart.songName != null) ? state.currentChart.songName : "");
            }
            if (_cachedSongId != null && _cachedSongId.toLowerCase() == "termination") {
                if (_qtModule == null) _qtModule = ModuleHandler.getModule("QTdodgeModule");
                if (_qtModule != null && _qtModule?.scriptGet != null) {
                    var scriptGetFn:Dynamic = _qtModule.scriptGet;
                    if (scriptGetFn != null && scriptGetFn("qtBotplay") == true) botplay = true;
                }
            }
        }
        
        if (_cachedModeMsg != null && botplay == _cachedBotplay && gAutoPlay == _cachedGammodAuto) return _cachedModeMsg;
        
        _cachedBotplay = botplay;
        _cachedGammodAuto = gAutoPlay;
        var songName:String = getSongTitle();

        if (botplay) {
            if (gammodAutoPlay) _cachedModeMsg = 'Watching "' + songName + '" with AutoPlay';
            else _cachedModeMsg = 'Watching "' + songName + '" with Botplay';
        } else {
            _cachedModeMsg = "";
        }
        
        return _cachedModeMsg; 
    }

    public function isOptionLocked(key:String):Bool {
        var ms = Save.instance.modOptions.get("kssette_middlescroll");
        if (ms == null) ms = "Off";

        var hideOpp = Save.instance.modOptions.get("kssette_hide_opponent");
        if (hideOpp == null) hideOpp = "Off";

        if (key == "kssette_opponent_bg" && (ms != "Off" || Std.string(hideOpp) == "On" || Std.string(hideOpp) == "true")) return true;
        if (key == "kssette_opponent_opacity") {
            if (ms == "Off" && (Std.string(hideOpp) == "On" || Std.string(hideOpp) == "true")) return true;
            if (ms == "Hidden Notes" || ms == "Like Mobile" || ms == "Glass") return true;
            if (isMobileMode) {
                var mobPc = Save.instance.modOptions.get("kssette_mobile_keyboard");
                if (mobPc != "On" && mobPc != true) {
                    var mobOpp = Save.instance.modOptions.get("kssette_mobile_opp_notes");
                    if (mobOpp == null) mobOpp = "On";
                    if (Std.string(mobOpp) == "Off" || Std.string(mobOpp) == "false") return true;
                }
            }
        }
        if (key == "kssette_hide_opponent" && ms != "Off") return true;
        if (key == "kssette_opponent_pos" && ms == "Off") return true;
        if (key == "kssette_breakbar_pos" && ms != "Off") return true;

        var gt = Save.instance.modOptions.get("kssette_ghost_tapping");
        if (gt == null) gt = isMobileMode ? "Off" : "On";
        if (key == "kssette_ghost_sing" && gt == "Off") return true;

        var jp = Save.instance.modOptions.get("kssette_judge_pos");
        if (jp == null) jp = "Off";
        if (key == "kssette_show_misses" && jp != "Off") return true;

        var intro = Save.instance.modOptions.get("kssette_intro_text");
        if (intro == null) intro = "Classic";
        if (key == "kssette_intro_pos" && (intro == "Off" || intro == false || intro == "Clap")) return true;
        if (key == "kssette_intro_album" && (intro == "Off" || intro == false)) return true;

        return false;
    }

    public function getKssValue(key:String):Dynamic { 
        if (key == "isCompromised") return isCompromised;
        if (!_kssCacheReady) refreshOptionCache();
        
        var val:Dynamic = null;
        if (_kssCache != null && _kssCache.exists(key)) val = _kssCache.get(key);
        else val = normalizeKssValue(key, Save.instance.modOptions.get(key));
        
        if (isOptionLocked(key)) {
            if (key == "kssette_opponent_bg" || key == "kssette_ghost_sing" || key == "kssette_show_misses") return false;
            if (key == "kssette_breakbar_pos") return "Center";
        }

        return val;
    }

    function getModFolders():Array<String> {
        var folders:Array<String> = [];
        try {
            var loadedMods = PolymodHandler.loadedModIds;
            if (loadedMods != null && loadedMods.length > 0) for (mod in loadedMods) folders.push(mod);
        } catch(e:Dynamic) {}

        if (folders.length == 0) {
            try {
                var readMods = FileUtil.readDir("mods");
                if (readMods != null) for (mod in readMods) folders.push(mod);
            } catch(e:Dynamic) {}
        }
        return folders;
    }

    public function getAvailableFonts():Map<String, String> {
        if (cachedFontMap != null) return cachedFontMap;
        
        var fonts:Map<String, String> = [
            "VCR (Default)" => "vcr.ttf",
            "Senpai Pixel (Default)" => "pixel.otf"
        ]; 
        var blacklist = ["vcr.ttf", "pixel.otf", "ds_digii.ttf", "ds_digib.ttf", "ds_digi.ttf", "nokiafc22.ttf", "arial.ttf", "5by7_b.ttf", "consolas.ttf", "quantico_bolditalic.ttf", "quantico_bold.ttf", "quantico_regular.ttf", "inconsolata_semibold.ttf", "inconsolata_bold.ttf", "inconsolata_medium.ttf", "vcr_italic.ttf", "inconsolata_extralight.ttf", "insolata_regular.ttf", "5by7.ttf", "quantico_italic.ttf", "monsterrat.ttf", "vcr_bold.ttf", "vcr_bolditalic.ttf", "incosolata_black.ttf"];

        var files = Assets.list();
        if (files != null) {
            try {
                for (file in files) {
                    var f = file.toLowerCase();
                    var normalizedFile = StringTools.replace(f, "\\", "/");
                    if (normalizedFile.indexOf("fonts/") != -1 && (StringTools.endsWith(normalizedFile, ".ttf") || StringTools.endsWith(normalizedFile, ".otf"))) {
                        var normalizedPath = StringTools.replace(file, "\\", "/");
                        var slashIdx = normalizedPath.lastIndexOf("/");
                        var fileName = slashIdx == -1 ? normalizedPath : normalizedPath.substr(slashIdx + 1);
                        if (blacklist.indexOf(fileName.toLowerCase()) == -1) {
                            fonts.set(fileName, fileName);
                        }
                    }
                }
            } catch(e:Dynamic) {}
        }
        
        for (folder in getModFolders()) {
            var path = "mods/" + folder + "/fonts";
            try {
                var dirFiles = FileUtil.readDir(path);
                if (dirFiles != null) {
                    for (file in dirFiles) {
                        var f = file.toLowerCase();
                        if (StringTools.endsWith(f, ".ttf") || StringTools.endsWith(f, ".otf")) {
                            if (blacklist.indexOf(f) == -1) {
                                fonts.set(file, file); 
                            }
                        }
                    }
                }
            } catch(e:Dynamic) {}
        }

        cachedFontMap = fonts;
        return fonts;
    }

    public function resolveCustomFont(fontKey:String):String {
        if (fontKey == "vcr.ttf" || fontKey == "VCR OSD Mono" || fontKey == "null" || fontKey == "") return "VCR OSD Mono";
        if (fontKey == "pixel.otf" || fontKey == "Pixel Arial 11" || fontKey == "Senpai Pixel (Default)") return Paths.font("pixel.otf");
        if (cachedResolvedFonts == null) {
            cachedResolvedFonts = ["__dummy__" => ""];
            cachedResolvedFonts.remove("__dummy__");
        }
        if (cachedResolvedFonts.exists(fontKey)) return cachedResolvedFonts.get(fontKey);
        
        var foundPath:String = ""; 
        var files = Assets.list();
        if (files != null) {
            try {
                for (file in files) {
                    var f = file.toLowerCase();
                    var normalizedFile = StringTools.replace(f, "\\", "/");
                    if (normalizedFile.indexOf("fonts/") != -1 && StringTools.endsWith(normalizedFile, fontKey.toLowerCase())) {
                        foundPath = file;
                        break;
                    }
                }
            } catch(e:Dynamic) {}
        }

        if (foundPath == "") {
            for (folder in getModFolders()) {
                if (foundPath != "") break; 
                var path = "mods/" + folder + "/fonts";
                try {
                    var dirFiles = FileUtil.readDir(path);
                    if (dirFiles != null) {
                        for (f in dirFiles) {
                            if (f.toLowerCase() == fontKey.toLowerCase()) {
                                foundPath = "mods/" + folder + "/fonts/" + f;
                                break;
                            }
                        }
                    }
                } catch(e:Dynamic) {}
            }
        }
        
        if (foundPath == "") foundPath = "VCR OSD Mono";
        cachedResolvedFonts.set(fontKey, foundPath);
        return foundPath;
    }

    public function getCustomFont():String {
        var fontKey:String = Std.string(getKssValue("kssette_custom_font"));
        if (fontKey == lastFontKey && cachedCustomFontPath != "") return cachedCustomFontPath;
        var resolved = resolveCustomFont(fontKey);
        lastFontKey = fontKey;
        cachedCustomFontPath = resolved;
        return resolved;
    }

    public function getCustomPixelFont():String {
        var fontKey:String = Std.string(getKssValue("kssette_custom_pixel_font"));
        if (fontKey == lastPixelFontKey && cachedCustomPixelFontPath != "") return cachedCustomPixelFontPath;
        var resolved = resolveCustomFont(fontKey);
        lastPixelFontKey = fontKey;
        cachedCustomPixelFontPath = resolved;
        return resolved;
    }

    public function getHudFont():String {
        var styleId:String = "funkin";
        
        if (PlayState.instance != null) {
            if (PlayState.instance.currentChart != null) {
                var pData = PlayState.instance.currentChart?.playData;
                if (pData != null) {
                    var nStyle = pData?.noteStyle;
                    if (nStyle != null) styleId = Std.string(nStyle);
                } else {
                    var nStyle = PlayState.instance.currentChart?.noteStyle;
                    if (nStyle != null) styleId = Std.string(nStyle);
                }
            }
        }

        if (_cachedHudFont != "" && _cachedHudStyleId == styleId) return _cachedHudFont;

        var currentStyleId:String = styleId;
        var depth:Int = 0;
        var maxDepth:Int = 5;
        
        while (currentStyleId != null && depth < maxDepth) {
            var styleEntry = NoteStyleRegistry.instance.fetchEntry(currentStyleId);
            if (styleEntry == null) break;
            
            var data = styleEntry?._data;

            if (data != null) {
                var assets = data?.assets;

                if (assets != null) {
                    var note = assets?.note;

                    if (note != null) {
                        var isPixelVal:Dynamic = note?.isPixel;
                        
                        if (isPixelVal == true || isPixelVal == "true") {
                            _cachedHudStyleId = styleId;
                            _cachedHudFont = getCustomPixelFont();
                            return _cachedHudFont;
                        } else if (isPixelVal == false || isPixelVal == "false") {
                            break;
                        }
                    }
                }
                
                var fallbackStyle = data?.fallback;

                if (fallbackStyle != null && Std.string(fallbackStyle) != "" && Std.string(fallbackStyle) != "null") {
                    currentStyleId = Std.string(fallbackStyle);
                } else {
                    currentStyleId = null;
                }
            } else {
                currentStyleId = null;
            }
            depth++;
        }
        
        _cachedHudStyleId = styleId;
        _cachedHudFont = getCustomFont();
        return _cachedHudFont;
    }

    function checkGammod(elapsed:Float) {
        if (_gammodPlay != null) {
            var gPlay:Dynamic = _gammodPlay;
            if (gPlay.curMultTxt != null) gPlay.curMultTxt.visible = false;
            if (gPlay.curNoRankTxt != null) gPlay.curNoRankTxt.visible = false;
            if (gPlay.scoreTxtFX != null) gPlay.scoreTxtFX.visible = false;
            if (gPlay.scoreTxtFXOut != null) gPlay.scoreTxtFXOut.visible = false;
            gammodHighscoreActive = (gPlay.didHighscoreEvents == true);
        } else {
            gammodHighscoreActive = false;
        }

        _gammodCheckTimer += elapsed;
        if (_gammodCheckTimer < 0.25) return;
        
        _gammodCheckTimer = 0.0;

        var gammodHandler = _gammodHandler;
        if (gammodHandler != null) {
            var modsOnRaw:Dynamic = gammodHandler?.mods_on;
            if (modsOnRaw == null) modsOnRaw = gammodHandler.scriptGet("mods_on");
            if (modsOnRaw == null) {
                var activeArray:Dynamic = gammodHandler.getActive();
                if (activeArray != null && activeArray.length > 0) modsOnRaw = true;
            }
            isGammodMode = (modsOnRaw == true);
        } else {
            isGammodMode = false;
        }

        var gammodMult = _gammodMult;
        if (gammodMult != null) {
            var unrankedRaw:Dynamic = gammodMult?.unranked;
            if (unrankedRaw == null) unrankedRaw = gammodMult.scriptGet("unranked");
            if (unrankedRaw == null) {
                if (gammodMult?.isUnranked != null) {
                    unrankedRaw = gammodMult.isUnranked();
                }
            }
            gammodUnranked = (unrankedRaw == true);
            var multRaw:Dynamic = gammodMult?.score_multiplier;
            if (multRaw == null) multRaw = gammodMult.scriptGet("score_multiplier");
            if (multRaw == null) {
                if (gammodMult?.curMult != null) {
                    multRaw = gammodMult.curMult();
                }
            }
            if (multRaw != null) gammodMultiplier = multRaw;
            else gammodMultiplier = 1.0;
        } else {
            gammodUnranked = false;
            gammodMultiplier = 1.0;
        }

        var gammodRate = _gammodRate;
        if (gammodRate != null) {
            var rateRaw:Dynamic = gammodRate?.value;
            if (rateRaw == null) rateRaw = gammodRate.scriptGet("value");
            if (rateRaw != null) gammodPlaybackRate = rateRaw;
            else gammodPlaybackRate = 1.0;
        } else {
            gammodPlaybackRate = 1.0;
        }

        var gammodAutoMod = _gammodAuto;
        if (gammodAutoMod != null) {
            var autoRaw:Dynamic = gammodAutoMod?.value;
            if (autoRaw == null) autoRaw = gammodAutoMod.scriptGet("value");
            gammodAutoPlay = (autoRaw != null && Std.string(autoRaw).toUpperCase() != "DISABLED");
        } else {
            gammodAutoPlay = false;
        }

        var gammodSideMod = _gammodSide;
        if (gammodSideMod != null) {
            var sideRaw:Dynamic = gammodSideMod?.value;
            if (sideRaw == null) sideRaw = gammodSideMod.scriptGet("value");
            if (sideRaw != null) gammodPlayerSide = Std.string(sideRaw).toUpperCase();
            else gammodPlayerSide = "NORMAL";
        } else {
            gammodPlayerSide = "NORMAL";
        }
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        
        if (!_hasStartedUpdateCheck) {
            _hasStartedUpdateCheck = true;
            checkForUpdates();
        }

        if (Highscore.tallies != null) missesCount = Highscore.tallies.missed;

        var state = PlayState.instance;
        if (state == null) {
            if (_isInPlayState) {
                _isInPlayState = false;
                clearGammodCache();
            }
            return;
        }

        checkGammod(event.elapsed);

        if (_isInPlayState) {
            if (state.scoreText != null) state.scoreText.visible = false;





            if (state.startingSong) return;

            if (!isCompromised) {
                if (gracePeriod > 0) gracePeriod -= event.elapsed;
                heartbeatTimer -= event.elapsed;
                _integrityTimer += event.elapsed;

                if (heartbeatTimer <= 0 && gracePeriod <= 0) {
                    isCompromised = true;
                } else if (gracePeriod <= 0 && _integrityTimer >= 0.5) {
                    _integrityTimer = 0.0;
                    if (_accModule == null) _accModule = ModuleHandler.getModule("KssetteAccuracy");
                    
                    if (_accModule == null) {
                        isCompromised = true;
                    } else {
                        var msg = getModeMessage();
                        var isBotting:Bool = (msg != null && (msg.indexOf('Botplay') != -1 || msg.indexOf('AutoPlay') != -1));
                        
                        if (isBotting) {
                            if (_accModule != null) {
                                if (_accModule?.modeText != null) {
                                    var modeTxt = _accModule.modeText;
                                    if (modeTxt != null && modeTxt.visible == false || modeTxt.alpha < 0.1 || (modeTxt.text.indexOf("Botplay") == -1 && modeTxt.text.indexOf("AutoPlay") == -1)) {
                                        isCompromised = true;
                                    }
                                } else {
                                    isCompromised = true;
                                }
                            }
                        }
                    }
                }
            }
        } else {
            heartbeatTimer = 4.0;
            gracePeriod = 3.0;
            // If it was compromised (asleep), keep it that way.
            _integrityTimer = 0.0;
            _accModule = null;
        }
    }

    override public function onStateChangeEnd(event:StateChangeScriptEvent):Void {
        var target = event.targetState;
        refreshOptionCache();
        
        if (target != null && Std.isOfType(target, MainMenuState)) {
            var updateStr = updateAvailable ? " (UPDATE AVAILABLE)" : "";
            var mmWatermark = new FlxText(0, FlxG.height - 24, FlxG.width - 12, "KASSETTE HUD v" + hudVersion + updateStr, 16);
            mmWatermark.setFormat(Paths.font("vcr.ttf"), 16, FlxColor.WHITE, "right", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            mmWatermark.scrollFactor.set(0, 0);
            target.add(mmWatermark);

            if (!_hasShownUpdateScreen) {
                _hasShownUpdateScreen = true;
                if (updateAvailable) {
                    trace("[KssetteUpdate] Transitioning to KssetteUpdateState!");
                    FlxG.switchState(ScriptedMusicBeatState.init("KssetteUpdateState"));
                    return;
                } else {
                    trace("[KssetteUpdate] Not transitioning, updateAvailable is false.");
                }
            }
        }
        
        if (Std.isOfType(target, OptionsState)) {
            addSettingsCategory(target);
        }

        if (Std.isOfType(target, PlayState)) {
            _isInPlayState = true;
            createHUDWatermark(target);
        } else {
            if (_isInPlayState) {
                _isInPlayState = false;
                clearGammodCache();
            }
        }
    }

    function createHUDWatermark(state:PlayState) {
        if (state == null || state.camHUD == null) return;
        checkGammod(0.0);
        
        var platform = isMobileMode ? (isMobileLikePC() ? "Mobile+KB" : "Mobile") : "PC";
        var safeMargin:Float = isMobileMode ? 85 : 8;
        
        var timeBarPos = getKssValue("kssette_timebar_pos");
        var yPos:Float = (timeBarPos == "Bottom" || timeBarPos == "Bottom Right") ? 10 : (FlxG.height - 24);

        var gammodAdd:String = isGammodMode ? " + GAMMOD" : "";
        var watermark = new FlxText(0, yPos, FlxG.width - safeMargin, "Kassette HUD " + platform + " [" + hudVersion + "]" + gammodAdd, 16);
        watermark.setFormat("VCR OSD Mono", 16, FlxColor.WHITE, "right", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        watermark.alpha = 0.5; watermark.zIndex = 1000; watermark.cameras = [state.camHUD];
        state.add(watermark);
    }

    public function addSettingsCategory(state:OptionsState) {
        var codex = state.optionsCodex;
        var mainPage = codex.pages.get('options');
        if (mainPage == null) return;

        var label = isMobileMode ? "KASSETTE HUD MOBILE" : "KASSETTE HUD";
        
        var i:Int = mainPage.items.members.length - 1;
        while (i >= 0) {
            var item = mainPage.items.members[i];
            if (item != null && (item.label == "KASSETTE HUD" || item.label == "KASSETTE HUD MOBILE")) {
                mainPage.items.remove(item, true); 
                item.destroy();
            }
            i--;
        }

        var item = mainPage.createItem(label, function() { 
            FlxG.camera.fade(FlxColor.BLACK, 0.4, false, function() {
                FlxG.switchState(ScriptedMusicBeatState.init("KssetteMenuState"));
            });
        });
        
        var pref = mainPage.items.getItem("PREFERENCES");
        if (pref != null) {
            mainPage.items.members.remove(item);
            mainPage.items.members.insert(mainPage.items.members.indexOf(pref) + 1, item);
        }
        
        for (i in 0...mainPage.items.length) { 
            if (mainPage.items.members[i] != null) mainPage.items.members[i].y = 100 * (i + 1); 
        }
    }
}