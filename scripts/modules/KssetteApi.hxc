    }

    public function preloadFontsIndex():Void {
        if (fontsPreloaded) return;
        var fontMap:Dynamic = getAvailableFonts();
        
        if (fontMap != null) {
            var keys:Array<String> = [];
            var kIter = fontMap.keys();
            for (k in kIter) keys.push(Std.string(k));
            
            var allFonts:Array<Dynamic> = [];
            var variantParts = ["-bold", "-italic", "-regular", "-light", "-medium", "-semibold", "-black", "_bold", "_italic", "_regular", " bold", " italic", " regular"];
            for (k in keys) {
                var fFile = fontMap.get(k);
                var fPath = "VCR OSD Mono";
                fPath = resolveCustomFont(fFile);

                var rawName = k;
                var lowerK = k.toLowerCase();
                if (StringTools.endsWith(lowerK, ".ttf") || StringTools.endsWith(lowerK, ".otf")) {
                    rawName = k.substr(0, k.length - 4);
                }

                var familyRaw = rawName;
                var rawLower = rawName.toLowerCase();
                var variantName = "Regular";
                
                for (v in variantParts) {
                    var vIdx = rawLower.lastIndexOf(v);
                    if (vIdx != -1 && vIdx > 0) {
                        familyRaw = rawName.substr(0, vIdx);
                        var vRaw = rawName.substr(vIdx + 1);
                        var cleanV = "";
                        for (i in 0...vRaw.length) {
                            var char = vRaw.charAt(i);
                            if (char != "-" && char != "_" && char != " ") cleanV += char;
                        }
                        if (cleanV.length > 0) {
                            variantName = cleanV.substr(0,1).toUpperCase() + cleanV.substr(1);
                        } else {
                            variantName = vRaw;
                        }
                        break;
                    }
                }

                if (familyRaw.toLowerCase() == "vcr" || k == "VCR (Default)") { familyRaw = "VCR OSD Mono"; variantName = "Default"; }
                if (familyRaw.toLowerCase() == "pixel" || k == "Senpai Pixel (Default)") { familyRaw = "Senpai Pixel"; variantName = "Default"; }

                allFonts.push({
                    key: k,
                    file: fFile,
                    path: fPath,
                    family: familyRaw,
                    variant: variantName
                });
            }

            var familiesData:Array<Dynamic> = [];
            for (f in allFonts) {
                var fam = f.family;
                var found = false;
                for (fd in familiesData) {
                    if (fd.name == fam) {
                        fd.variants.push(f);
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    familiesData.push({name: fam, variants: [f]});
                }
            }

            familiesData.sort(function(a:Dynamic, b:Dynamic):Int {
                var nameA:String = a.name.toLowerCase();
                var nameB:String = b.name.toLowerCase();
                if (nameA < nameB) return -1;
                if (nameA > nameB) return 1;
                return 0;
            });
            
            preloadedAllFonts = allFonts;
            preloadedFamiliesData = familiesData;
        }
        fontsPreloaded = true;
    }

    function initSettings() {
        var changed:Bool = false;

        for (opt in optionKeys) {
            if (!Save.instance.modOptions.exists(opt)) {
                var defaultVal:Dynamic = "On";
                switch (opt) {
                    case "kssette_middlescroll", "kssette_hide_opponent", "kssette_opponent_bg", "kssette_ghost_sing", "kssette_judge_pos", "kssette_smart_karaoke", "kssette_night_mode", "kssette_hitsound", "kssette_mobile_keyboard", "kssette_score_bop":
                        defaultVal = "Off";
                    case "kssette_mobile_opp_notes":
                        defaultVal = "On";
                    case "kssette_opponent_pos":
                        defaultVal = "Left";
                    case "kssette_acc_mode":
                        defaultVal = "Classic";
                    case "kssette_info_pos":
                        defaultVal = "Below Score";
                    case "kssette_timebar_pos":
                        defaultVal = "Bottom";
                    case "kssette_custom_font", "kssette_intro_font_title", "kssette_intro_font_artist":
                        defaultVal = "vcr.ttf";
                    case "kssette_custom_pixel_font":
                        defaultVal = "pixel.otf";
                    case "kssette_opponent_opacity":
                        defaultVal = "100%";
                    case "kssette_night_start":
                        defaultVal = "20:00";
                    case "kssette_night_end":
                        defaultVal = "06:00";
                    case "kssette_night_opacity":
                        defaultVal = "65%";
                    case "kssette_hitsound_volume":
                        defaultVal = "100%";
                    case "kssette_icon_pos":
                        defaultVal = "Default";
                    case "kssette_ghost_tapping":
                        defaultVal = isMobileMode ? "Off" : "On";
                    case "kssette_breakbar_style":
                        defaultVal = "Default";
                    case "kssette_breakbar_pos":
                        defaultVal = "Center";
                }

                Save.instance.modOptions.set(opt, defaultVal);
                changed = true;
            }
        }
        if (changed) Save.instance.flush();
    }

