    public function checkForUpdates() {
        if (_versionChecked) return;
        _versionChecked = true;
        
        trace("[KssetteUpdate] Initializing update check with URLLoader (thx u Dpz)...");
        try {
            var loader = new URLLoader();
            var _url:String = "https://raw.githubusercontent.com/mkssette/FNF-Kassette-HUD/refs/heads/info/last_version.txt";
            
            trace("Attempting to get string from URL: " + _url);
            loader.dataFormat = 1; // URLLoaderDataFormat.TEXT
            
            loader.addEventListener("complete", function(e:Event) {
                var data:String = loader.data;
                trace("[KssetteUpdate] DOWNLOADED VERSION: '" + data + "'");
                if (data != null && data != "") {
                    var v = StringTools.trim(data);
                    trace("[KssetteUpdate] COMPARING: Downloaded '" + v + "' vs Current '" + hudVersion + "'");
                    if (v != "" && v != hudVersion && v != "0.2.3.a1") {
                        trace("[KssetteUpdate] UPDATE AVAILABLE! Proceeding to notify.");
                        latestVersion = v;
                        updateAvailable = true;
                    } else {        
                        trace("[KssetteUpdate] NO UPDATE NEEDED. Versions match.");
                    }
                }
            });
            
            loader.addEventListener(IOErrorEvent.IO_ERROR, function(e:Dynamic) {
                trace("[KssetteUpdate] ERROR FETCHING UPDATE (IOError): " + Std.string(e));
            });
            
            loader.addEventListener("securityError", function(e:Dynamic) {
                trace("[KssetteUpdate] ERROR FETCHING UPDATE (Security Error): " + Std.string(e));
            });
            
            loader.load(new URLRequest(_url));
        } catch(e:Dynamic) {
            trace("[KssetteUpdate] CAUGHT EXCEPTION: " + Std.string(e));
        }
    }
    
