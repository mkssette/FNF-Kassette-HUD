    public function new() {
        super("KssetteSubtitles");
        elementType = "modifier";
    }



    /**
     * Cancels all active animation tweens (show/hide, karaoke reveal, scale pulse).
     * Safe to call even if no tweens are active.
     */
    function cancelAnimTweens() {
        if (currentTween != null) {
            currentTween.cancel();
            currentTween = null;
        }
        if (karaokeTween != null) {
            karaokeTween.cancel();
            karaokeTween = null;
        }
        if (scaleTween != null) {
            scaleTween.cancel();
            scaleTween = null;
        }
    }

    /**
     * Resets subtitle state without destroying the text object.
     * Cancels tweens, clears the subText reference, and resets active entry tracking.
     */
    function cleanUp() {
        cancelAnimTweens();
        subText = null;
        isShowing = false;
        cachedRawUntil = -1000.0;
        cachedActiveEntry = null;
    }

    /**
     * Fully destroys the subtitle FlxText object and removes it from the scene.
     * Calls cleanUp() first to cancel tweens and reset state.
     */
    function destroySubText() {
        var oldText = subText;
        cleanUp();
        if (oldText != null) {
            if (PlayState.instance != null && !isPreview) PlayState.instance.remove(oldText, true);
            FlxG.state.remove(oldText, true);
            oldText.destroy();
        }
        subText = null;
    }

    /**
     * Creates the subtitle FlxText object and adds it to the given camera.
     * Destroys any existing subText first to avoid duplication.
     * @param cam  Camera to assign the subtitle text to.
     */
    function createSubText(cam:FlxCamera) {
        if (subText != null) {
            destroySubText();
        }
        
        subText = new FlxText(0, 0, FlxG.width, "", defaultFontSize);
        subText.borderSize = 1.5; 
        subText.visible = false;
        subText.cameras = [cam];
        subText.zIndex = 1010;
        if (PlayState.instance != null && !isPreview) PlayState.instance.add(subText);
        else FlxG.state.add(subText);
    }

    /**
     * Parses a simple HTML-formatted string, stripping tags to create plain text
     * and recording format ranges for color, bold, and italics.
     * @param htmlStr      Input string with <font>, <i>, <b> tags.
     * @param defaultColor Fallback text color to apply if no <font color> is active.
     */
    function compileHTML(htmlStr:String, defaultColor:Int) {
        cachedPlainText = "";
        if (cachedFormats == null) cachedFormats = [];
        else cachedFormats.resize(0);
        
        var i = 0;
        var colorStack = [defaultColor];
        var italicStack = [false];
        var boldStack = [false];
        
        var curStart = 0;
        var curColor = defaultColor;
        var curItalic = false;
        var curBold = false;
        
        while (i < htmlStr.length) {
            var char = htmlStr.charAt(i);
            if (char == "<") {
                var tagEnd = htmlStr.indexOf(">", i);
                if (tagEnd != -1) {
                    var tag = htmlStr.substring(i, tagEnd + 1).toLowerCase();
                    var tagChanged = false;
                    
                    if (StringTools.startsWith(tag, "<font")) {
                        var colIdx = tag.indexOf("color=");
                        var pCol = colorStack[colorStack.length - 1];
                        if (colIdx != -1) {
                            var quoteChar = tag.charAt(colIdx + 6);
                            var valEnd = tag.indexOf(quoteChar, colIdx + 7);
                            if (valEnd != -1) {
                                var colStr = htmlStr.substring(i + colIdx + 7, i + valEnd);
                                var parsedCol:Null<Int> = null;
                                parsedCol = FlxColor.fromString(colStr);
                                if (parsedCol == null) {
                                    if (StringTools.startsWith(colStr, "#")) colStr = "0xFF" + colStr.substring(1);
                                    parsedCol = Std.parseInt(colStr);
                                }
                                if (parsedCol != null) pCol = parsedCol;
                            }
                        }
                        colorStack.push(pCol);
                        tagChanged = true;
                    } else if (tag == "</font>") {
                        if (colorStack.length > 1) colorStack.pop();
                        tagChanged = true;
                    } else if (tag == "<i>") {
                        italicStack.push(true);
                        tagChanged = true;
                    } else if (tag == "</i>") {
                        if (italicStack.length > 1) italicStack.pop();
                        tagChanged = true;
                    } else if (tag == "<b>") {
                        boldStack.push(true);
                        tagChanged = true;
                    } else if (tag == "</b>") {
                        if (boldStack.length > 1) boldStack.pop();
                        tagChanged = true;
                    }
                    
                    if (tagChanged) {
                        if (cachedPlainText.length > curStart) {
                            if (curColor != defaultColor || curItalic || curBold) {
                                var fmt = new FlxTextFormat(curColor, curBold, curItalic, 0xFF000000);
                                cachedFormats.push({start: curStart, end: cachedPlainText.length, format: fmt});
                            }
                        }
                        curStart = cachedPlainText.length;
                        curColor = colorStack[colorStack.length - 1];
                        curItalic = italicStack[italicStack.length - 1];
                        curBold = boldStack[boldStack.length - 1];
                    }
                    
                    i = tagEnd + 1;
                    continue;
                }
            }
            cachedPlainText += char;
            i++;
        }
        
        if (cachedPlainText.length > curStart) {
            if (curColor != defaultColor || curItalic || curBold) {
                var fmt = new FlxTextFormat(curColor, curBold, curItalic, 0xFF000000);
                cachedFormats.push({start: curStart, end: cachedPlainText.length, format: fmt});
            }
        }
    }

    /**
     * Updates the text value and applies cached text formats up to a given character length.
     * Used heavily by the karaoke effect to selectively format only the revealed characters.
     * @param visibleLen The number of plain-text characters that should receive formatting.
     */
    function updateTextDisplay(visibleLen:Int) {
        if (subText == null || !subText.exists) return;
        
        subText.text = cachedPlainText.substring(0, visibleLen);
        subText.clearFormats();
        
        for (fData in cachedFormats) {
            if (fData.start < visibleLen) {
                var endP = Math.min(fData.end, visibleLen);
                if (fData.start < endP) {
                    subText.addFormat(fData.format, fData.start, Std.int(endP));
                }
            }
        }
    }

    /**
     * Prepares the UI for the options menu preview mode.
     * @param cam The preview camera to render subtitles on.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        // apiModule removed
        
        createSubText(cam);
        
        lastRawText = "";
        isShowing = false;
        updateTimer = 0.0;
        
        updatePreview();
    }

    /**
     * Refreshes the preview state, pulling new settings from KssetteApi.
     * Resets the preview cycle timer.
     */
    public function updatePreview() {
        if (!isPreview) return;
        
        if (KssetteFontManager.instance != null) cachedFont = KssetteFontManager.instance.getHudFont();
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";
        
        animType = Std.string(getSetting("kssette_subtitles_anim"));
        if (animType == "null" || animType == "") animType = "Vanilla";
        if (animType == "Karaoke") animType = "Fade"; 
        
        posType = Std.string(getSetting("kssette_subtitles_pos"));
        if (posType == "null" || posType == "") posType = "Bottom";
        
        smartKaraoke = getSetting("kssette_smart_karaoke") == true;
        
        targetPreviewTick = FlxG.game.ticks + 500;
        previewState = 0;
        lastRawText = "";
    }

    /**
     * Clears subtitle state when a song is retried.
     */
    override public function onSongRetry(event:Dynamic) {
        super.onSongRetry(event);
        destroySubText();
        lastRawText = "";
        localSubIndex = 0;
        cachedRawUntil = -1000.0;
        cachedActiveEntry = null;
    }
    
    /**
     * Called at song start. Initializes text objects, caches settings,
     * and resets internal variables/flags.
     */
    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPreview = false;
        
        if (KssetteFontManager.instance != null) cachedFont = KssetteFontManager.instance.getHudFont();
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";
        
        animType = Std.string(getSetting("kssette_subtitles_anim"));
        if (animType == "null" || animType == "") animType = "Vanilla";
        if (animType == "Karaoke") animType = "Fade"; 
        
        posType = Std.string(getSetting("kssette_subtitles_pos"));
        if (posType == "null" || posType == "") posType = "Bottom";
        
        smartKaraoke = getSetting("kssette_smart_karaoke") == true;
        
        var state = PlayState.instance;
        if (state == null) return;

        createSubText(state.camHUD);
        
        lastRawText = "";
        isShowing = false;
        updateTimer = 0.0;
        
        _nativeSubs = null;
        _nativeBg = null;
        _nativeTextObj = null;
        _cachedEntries = null;
        lastTargetCam = null;
        
        checkedKssttl = false;
        kssttlModule = null;
        localSubIndex = 0;
        cachedRawUntil = -1000.0;
        cachedActiveEntry = null;
    }
    
    /**
     * Per-frame update. Manages:
     *   - Preview mode looping and trivia display.
     *   - Extracting text/timing data from the native subtitle system (as a fallback).
     *   - Synchronizing with the song conductor.
     *   - Calculating and running the karaoke tweens and show/hide animations.
     */
    override public function onUpdate(event:Dynamic) {
        var baseElapsed:Float = FlxG.elapsed;
        if (baseElapsed <= 0) baseElapsed = 0.016; 
        if (baseElapsed > 0.1) baseElapsed = 0.1; 

        if (subText == null) return;
        
        if (PlayState.instance == null && !isPreview) return;

        if (!subText.exists || !subText.active) {
            cleanUp();
            return;
        }

        updateTimer += baseElapsed;
        if (updateTimer < 0.008) return;
        var elapsed:Float = updateTimer;
        updateTimer = 0.0;

        var rawTargetText:String = "";
        var activeEntry:Dynamic = null;
        var isCutscene:Bool = false;
        var currentSubsTime:Float = -1000;

        if (isPreview) {
            if (previewState == 1 || previewState == 3) {
                rawTargetText = lastRawText;
            } else {
                rawTargetText = "";
            }

            if (FlxG.game.ticks >= targetPreviewTick) {
                previewState++;
                if (previewState > 3) {
                    previewState = 0;
                }
                
                if (previewState == 0) {
                    targetPreviewTick = FlxG.game.ticks + 1000; 
                    rawTargetText = "";
                } else if (previewState == 1) {
                    var safeIdx = FlxG.random.int(0, triviaArray.length - 1);
                    rawTargetText = triviaArray[safeIdx];
                    targetPreviewTick = FlxG.game.ticks + 4000; 
                } else if (previewState == 2) {
                    targetPreviewTick = FlxG.game.ticks + 1000;
                    rawTargetText = "";
                } else if (previewState == 3) {
                    rawTargetText = "<font color=\"#FF0000\">Testing Colors & Custom Fonts!</font>";
                    targetPreviewTick = FlxG.game.ticks + 4000; 
                }
            }
            
            isCutscene = false;

            if (previewCam != null && (subText.cameras == null || subText.cameras[0] != previewCam)) {
                subText.cameras = [previewCam];
            }
        } else {
            var state = PlayState.instance;
            if (state == null) return;

            if (!checkedKssttl) {
                kssttlModule = ModuleHandler.getModule("KssttLSubtitles");
                checkedKssttl = true;
            }

            if (kssttlModule != null && kssttlModule.activeForSong && kssttlModule.disableKassetteSubs) {
                if (subText.visible) subText.visible = false;
                return;
            }

            if (_nativeSubs == null) {
                _nativeSubs = state?.subtitles;
                if (_nativeSubs != null) {
                    _nativeBg = _nativeSubs?.background;
                    _nativeTextObj = _nativeSubs?.subtitleText;
                }
            }

            if (_nativeSubs != null) {
                var nCams:Dynamic = _nativeSubs?.cameras;
                var targetCam:Dynamic = null;
                
                if (nCams != null && nCams.length > 0) {
                    targetCam = nCams[0];
                } else {
                    var cOth = state?.camOther;
                    if (cOth != null) targetCam = cOth;
                    else targetCam = state?.camHUD;
                }

                if (targetCam != null && lastTargetCam != targetCam) {
                    lastTargetCam = targetCam;
                    subText.cameras = [targetCam];
                }

                _nativeSubs.visible = false; _nativeSubs.alpha = 0;
                if (_nativeBg != null) {
                    _nativeBg.visible = false; _nativeBg.alpha = 0;
                }
                if (_nativeTextObj != null) {
                    _nativeTextObj.visible = false; _nativeTextObj.alpha = 0;
                }

                // No longer caching JSON array; strictly using fallback.
            }
            
            var sLengthMs:Float = state.currentSongLengthMs;
            if (sLengthMs <= 0) isCutscene = true;
            
            if (_nativeSubs != null) {
                var snd = _nativeSubs?.assignedSound;
                if (snd != null) {
                    var sTime = snd?.time;
                    if (sTime != null) currentSubsTime = sTime;
                    
                    var sndLen = snd?.length;
                    if (sndLen != null && sLengthMs > 0) {
                        var diffVal = Math.abs(Std.parseFloat(Std.string(sndLen)) - sLengthMs);
                        if (diffVal > 5000) {
                            isCutscene = true;
                        }
                    }
                } else if (Conductor.instance != null) {
                    currentSubsTime = Conductor.instance.songPosition;
                }
            } else if (Conductor.instance != null) {
                currentSubsTime = Conductor.instance.songPosition;
            }

            if (currentSubsTime < 0) isCutscene = true;

            // JSON reading block completely removed in favor of native fallback logic.
            
            if (rawTargetText == "" && _nativeTextObj != null) {
                var fallbackText = _nativeTextObj?.text;
                var fallbackHtml = _nativeTextObj?.htmlText;
                
                if (fallbackText != null && Std.string(fallbackText) != "" && Std.string(fallbackText) != "null") {
                    rawTargetText = Std.string(fallbackText);

                } else if (fallbackHtml != null && Std.string(fallbackHtml) != "" && Std.string(fallbackHtml) != "null") {
                    rawTargetText = Std.string(fallbackHtml);

                }
            }
        }

        if (rawTargetText == lastRawText) {
            return;
        }
        

        
        var isAppend:Bool = false;
        var prevPlainLen = cachedPlainText.length;
        
        if (lastRawText != "" && rawTargetText.indexOf(lastRawText) == 0 && rawTargetText.length > lastRawText.length) {
            isAppend = true;
        }
        
        lastRawText = rawTargetText;

        var displayFont:String = cachedFont;
        var displaySize:Int = defaultFontSize;
        var displayColor:Int = 0xFFFFFFFF;
        var htmlTextToProcess:String = rawTargetText;

        if (htmlTextToProcess != "" && htmlTextToProcess != "null") {
            var sizeIdx = htmlTextToProcess.indexOf("size=\"");
            if (sizeIdx != -1) {
                var valEnd = htmlTextToProcess.indexOf("\"", sizeIdx + 6);
                if (valEnd != -1) {
                    var sizeStr = StringTools.replace(htmlTextToProcess.substring(sizeIdx + 6, valEnd), "px", "");
                    var pSize = Std.parseInt(sizeStr);
                    if (pSize != null) displaySize = pSize;
                }
            }
            var faceIdx = htmlTextToProcess.indexOf("face=\"");
            if (faceIdx != -1) {
                var valEnd = htmlTextToProcess.indexOf("\"", faceIdx + 6);
                if (valEnd != -1) displayFont = htmlTextToProcess.substring(faceIdx + 6, valEnd);
            }
        }
        
        var shouldShow = (htmlTextToProcess != "" && htmlTextToProcess != "null");

        if (shouldShow) {
            subText.setFormat(displayFont, displaySize, displayColor, "center", FlxTextBorderStyle.OUTLINE, 0xFF000000);
            subText.borderSize = 1.5;
            
            compileHTML(htmlTextToProcess, displayColor);
            
            updateTextDisplay(cachedPlainText.length);
            var realHeight = subText.height;

            var targetX:Float = 0; 
            var targetY:Float = (posType == "Top") ? topY_Normal : (FlxG.height - realHeight - bottomY_Offset);
            
            var useKaraoke:Bool = smartKaraoke && !isCutscene;

            if (useKaraoke) {
                var startIdx:Int = isAppend ? prevPlainLen : 0;
                var endIdx:Int = cachedPlainText.length;
                var durK:Float = 0.35;
                // No exact timing available when using fallback, use smart dynamic karaoke
                    var stepSecs:Float = 0.15;
                    if (Conductor.instance != null && Conductor.instance.stepCrochet > 0) {
                        stepSecs = Conductor.instance.stepCrochet / 1000.0;
                    }
                    if (!isShowing) {
                        durK = Math.min(endIdx * (stepSecs * 0.35), stepSecs * 16); 
                    } else if (isAppend) {
                        durK = Math.min((endIdx - startIdx) * (stepSecs * 0.25), stepSecs * 8); 
                    } else {
                        durK = Math.min(endIdx * (stepSecs * 0.3), stepSecs * 12);
                    }
                


                updateTextDisplay(startIdx);
                
                if (karaokeTween != null) {
                    karaokeTween.cancel();
                    karaokeTween = null;
                }
                
                lastKaraokeLen = -1;
                karaokeTween = FlxTween.num(startIdx, endIdx, durK, {
                    ease: FlxEase.sineOut, 
                    onComplete: function(t:FlxTween) {
                        if (subText != null && subText.exists) updateTextDisplay(cachedPlainText.length);
                    }
                }, function(v:Float) {
                    var currentLen = Math.ceil(v);
                    if (currentLen != lastKaraokeLen) {
                        lastKaraokeLen = currentLen;
                        if (subText != null && subText.exists) updateTextDisplay(currentLen);
                    }
                });
            } else {
                if (karaokeTween != null) {
                    karaokeTween.cancel();
                    karaokeTween = null;
                }
                updateTextDisplay(cachedPlainText.length);
            }
            
            if (currentTween != null) { currentTween.cancel(); currentTween = null; }
            if (scaleTween != null) { scaleTween.cancel(); scaleTween = null; }
            subText.scale.set(1, 1);
            
            if (animType == "Slide") {
                    var dur:Float = 0.35;
                    if (!isShowing) {
                        subText.x = -80; 
                        subText.alpha = 0;
                        dur = 0.35;
                    } else if (isAppend) {
                        subText.x = targetX; 
                        subText.alpha = 1;
                        dur = 0.01;
                    } else {
                        subText.x = -50;
                        subText.alpha = 0;
                        dur = 0.2;
                    }
                    subText.y = targetY; 
                    subText.visible = true;
                    isShowing = true;
                    currentTween = FlxTween.tween(subText, {x: targetX, alpha: 1}, dur, {ease: FlxEase.expoOut});
                    
                } else if (animType == "Fade") {
                    var dur:Float = 0.35;
                    if (!isShowing) {
                        subText.x = targetX;
                        subText.alpha = 0;
                        dur = 0.35;
                    } else if (isAppend) {
                        subText.x = targetX; 
                        subText.alpha = 1;
                        dur = 0.01;
                    } else {
                        subText.x = targetX;
                        subText.alpha = 0;
                        dur = 0.2;
                    }
                    subText.y = targetY;
                    subText.visible = true;
                    isShowing = true;
                    currentTween = FlxTween.tween(subText, {x: targetX, alpha: 1}, dur, {ease: FlxEase.quadOut});
                    
                } else if (animType == "Vertical") {
                    var dur:Float = 0.35;
                    var smallOffset:Float = (posType == "Top") ? -40 : 40;
                    var edgeY:Float = (posType == "Top") ? -realHeight - 20 : FlxG.height + 20;
                    var easeF:Dynamic = FlxEase.expoOut;
                    
                    if (!isShowing) {
                        subText.x = targetX;
                        subText.y = edgeY; 
                        subText.alpha = 0;
                        dur = 0.35;
                    } else if (isAppend) {
                        subText.x = targetX; 
                        subText.y = targetY; 
                        subText.alpha = 1;
                        dur = 0.01;
                        easeF = FlxEase.expoOut;
                    } else {
                        subText.x = targetX;
                        subText.y = targetY + smallOffset; 
                        subText.alpha = 0;
                        dur = 0.2;
                    }
                    subText.visible = true;
                    isShowing = true;
                    currentTween = FlxTween.tween(subText, {x: targetX, y: targetY, alpha: 1}, dur, {ease: easeF});
                    
                } else if (animType == "Zoom") {
                    var dur:Float = 0.35;
                    if (!isShowing) {
                        subText.x = targetX;
                        subText.scale.set(0.1, 0.1); 
                        subText.alpha = 0;
                        dur = 0.35;
                    } else if (isAppend) {
                        subText.x = targetX + 15; 
                        subText.scale.set(1.15, 1.15); 
                        subText.alpha = 0.7;
                        dur = 0.15;
                    } else {
                        subText.x = targetX;
                        subText.scale.set(0.6, 0.6); 
                        subText.alpha = 0;
                        dur = 0.2;
                    }
                    subText.y = targetY;
                    subText.visible = true;
                    isShowing = true;
                    scaleTween = FlxTween.tween(subText.scale, {x: 1, y: 1}, dur, {ease: FlxEase.backOut});
                    currentTween = FlxTween.tween(subText, {x: targetX, alpha: 1}, dur, {ease: FlxEase.expoOut});
                    
                } else {
                    subText.x = targetX;
                    subText.y = targetY;
                    subText.alpha = 1;
                    subText.visible = true;
                    isShowing = true;
                }
        } else if (isShowing) {
            lastRawText = ""; 
            cancelAnimTweens();
            
            if (animType == "Slide") {
                    currentTween = FlxTween.tween(subText, {x: 80, alpha: 0}, 0.3, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) {
                        if (subText != null) subText.visible = false; isShowing = false;
                    }});
                } else if (animType == "Fade") {
                    currentTween = FlxTween.tween(subText, {alpha: 0}, 0.3, {ease: FlxEase.quadIn, onComplete: function(t:FlxTween) {
                        if (subText != null) subText.visible = false; isShowing = false;
                    }});
                } else if (animType == "Vertical") {
                    var edgeY:Float = (posType == "Top") ? -subText.height - 20 : FlxG.height + 20;
                    currentTween = FlxTween.tween(subText, {y: edgeY, alpha: 0}, 0.3, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) {
                        if (subText != null) subText.visible = false; isShowing = false;
                    }});
                } else if (animType == "Zoom") {
                    scaleTween = FlxTween.tween(subText.scale, {x: 0.1, y: 0.1}, 0.3, {ease: FlxEase.backIn});
                    currentTween = FlxTween.tween(subText, {alpha: 0}, 0.3, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) {
                        if (subText != null) {
                            subText.visible = false;
                            subText.scale.set(1, 1); 
                        }
                        isShowing = false;
                    }});
                } else {
                    var baseTargetY:Float = (posType == "Top") ? topY_Normal : (FlxG.height - subText.height - bottomY_Offset);
                    var endY:Float = (posType == "Top") ? baseTargetY - 20 : baseTargetY + 20;
                    
                    currentTween = FlxTween.tween(subText, {y: endY, alpha: 0}, 0.25, {onComplete: function(t:FlxTween) {
                        if (subText != null) subText.visible = false; isShowing = false;
                    }});
                }
        }
    }
    
    override public function destroy() {
        if (subText != null) subText.destroy();
        subText = null;
        
        if (karaokeTween != null) karaokeTween.cancel();
        karaokeTween = null;

        cachedFormats = [];
        
        super.destroy();
    }
}
