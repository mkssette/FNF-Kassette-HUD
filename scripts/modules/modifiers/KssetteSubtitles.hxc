package kassettehud.util;

/**
 * KssetteSubtitles
 *
 * Renders synchronized song lyrics (subtitles) during gameplay and in
 * the options menu preview. Supports karaoke-style formatting and smart
 * mode that highlights lines based on who is currently singing.
 *
 * Subtitle data format:
 *   The module reads from "data/songs/{songId}/subtitles.json", which
 *   should contain an array of entries:
 *     { "text": "...", "time": 1234, "duration": 2000, "character": "bf" }
 *   HTML color/style tags (e.g. <font color="#FF0000">, <b>, <i>) are
 *   parsed for karaoke reveal effects.
 *
 * When no subtitle file is available, the module falls back to a built-in
 * "trivia" array with fun FNF facts displayed at random intervals.
 *
 * Animation modes (kssette_subtitles_anim):
 *   - "Slide" - Slides in from below (or above) and fades out.
 *   - "Fade"  - Fades in/out only.
 *   - "Off"   - Appears/disappears instantly.
 *
 * Smart karaoke (kssette_smart_karaoke):
 *   When enabled, only lines belonging to the currently singing character
 *   are highlighted; the other side is shown at reduced opacity.
 *
 * Settings managed:
 *   - kssette_subtitles_anim: "Slide" | "Fade" | "Off"
 *   - kssette_subtitles_pos:  "Bottom" | "Top" | "Center"
 *   - kssette_smart_karaoke:  "On" | "Off"
 *
 * Dependencies:
 *   - KssetteApi.getKssValue()  - reads option values
 *   - KssetteApi.getHudFont()   - HUD font string
 *   - Subtitle JSON files in data/songs/{id}/subtitles.json
 */

import funkin.modding.module.Module;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import kassettehud.util.KssetteFontManager;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import funkin.util.ReflectUtil;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxTextFormat;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.Conductor;
import Math;
import Std;
import StringTools;
import flixel.util.FlxColor;

class KssetteSubtitles extends KHUDModifier {
    
    /** Default font size for subtitle text. */
    var defaultFontSize:Int = 24;
    /** Y position of subtitles when placed at the top of the screen. */
    var topY_Normal:Float = 190;
    /** Vertical offset from the bottom edge when placed at the bottom. */
    var bottomY_Offset:Float = 190;

    var subtitleGroup:flixel.group.FlxSpriteGroup;
    /** HUD font name read from KssetteApi.getHudFont(). */
    var cachedFont:String = "VCR OSD Mono";
    /** Active animation style: "Slide", "Fade", or "Off". */
    var animType:String = "Slide";
    /** Current position mode: "Bottom", "Top", or "Center". */
    var posType:String = "Bottom";
    /** Whether smart karaoke highlighting is active. */
    var smartKaraoke:Bool = false;
    
    /** Last raw subtitle text shown; guards against redundant updates. */
    var lastRawText:String = "";
    /** Active FlxTween for the main show/hide animation. */
    var currentTween:FlxTween = null;
    /** Active FlxTween for the karaoke reveal effect. */
    var karaokeTween:FlxTween = null;
    /** Active FlxTween for the scale pulse effect. */
    var scaleTween:FlxTween = null;
    /** Whether subtitles are currently visible on screen. */
    var isShowing:Bool = false;
    
    var targetPreviewTick:Int = 0;
    
    /** The primary FlxText node that displays subtitle content. */
    public var subText:FlxText;

    // --- Native subtitle system bridge ---
    var _nativeSubs:Dynamic = null;
    var _nativeBg:Dynamic = null;
    var _nativeTextObj:Dynamic = null;
    
    /** Reference to the KssttLSubtitles compatibility module, if present. */
    var kssttlModule:Dynamic = null;
    /** True once we have checked for the KssttL module (avoids repeated lookups). */
    var checkedKssttl:Bool = false;
    /** The camera that subtitles were last assigned to; used to detect camera changes. */
    var lastTargetCam:Dynamic = null;
    
    /** True when rendering in the options menu preview instead of gameplay. */

    /** Camera to render into during preview mode. */
    public var previewCam:FlxCamera = null;
    /** Timer for the preview demo cycle (cycles through subtitle in/out states). */
    var previewTimer:Float = 0.0;
    /** Per-frame throttle timer (~120Hz gate). */
    var updateTimer:Float = 0.0;
    /** Current animation state index for the preview demo. */
    var previewState:Int = 0;

    /** Cached plain text after stripping HTML from the current subtitle entry. */
    var cachedPlainText:String = "";
    /** Cached format ranges extracted from HTML tags (color, bold, italic). */
    var cachedFormats:Array<Dynamic> = [];
    /** Last karaoke visible-length applied; avoids redundant format re-application. */
    var lastKaraokeLen:Int = -1;

