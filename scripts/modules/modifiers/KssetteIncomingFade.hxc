package kassettehud.util;

import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KHUDModifier;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import funkin.Conductor;
import funkin.Preferences;
import Std;
import funkin.modding.events.ScriptEvent;

class KssetteIncomingFade extends KHUDModifier {
    var _enabled:Bool = false;
    var fades:Array<FlxSprite> = [];
    var pNotes:Array<Array<Float>> = [[], [], [], []];
    var curIdx:Array<Int> = [0, 0, 0, 0];
    
    var colors:Array<Int> = [0xFFC24B99, 0xFF00FFFF, 0xFF12FA05, 0xFFF9393F];

    public function new() {
        super("KssetteIncomingFade");
    }
    
    function updateSettings() {
        var raw = getSetting("kssette_incoming_fade");
        trace("KssetteIncomingFade: raw setting value: " + raw);
        // Force enabled to true for testing so the user can see the effect
        _enabled = true; 
    }
    
    override public function onResume(event:ScriptEvent) {
        updateSettings();
    }

    override public function onCountdownStart(event:Dynamic) {
        updateSettings();
        trace("KssetteIncomingFade: onCountdownStart. Enabled? " + _enabled);
        
        if (!_enabled) return;

        var state = playState;
        if (state == null || state.currentChart == null) {
            trace("KssetteIncomingFade: playState or chart is null!");
            return;
        }
        
        // Build the note timing queues
        pNotes = [[], [], [], []];
        curIdx = [0, 0, 0, 0];
        
        if (state.currentChart != null && state.currentChart.notes != null) {
            var notesArray:Array<Dynamic> = state.currentChart.notes;
            var len:Int = notesArray.length;
            
            for (i in 0...len) {
                var note = notesArray[i];
                if (note == null) continue;
                
                var isPlayer:Bool = false;
                var dir:Int = -1;
                try {
                    var strumIdx:Dynamic = note.getStrumlineIndex();
                    isPlayer = (strumIdx == 1);
                    dir = note.getDirection();
                } catch(e:Dynamic) {}
                
                if (isPlayer && dir >= 0 && dir < 4) {
                    var noteTime:Float = (note.time != null) ? note.time : -1.0;
                    if (noteTime >= 0) {
                        pNotes[dir].push(noteTime);
                    }
                }
            }
            trace("KssetteIncomingFade: Notes queued -> " + pNotes[0].length + ", " + pNotes[1].length + ", " + pNotes[2].length + ", " + pNotes[3].length);
            
            // Sort to ensure chronologically correct
            for (dir in 0...4) {
                pNotes[dir].sort(function(a, b) {
                    if (a < b) return -1;
                    if (a > b) return 1;
                    return 0;
                });
            }
        }

        // Cleanup old fades if re-entering
        for (f in fades) {
            if (f != null) {
                state.remove(f);
                f.destroy();
            }
        }
        fades = [];
        // We will create the gradients in onUpdate to ensure playerStrumline is fully populated.
        // Some songs (like erect remixes) might delay strumline creation.
    }

    override public function onUpdate(event:Dynamic) {
        if (!getSetting("kssette_incoming_fade")) {
            for (f in fades) {
                if (f != null) f.visible = false;
            }
            return;
        }
        
        var state = PlayState.instance;
        if (state == null) return;
        
        var downscroll = Preferences.downscroll;
        
        // Deferred initialization
        if (fades.length == 0 && state.playerStrumline != null && state.playerStrumline.strumlineNotes != null && state.playerStrumline.strumlineNotes.group != null && state.playerStrumline.strumlineNotes.group.members != null) {
            for (i in 0...4) {
                var strum = state.playerStrumline.strumlineNotes.group.members[i];
                if (strum == null) continue;
                
                var c = colors[i];
                var transparentC = c & 0x00FFFFFF;
                
                var w = strum.width > 0 ? Std.int(strum.width) : 112;
                var h = 250;
                // Generar degradado dinámico usando la GPU
                var grad = new FlxSprite().makeGraphic(1, 2, 0x00FFFFFF);
                grad.graphic.bitmap.setPixel32(0, 0, 0xFFFFFFFF); // Sólido
                grad.graphic.bitmap.setPixel32(0, 1, 0x00FFFFFF); // Transparente
                
                grad.antialiasing = true;
                grad.setGraphicSize(w, h);
                grad.updateHitbox();
                
                // Determinamos físicamente dónde está el receptor en lugar de confiar en Preferences
                var isReceptorAtBottom = strum.y > FlxG.height / 2;
                
                // Si el receptor está abajo (downscroll), spawnea arriba -> parte sólida arriba (flipY=false)
                // Si el receptor está arriba (upscroll), spawnea abajo -> parte sólida abajo (flipY=true)
                grad.flipY = !isReceptorAtBottom;
                
                grad.color = c;
                
                if (grad == null) continue;
                
                grad.alpha = 0.6;
                grad.visible = false;
                grad.cameras = [state.camHUD];
                fades.push(grad);
                
                // Lo metemos en el mismo grupo que las flechas para que compartan el mismo espacio de coordenadas X.
                state.playerStrumline.insert(0, grad);
                
                trace("KssetteIncomingFade: grad " + i + " initialized in onUpdate.");
            }
        }
        
        if (Conductor.instance == null) return;
        
        var pos = Conductor.instance.songPosition;
        var state = playState;
        var downscroll = Preferences.downscroll;
        
        for (dir in 0...4) {
            var arr = pNotes[dir];
            var idx = curIdx[dir];
            
            // Dynamically align to strumline
            if (state != null && state.playerStrumline != null && state.playerStrumline.members != null) {
                var strum = state.playerStrumline.members[dir];
                var grad = fades[dir];
                if (strum != null && grad != null) {
                    // Cero matemáticas para X. Al estar en el mismo grupo, comparten el mismo X.
                    grad.x = strum.x;
                    
                    var isReceptorAtBottom = strum.y > FlxG.height / 2;
                    
                    if (isReceptorAtBottom) {
                        grad.y = -state.playerStrumline.y; // Top of screen
                    } else {
                        grad.y = (FlxG.height - grad.height) - state.playerStrumline.y; // Bottom of screen
                    }
                }
            }
            
            // Fast forward past notes we've already passed
            while (idx < arr.length && arr[idx] != null && arr[idx] < pos - 50) {
                idx++;
            }
            curIdx[dir] = idx;
            
            if (idx < arr.length && arr[idx] != null) {
                var dist = arr[idx] - pos;
                // El usuario quiere que simplemente aparezca de forma estática 4 segundos antes.
                if (dist <= 4000 && dist >= -100) {
                    if (fades[dir] != null) {
                        fades[dir].visible = true;
                        fades[dir].alpha = 0.6;
                    }
                } else {
                    if (fades[dir] != null) fades[dir].visible = false;
                }
            } else {
                if (fades[dir] != null) fades[dir].visible = false;
            }
        }
    }
}
