package kassettehud.util;

import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KHUDModifier;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import funkin.Conductor;
import funkin.Preferences;
import Std;
import funkin.modding.events.ScriptEvent;
import flixel.group.FlxSpriteGroup;

class KssetteIncomingFade extends KHUDModifier {
    var _enabled:Bool = false;
    var fades:Array<FlxSprite> = [];
    var fadesGroup:Dynamic = null; // Group to hold fades in absolute coordinates
    
    var pNotes:Array<Array<Float>> = [[], [], [], []];
    var curIdx:Array<Int> = [0, 0, 0, 0];
    
    var colors:Array<Int> = [0xFFC24B99, 0xFF00FFFF, 0xFF12FA05, 0xFFF9393F];

    public function new() {
        super("KssetteIncomingFade");
    }
    
    function updateSettings() {
        var raw = getSetting("kssette_incoming_fade");
        trace("KssetteIncomingFade: raw setting value: " + raw);
        // Force enabled to true for testing so the user can see the effect
        _enabled = true; 
    }
    
    override public function onResume(event:ScriptEvent) {
        updateSettings();
    }

    override public function onCountdownStart(event:Dynamic) {
        updateSettings();
        trace("KssetteIncomingFade: onCountdownStart. Enabled? " + _enabled);
        
        if (!_enabled) return;

        var state = PlayState.instance;
        if (state == null || state.currentChart == null) {
            trace("KssetteIncomingFade: playState or chart is null!");
            return;
        }
        
        pNotes = [[], [], [], []];
        curIdx = [0, 0, 0, 0];
        
        if (state.currentChart != null && state.currentChart.notes != null) {
            var notesArray:Array<Dynamic> = state.currentChart.notes;
            var len:Int = notesArray.length;
            
            for (i in 0...len) {
                var note = notesArray[i];
                if (note == null) continue;
                
                var isPlayer:Bool = false;
                var dir:Int = -1;
                
                // Meticulous parsing of direction and mustHit using safe navigation
                var d = (note?.data != null) ? note.data : ((note?.d != null) ? note.d : -1);
                var dVal = Std.parseInt(Std.string(d));
                
                if (dVal >= 0 && dVal < 4) isPlayer = true;
                
                dir = dVal % 4;
                
                if (isPlayer && dir >= 0 && dir < 4) {
                    var noteTime:Float = -1.0;
                    var rawTime = (note?.time != null) ? note.time : ((note?.t != null) ? note.t : null);
                    if (rawTime != null) noteTime = Std.parseFloat(Std.string(rawTime));
                    
                    var noteLen:Float = 0.0;
                    var rawLen = (note?.length != null) ? note.length : ((note?.l != null) ? note.l : null);
                    if (rawLen != null) noteLen = Std.parseFloat(Std.string(rawLen));
                    
                    if (noteTime >= 0) {
                        pNotes[dir].push({start: noteTime, end: noteTime + noteLen});
                    }
                }
            }
            
            for (dir in 0...4) {
                pNotes[dir].sort(function(a, b) {
                    if (a.start < b.start) return -1;
                    if (a.start > b.start) return 1;
                    return 0;
                });
            }
        }

        for (f in fades) {
            if (f != null) {
                f.destroy();
            }
        }
        fades = [];
        if (fadesGroup != null) {
            fadesGroup.destroy();
            fadesGroup = null;
        }
    }

    override public function onUpdate(event:Dynamic) {
        if (!getSetting("kssette_incoming_fade")) {
            for (f in fades) {
                if (f != null) f.visible = false;
            }
            return;
        }
        
        var state = PlayState.instance;
        if (state == null) return;
        
        var pos = (Conductor.instance != null) ? Conductor.instance.songPosition : 0;
        var downscroll = Preferences.downscroll;

        if (fades.length == 0 && state.playerStrumline != null && state.playerStrumline.strumlineNotes != null) {
            fadesGroup = new FlxSpriteGroup();
            var strumIndex = state.members.indexOf(state.playerStrumline);
            if (strumIndex >= 0) {
                state.insert(strumIndex, fadesGroup);
            } else {
                state.add(fadesGroup);
            }
            
            var colors = [0xFFC24B99, 0xFF00FFFF, 0xFF12FA05, 0xFFF9393F];
            for (i in 0...4) {
                var c = colors[i];
                var r = (c >> 16) & 0xFF;
                var g = (c >> 8) & 0xFF;
                var b = c & 0xFF;
                
                var w = 112;
                var h = 250;
                
                var grad = new FlxSprite().makeGraphic(1, h, 0x00FFFFFF, false, "kssetteFade_" + i);
                
                var isDown = Preferences.downscroll;
                for (y in 0...h) {
                    var alpha = isDown ? Std.int(255 * (1.0 - (y / (h - 1)))) : Std.int(255 * (y / (h - 1)));
                    var color = (alpha << 24) | (r << 16) | (g << 8) | b;
                    grad.graphic.bitmap.setPixel32(0, y, color);
                }
                
                grad.antialiasing = true;
                grad.setGraphicSize(w, h);
                grad.updateHitbox();
                
                grad.visible = false;
                grad.cameras = [state.camHUD];
                fades.push(grad);
                fadesGroup.add(grad);
            }
            fadesGroup.cameras = [state.camHUD];
        }
        
        for (dir in 0...4) {
            var arr = pNotes[dir];
            var idx = curIdx[dir];
            
            if (state != null && state.playerStrumline != null && state.playerStrumline.strumlineNotes != null && state.playerStrumline.strumlineNotes.members != null) {
                var strum = state.playerStrumline.strumlineNotes.members[dir];
                var grad = fades[dir];
                if (strum != null && grad != null) {
                    var sPos = strum.getScreenPosition(null, state.camHUD);
                    var centerX = sPos.x + (strum.width * 0.5);
                    grad.x = centerX - (grad.width * 0.5);
                    sPos.put();
                    
                    if (downscroll) {
                        grad.y = 0;
                    } else {
                        grad.y = FlxG.height - grad.height;
                    }
                }
            }
            
            while (idx < arr.length && arr[idx] != null && arr[idx].start < pos) {
                idx++;
            }
            curIdx[dir] = idx;
            
            if (idx < arr.length && arr[idx] != null) {
                var renderDistance:Float = 1600;
                try {
                    if (state.playerStrumline != null) {
                        var scrollSpeed = state.playerStrumline.scrollSpeed;
                        if (scrollSpeed == null || scrollSpeed <= 0) scrollSpeed = 1.0;
                        renderDistance = 720 / 0.45 / (scrollSpeed < 1 ? scrollSpeed : 1);
                    }
                } catch(e:Dynamic) {
                    if (state.currentChart != null) {
                        try {
                            var scrollSpeed = state.currentChart.scrollSpeed;
                            if (scrollSpeed == null || scrollSpeed <= 0) scrollSpeed = 1.0;
                            renderDistance = 720 / 0.45 / (scrollSpeed < 1 ? scrollSpeed : 1);
                        } catch(e2:Dynamic) {
                            renderDistance = 1600;
                        }
                    } else {
                        renderDistance = 1600;
                    }
                }
                
                var shouldBeVisible = false;
                var k = idx;
                while (k < arr.length && arr[k] != null) {
                    var kDist = arr[k].start - pos;
                    if (kDist > renderDistance + 1500) {
                        break;
                    }
                    if (kDist <= renderDistance + 1500 && kDist > renderDistance) {
                        shouldBeVisible = true;
                        break;
                    }
                    k++;
                }
                
                var targetAlpha:Float = shouldBeVisible ? 0.6 : 0.0;
                
                if (fades[dir] != null) {
                    fades[dir].visible = true;
                    
                    var fadeSpeed:Float = 4.0;
                    if (fades[dir].alpha < targetAlpha) {
                        fades[dir].alpha += fadeSpeed * FlxG.elapsed;
                        if (fades[dir].alpha > targetAlpha) fades[dir].alpha = targetAlpha;
                    } else if (fades[dir].alpha > targetAlpha) {
                        fades[dir].alpha -= fadeSpeed * FlxG.elapsed;
                        if (fades[dir].alpha < targetAlpha) fades[dir].alpha = targetAlpha;
                    }
                    
                    if (fades[dir].alpha <= 0) {
                        fades[dir].visible = false;
                    }
                }
            } else {
                if (fades[dir] != null) {
                    var fadeSpeed:Float = 4.0;
                    fades[dir].alpha -= fadeSpeed * FlxG.elapsed;
                    if (fades[dir].alpha <= 0) {
                        fades[dir].alpha = 0;
                        fades[dir].visible = false;
                    }
                }
            }
        }
    }
}
