package kassettehud.util;

import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KHUDModifier;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import funkin.Conductor;
import Std;
import funkin.modding.events.ScriptEvent;
import flixel.group.FlxSpriteGroup;

class KssetteIncomingFade extends KHUDModifier {
	var _enabled:Bool = false;
	var fades:Array<FlxSprite> = [];
	var fadesGroup:Dynamic = null; // Group to hold fades in absolute coordinates
	var curIdx:Array<Int> = [0, 0, 0, 0];
	var cachedScreenEntry:Float = 1500;
	var cachedWarningEnd:Float = 2000;

	var colors:Array<Int> = [0xFFC24B99, 0xFF00FFFF, 0xFF12FA05, 0xFFF9393F];
	var _cDownscroll:Bool = false;

	/**
	 * Initializes the KssetteIncomingFade modifier.
	 * This modifier creates a dynamic color gradient at the edge of the screen (top or bottom)
	 * to warn the player of incoming notes just before they enter the physical screen space.
	 */
	public function new() {
		super("KssetteIncomingFade");
        
	}

	/**
	 * Reads the user's preference to enable or disable the incoming fade effect,
	 * and caches the current downscroll state to determine where to draw the gradients.
	 */
	function updateSettings() {
		var raw = getSetting("kssette_incoming_fade");
		_enabled = (raw == true);
		
		_cDownscroll = false;
		if (KssetteOptionsManager.instance != null) {
			_cDownscroll = KssetteOptionsManager.instance.getDownscroll();
		}
	}

	/**
	 * Triggered when returning to the game from the pause menu.
	 * Forces a settings refresh so changes made while paused take effect immediately.
	 *
	 * @param event The script event indicating the game resumed.
	 */
	override public function onResume(event:ScriptEvent) {
		updateSettings();
	}

	/**
	 * Triggered right before the 3-2-1 countdown begins.
	 * Calculates the precise physical entry time of notes into the screen bounds based 
	 * on the chart's native scroll speed. This defines exactly when the warning fade 
	 * should appear and disappear. Also cleans up any existing sprites from previous runs.
	 *
	 * @param event The script event data regarding the countdown.
	 */
	override public function onCountdownStart(event:Dynamic) {
		updateSettings();
		trace("KssetteIncomingFade: onCountdownStart. Enabled? " + _enabled);

		if (!_enabled)
			return;

		curIdx = [0, 0, 0, 0];

		var state = PlayState.instance;
		if (state == null || state.currentChart == null) {
			trace("KssetteIncomingFade: playState or chart is null!");
			return;
		}

		cachedScreenEntry = 1500;

		if (state.currentChart != null && state.currentChart.notes != null) {
			var scrollSpeed:Float = state.currentChart.scrollSpeed;
			if (scrollSpeed <= 0)
				scrollSpeed = 1.0;

			var ps = state.playerStrumline != null ? state.playerStrumline.scrollSpeed : null;
			if (ps != null && ps > 0)
				scrollSpeed = ps;

			// Calculate EXACT time the note physically enters the 720p screen (assuming ~670px travel distance)
			cachedScreenEntry = 670.0 / (0.45 * scrollSpeed);
			cachedWarningEnd = cachedScreenEntry + 500;
		}

		for (f in fades) {
			if (f != null) {
				f.destroy();
			}
		}
		fades = [];
		if (fadesGroup != null) {
			fadesGroup.destroy();
			fadesGroup = null;
		}
	}
	/**
	 * Per-frame update loop.
	 * Responsible for generating the gradient sprites (fades) on the fly if they don't exist,
	 * placing them directly behind the player's strumline columns, and interpolating their 
	 * alpha opacity based on the proximity of the very next incoming note calculated from `ChartDatahunter`.
	 *
	 * @param event The update script event containing delta time.
	 */
	override public function onUpdate(event:Dynamic) {
		if (!_enabled) {
			for (f in fades) {
				if (f != null)
					f.visible = false;
			}
			return;
		}

		var state = PlayState.instance;
		if (state == null)
			return;

		var pos = (Conductor.instance != null) ? Conductor.instance.songPosition : 0;
		var downscroll = _cDownscroll;

		var elapsed = FlxG.elapsed;

		if (fades.length == 0 && state.playerStrumline != null && state.playerStrumline.strumlineNotes != null) {
			fadesGroup = new FlxSpriteGroup();
			var strumIndex = state.members.indexOf(state.playerStrumline);
			if (strumIndex >= 0) {
				state.insert(strumIndex, fadesGroup);
			} else {
				state.add(fadesGroup);
			}

			var colors = [0xFFC24B99, 0xFF00FFFF, 0xFF12FA05, 0xFFF9393F];
			for (i in 0...4) {
				var c = colors[i];
				var r = (c >> 16) & 0xFF;
				var g = (c >> 8) & 0xFF;
				var b = c & 0xFF;

				var w = 112;
				var h = 250;

				var grad = new FlxSprite().makeGraphic(1, h, 0x00FFFFFF, false, "kssetteFade_" + i);

				var isDown = downscroll;
				for (y in 0...h) {
					var alpha = isDown ? Std.int(255 * (1.0 - (y / (h - 1)))) : Std.int(255 * (y / (h - 1)));
					var color = (alpha << 24) | (r << 16) | (g << 8) | b;
					grad.graphic.bitmap.setPixel32(0, y, color);
				}

				grad.antialiasing = true;
				grad.setGraphicSize(w, h);
				grad.updateHitbox();

				grad.visible = false;
				grad.cameras = [state.camHUD];
				fades.push(grad);
				fadesGroup.add(grad);
			}
			fadesGroup.cameras = [state.camHUD];
		}

		var pStrumline = state.playerStrumline;
		var pMembers = (pStrumline != null && pStrumline.strumlineNotes != null) ? pStrumline.strumlineNotes.members : null;

		for (dir in 0...4) {
			var arr = null;
			if (KassetteHUDDatahunter.chartData != null && KassetteHUDDatahunter.chartData.incomingFadeNotes != null && dir < KassetteHUDDatahunter.chartData.incomingFadeNotes.length) {
				arr = KassetteHUDDatahunter.chartData.incomingFadeNotes[dir];
			}
			var idx = curIdx[dir];

			if (arr == null) continue;

			if (pMembers != null && dir < pMembers.length) {
				var strum = pMembers[dir];
				var grad = fades[dir];
				if (strum != null && grad != null) {
					if (state.camHUD == null) continue;
					var centerX = strum.x + (strum.width * 0.5);
					grad.x = centerX - (grad.width * 0.5);

					if (downscroll) {
						grad.y = 0;
					} else {
						grad.y = FlxG.height - grad.height;
					}
				}
			}

			while (idx < arr.length && arr[idx] != null && arr[idx].start != null && arr[idx].start < pos) {
				idx++;
			}
			curIdx[dir] = idx;

			if (idx < arr.length && arr[idx] != null && arr[idx].start != null) {
				var shouldBeVisible = false;
				var k = idx;
				while (k < arr.length && arr[k] != null) {
					if (arr[k].start == null) {
						k++;
						continue;
					}
					var kDist = arr[k].start - pos;
					if (kDist > cachedWarningEnd) {
						break;
					}
					if (kDist <= cachedWarningEnd && kDist > cachedScreenEntry) {
						shouldBeVisible = true;
						break;
					}
					k++;
				}

				var targetAlpha:Float = shouldBeVisible ? 0.6 : 0.0;

				if (fades[dir] != null) {
					fades[dir].visible = true;

					var fadeSpeed:Float = 4.0;
					if (fades[dir].alpha < targetAlpha) {
						fades[dir].alpha += fadeSpeed * elapsed;
						if (fades[dir].alpha > targetAlpha)
							fades[dir].alpha = targetAlpha;
					} else if (fades[dir].alpha > targetAlpha) {
						fades[dir].alpha -= fadeSpeed * elapsed;
						if (fades[dir].alpha < targetAlpha)
							fades[dir].alpha = targetAlpha;
					}

					if (fades[dir].alpha <= 0) {
						fades[dir].visible = false;
					}
				}
			} else {
				if (fades[dir] != null) {
					var fadeSpeed:Float = 4.0;
					fades[dir].alpha -= fadeSpeed * elapsed;
					if (fades[dir].alpha <= 0) {
						fades[dir].alpha = 0;
						fades[dir].visible = false;
					}
				}
			}
		}
	}
}
