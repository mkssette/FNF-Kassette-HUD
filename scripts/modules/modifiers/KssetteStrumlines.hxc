package kassettehud.util;

/**
 * KssMiddlescroll
 *
 * Implements Middle Scroll positioning (player strumline centered on screen)
 * and provides several opponent note display modes for when the opponent
 * strumline would overlap with the player lane.
 *
 * Modes (kssette_middlescroll):
 *   - "Off"          - Disabled. Strumlines use normal FNF positioning.
 *   - "On"           - Middle scroll active; opponent notes shown as small
 *                      ghost notes on the player lane.
 *   - "P Style"      - Opponent receptors placed at the outer screen edges.
 *   - "Glass"        - Opponent notes overlaid transparently behind the player.
 *   - "Hidden Notes" - Opponent notes invisible (no receptors visible).
 *   - "Like Mobile"  - Opponent notes appear at the top of the screen.
 *
 * Additional settings:
 *   - kssette_hide_opponent:      Hides the entire opponent strumline.
 *   - kssette_opponent_opacity:   Sets opponent strumline transparency.
 *   - kssette_opponent_pos:       "Left" | "Right" - compact ghost note side.
 *   - kssette_opponent_bg:        Show strumline background panel for opponent.
 *   - kssette_mobile_opp_notes:   Show opponent notes when using Arrows layout.
 *
 * Note splash repositioning:
 *   Since opponent splashes spawn at the opponent's original x, they are
 *   repositioned every ~33ms (30fps) to follow the compact receptor positions.
 *
 * Dependencies:
 *   - KssetteApi.getKssValue()    - reads option values
 *   - KssetteApi.gammodPlayerSide - handles Gammod OPPOSITE/BOTH player sides
 *   - KssetteApi.isMobileMode     - mobile layout detection
 */

import flixel.FlxG;
import funkin.modding.module.Module;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import funkin.save.Save;
import funkin.modding.module.ModuleHandler;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.play.PlayState;
import funkin.play.notes.Strumline;
import funkin.util.Constants;
import funkin.mobile.input.ControlsHandler;
import funkin.ui.FullScreenScaleMode;
import Std;
import Math;
import StringTools;

class KssetteStrumlines extends KHUDModifier {
    /** Currently active mode string ("Off", "On", "P Style", "Glass", etc.). */
    var cachedMode:String = "Off";
    /** Cached opponent position preference ("Left" | "Right"). */
    var cachedOppPos:String = "Left";
    /** Whether to show the opponent strumline background panel. */
    var cachedOppBg:Bool = false;
    /** Whether to show opponent notes in Arrows-layout mobile mode. */
    var cachedMobileOppNotes:Bool = true;
    /** True after the first frame where we shift strumline positions. */
    var hasShifted:Bool = false;
    var originalScrollSpeeds:Array<Float> = [1, 1, 1, 1];
    /** Cached reference to the opponent strumline. */
    var cachedOppStrum:Dynamic = null;
    /** Cached reference to the opponent strumline receptor members array. */
    var cachedReceptors:Dynamic = null;
    /** Cached reference to the opponent noteSplashes FlxGroup. */
    var cachedSplashes:Dynamic = null;
    /** Whether the active note style has custom splash offsets. */
    var cachedHasSplashOffsets:Bool = false;
    /** X offset from the note style's splash offsets (used for repositioning). */
    var cachedSplashOffsetX:Float = 0.0;
    /** Timer that throttles splash repositioning to ~30fps. */
    var splashUpdateTimer:Float = 0.0;
    /** Last opponent strumline that received a nudge (prevents double-nudging). */
    var lastNudgedStrum:Dynamic = null;
    /** True after the player strumline has been positioned (per countdown start). */
    var pHasShifted:Bool = false;

    /** True when using Arrows control scheme on a device without external input. */
    var cachedIsArrows:Bool = false;
    /** True when the chart uses the "pixel" note style. */
    var cachedIsPixelStyle:Bool = false;
    /** True when running in mobile-like-PC layout mode. */
    var cachedIsMobPC:Bool = true;
    /** Cached screen cutout/notch size (computed once, then reused). */
    var cachedCutoutSize:Float = -1.0;
    var cachedShowTimeBar:Bool = false;
    var cachedTimeBarPos:String = "";
    /** Cached opponent opacity value (0.0 - 1.0). */
    var cachedOppOpacity:Float = 1.0;

    public function new() {
        super('KssetteStrumlines'); 
        elementType = "modifier";
    }

    /** Returns true if the Dynamic value represents an "on" state. */
    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    /**
     * Called at song start. Reads all middle scroll settings and performs the
     * initial strumline repositioning. Also caches the opponent strumline
     * reference and its note style splash offsets for use in onUpdate.
     *
     * Key operations:
     *   - Centers the player strumline horizontally (if mod is active).
     *   - Applies opponent mode (hidden/ghost/glass/p-style).
     *   - Compacts opponent receptors into a small cluster for ghost modes.
     *   - Adjusts opponent opacity.
     *   - Applies Arrow-layout nudge offsets for mobile-without-external-input.
     */
    override function onCountdownStart(event:ScriptEvent):Void {
        hasShifted = false;
        pHasShifted = false;
        cachedOppStrum = null;
        cachedReceptors = null;
        cachedSplashes = null;
        cachedHasSplashOffsets = false;
        cachedSplashOffsetX = 0.0;
        splashUpdateTimer = 0.0;
        cachedCutoutSize = -1.0;
        
        var isMobLayout = false;
        
        cachedShowTimeBar = getSetting("kssette_show_timebar") == true;
        cachedTimeBarPos = Std.string(getSetting("kssette_timebar_pos"));


        var rawMode:Dynamic = getSetting("kssette_middlescroll");
        if (rawMode == true) cachedMode = "On";
        else if (rawMode == false) cachedMode = "Off";
        else cachedMode = Std.string(rawMode);

        var rawHideOpp:Dynamic = getSetting("kssette_hide_opponent");
        var hideOpp:Bool = isOn(rawHideOpp);

        var rawOppOp:Dynamic = getSetting("kssette_opponent_opacity");
        var oppOpacity:Float = 1.0;
        if (rawOppOp != null) {
            var valStr = StringTools.replace(Std.string(rawOppOp), "%", "");
            var valNum = Std.parseFloat(valStr);
            if (!Math.isNaN(valNum)) oppOpacity = valNum / 100.0;
        }
        cachedOppOpacity = oppOpacity;

        cachedOppPos = Std.string(getSetting("kssette_opponent_pos"));
        var rawOppBg:Dynamic = getSetting("kssette_opponent_bg");
        cachedOppBg = isOn(rawOppBg);
        
        var rawMobOppNotes:Dynamic = getSetting("kssette_mobile_opp_notes");
        cachedMobileOppNotes = isOn(rawMobOppNotes);
        
        var isMob = false;
        var isMobPC = false;
        
        var optManager = KssetteOptionsManager.instance;
        if (optManager != null) {
            isMob = optManager.isMobileMode == true;
            isMobPC = optManager.isMobileLikePC() == true;
        } else {
            isMob = FlxG.onMobile;
        }
        cachedIsMobPC = isMobPC;
        
        if (isMob && !isMobPC) isMobLayout = true;

        var state = PlayState.instance;
        if (state == null) return;

        cachedIsArrows = false;
        if (isMobLayout) {
            var ctrlScheme = "Arrows"; // Fallback like Preferences.hx
            if (Save.instance != null && Save.instance.mobileOptions != null) {
                if (Save.instance.mobileOptions.controlsScheme != null) {
                    ctrlScheme = Std.string(Save.instance.mobileOptions.controlsScheme);
                }
            }
            
            if (ctrlScheme == 'Arrows') {
                cachedIsArrows = true; // Use true, because we want it to work on PC as well when testing layouts
            }
        }

        cachedIsPixelStyle = false;
        if (state.currentChart != null && state.currentChart.noteStyle == 'pixel') {
            cachedIsPixelStyle = true;
        }

        var myStrum = state.playerStrumline;
        var oppStrum = state.opponentStrumline;

        var isArrows = cachedIsArrows;
        var isModActive = (cachedMode != "Off" && cachedMode != "null");

        var pRealWidth:Float = 0;
        var pStartX:Float = 0;
        var padding:Float = 12;

        if (myStrum != null) {
            pStartX = myStrum.x;
            var pNotes = myStrum.strumlineNotes.members;
            
            if (pNotes != null && pNotes.length > 0) {
                var firstNote = pNotes[0];
                var lastNote = pNotes[pNotes.length - 1];
                pRealWidth = (lastNote.x + lastNote.width) - firstNote.x;
                pStartX = firstNote.x;
            }
            
            if (pRealWidth <= 0) pRealWidth = myStrum.width;
            if (pRealWidth <= 0) pRealWidth = 448; 
            
            myStrum.zIndex = KassetteHUDElement.Z_STRUM_NOTES;

            var pBg = myStrum.background;
            if (pBg != null) {
                var fWidth:Float = pBg.frameWidth;
                if (fWidth <= 0) fWidth = pBg.width;
                if (fWidth > 0) {
                    pBg.scale.x = (pRealWidth + padding * 2) / fWidth;
                    pBg.updateHitbox();
                    pBg.x = pStartX - padding;
                    pBg.zIndex = KassetteHUDElement.Z_STRUM_BACKGROUNDS;
                    
                    myStrum.remove(pBg, true);
                    state.remove(pBg, true);
                    if (state.camHUD != null) pBg.cameras = [state.camHUD];
                    state.add(pBg);
                }
            }
        }

        if (oppStrum != null) {
            var bg = oppStrum.background;
            if (bg != null) {
                if (!isModActive && cachedOppBg && !isMobLayout && !hideOpp) {
                    bg.visible = true;
                    var realWidth:Float = 0;
                    var startX:Float = oppStrum.x;
                    var oNotes = oppStrum.strumlineNotes.members;
                    
                    if (oNotes != null && oNotes.length > 0) {
                        var firstNote = oNotes[0];
                        var lastNote = oNotes[oNotes.length - 1];
                        realWidth = (lastNote.x + lastNote.width) - firstNote.x;
                        startX = firstNote.x;
                    }
                    
                    if (realWidth <= 0) realWidth = oppStrum.width;
                    if (realWidth <= 0) realWidth = 448; 
                    
                    oppStrum.zIndex = KassetteHUDElement.Z_STRUM_NOTES;
                    
                    var fWidth:Float = bg.frameWidth;
                    if (fWidth <= 0) fWidth = bg.width;
                    if (fWidth > 0) {
                        bg.scale.x = (realWidth + padding * 2) / fWidth;
                        bg.updateHitbox();
                        bg.x = startX - padding;
                        bg.zIndex = KassetteHUDElement.Z_STRUM_BACKGROUNDS;
                        
                        oppStrum.remove(bg, true);
                        state.remove(bg, true);
                        if (state.camHUD != null) bg.cameras = [state.camHUD];
                        state.add(bg);
                    }
                } else {
                    bg.visible = false;
                }
            }
        }

        if (isModActive) {
            state.comboPopUps.offsets = [480, -50];
        }

        if (myStrum != null && isModActive) {
            var centeredX:Float = (FlxG.width - pRealWidth) * 0.5;
            var shift:Float = centeredX - pStartX;
            myStrum.x += shift;

            var pBg = myStrum.background;
            if (pBg != null) {
                pBg.x = centeredX - padding;
            }
        }

        if (oppStrum != null) {
            if (isModActive) {
                if (oppStrum.noteHoldCovers != null && oppStrum.noteHoldCovers.members != null) {
                    oppStrum.noteHoldCovers.visible = false;
                    for (cover in oppStrum.noteHoldCovers.members) {
                        if (cover != null) { cover.visible = false; cover.alpha = 0.0; }
                    }
                }
                if (oppStrum.holdNotes != null && oppStrum.holdNotes.members != null) {
                    for (hold in oppStrum.holdNotes.members) {
                        if (hold != null && hold.cover != null) { hold.cover.visible = false; hold.cover.alpha = 0.0; }
                    }
                }
            }

            if (cachedMode == "Hidden Notes" || (!isModActive && hideOpp)) {
                oppStrum.visible = false;
            } else if (cachedMode == "Glass") {
                if (myStrum != null) {
                    oppStrum.x = myStrum.x;
                    oppStrum.zIndex = myStrum.zIndex - 10;
                    if (state != null) state.refresh();
                }
                var receptors = oppStrum.strumlineNotes.members;
                if (receptors != null) {
                    for (receptor in receptors) {
                        if (receptor != null) {
                            receptor.alpha = 0.7;
                            receptor.color = 0xFFAEAEAE;
                        }
                    }
                }
                var bg = oppStrum.background;
                if (bg != null) bg.visible = false;
                oppStrum.showNotesplash = false;
                
                hasShifted = true;
            }

            if (isArrows && cachedMobileOppNotes) {
                oppStrum.notes.visible = true;
                oppStrum.holdNotes.visible = true;
                if (!cachedIsMobPC) oppStrum.isDownscroll = false;
                
                if (lastNudgedStrum != oppStrum) {
                    if (cachedIsMobPC) {
                        var nudgeY:Float = -15.0;
                        var nudgeX:Float = -65.0; 
                        oppStrum.y += nudgeY; 
                        oppStrum.x += nudgeX; 
                    }
                    lastNudgedStrum = oppStrum;
                }
            }

        }


        cachedOppStrum = oppStrum;
        if (cachedOppStrum != null) {
            cachedReceptors = cachedOppStrum.strumlineNotes != null ? cachedOppStrum.strumlineNotes.members : null;
            cachedSplashes = cachedOppStrum.noteSplashes;
            
            if (cachedOppStrum.noteStyle != null) {
                var offsets = cachedOppStrum.noteStyle.getSplashOffsets();
                cachedHasSplashOffsets = (offsets != null && offsets.length > 0);
                if (cachedHasSplashOffsets) cachedSplashOffsetX = offsets[0];
            } else {
                cachedHasSplashOffsets = false;
                cachedSplashOffsetX = 0.0;
            }
        }
    }

    /** No additional logic needed; onCountdownStart handles retry via song restart. */
    override function onSongRetry(event:ScriptEvent):Void {
        super.onSongRetry(event);
    }

    /**
     * Called when a note becomes visible on screen. Repositions and styles
     * opponent notes according to the active mode:
     *   - "Hidden Notes" / "Like Mobile": hides the note entirely.
     *   - "P Style": places note at the P-style receptor x (semi-transparent).
     *   - "Glass": grays the note to 25% alpha.
     *   - "On" / Arrow layout: scales note down to compact ghost size and
     *     snaps its x to the matching compact receptor position.
     */
    override function onNoteIncoming(event:ScriptEvent) {
        super.onNoteIncoming(event);
        
        var state = PlayState.instance;
        if (state == null) return;

        var applyArrowLogic = cachedIsArrows;
        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Hidden Notes" || cachedMode == "Glass" || cachedMode == "Like Mobile");

        var note = event.note;
        var isOppNote = false;
        if (note != null && note.noteData != null) {
            isOppNote = !note.noteData.getMustHitNote();
        }

        if (note != null && isOppNote && cachedOppStrum != null) {
            var opp = cachedOppStrum;

            if (cachedMode == "Hidden Notes" || cachedMode == "Like Mobile") {
                note.alpha = 0;
                note.visible = false;
                
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.alpha = 0;
                    note.holdNoteSprite.visible = false;
                }
                return;
            } else if (cachedMode == "P Style") {
                note.alpha = 0.6 * cachedOppOpacity;
                if (note.holdNoteSprite != null) note.holdNoteSprite.alpha = 0.6 * cachedOppOpacity;
            } else if (cachedMode == "Glass") {
                if (note.alpha != 0.25) note.alpha = 0.25;
                if (note.color != 0xFF666666) note.color = 0xFF666666;
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.alpha = 0.25;
                    note.holdNoteSprite.color = 0xFF666666;
                }
            } else {
                note.alpha = cachedOppOpacity;
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.alpha = 0.8 * cachedOppOpacity;
                }
            }

            if (!isModActive && !applyArrowLogic) return;

            var receptors = opp.strumlineNotes.members;
            if (receptors == null || note.direction < 0 || note.direction >= receptors.length) return;
            
            var targetReceptor = receptors[note.direction];
            
            if (cachedMode == "P Style") {
                if (targetReceptor != null) {
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (note.width * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        note.holdNoteSprite.x = targetReceptor.x + (targetReceptor.width * 0.5) - (note.holdNoteSprite.width * 0.5);
                    }
                }
                return;
            } 
            else if (cachedMode == "Glass") {
                return;
            }
            
            if (cachedMode == "On" || applyArrowLogic) {
                var pixel:Bool = false;
                if (note.antialiasing == false) pixel = true;
                else pixel = cachedIsPixelStyle;
                var targetScale:Float = 1.0;
                
                if (cachedMode == "On") {
                    var sizeRatio:Float = 0.65;
                    var defaultScale:Float = pixel ? 6.0 : 0.7;
                    targetScale = defaultScale * sizeRatio;
                } else {
                    var noteScaleMul:Float = pixel ? 6.0 : (!cachedIsMobPC ? 0.7 : 0.8);
                    targetScale = opp.strumlineScale.x * noteScaleMul;
                }
                
                if (note.scale.x != targetScale || note.scale.y != targetScale) {
                    note.scale.set(targetScale, targetScale);
                    note.updateHitbox();
                    
                    if (applyArrowLogic && cachedMode != "On") {
                        note.offset.y -= pixel ? 4 : 15;
                    }
                }

                if (targetReceptor != null) {
                    var receptorW = targetReceptor.frameWidth * targetReceptor.scale.x;
                    var nw:Float = note.width > 0 ? note.width : receptorW;
                    
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (nw * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        var holdNote = note.holdNoteSprite;
                        holdNote.flipY = (opp.isDownscroll == true);

                        var holdWidthMul:Float = pixel ? 0.15 : 1.05;
                        var holdScale:Float = targetScale * holdWidthMul;
                        
                        holdNote.graphicWidth = holdNote.graphicWidth * holdScale;
                        
                        holdNote.x = targetReceptor.x + (targetReceptor.width * 0.5) - (holdNote.graphicWidth * 0.5);
                        holdNote.updateClipping();
                    }
                }
            }
        }
    }

    /**
     * Per-frame update. Handles:
     *   1. Player background panel x-tracking (follows note positions).
     *   2. Opponent "Like Mobile" fixed Y positioning.
     *   3. Opponent background panel x-tracking.
     *   4. Non-active-mod strumline positioning (Gammod OPPOSITE/BOTH sides).
     *   5. One-time compact shift for active modes (pHasShifted / hasShifted gates).
     *   6. Splash repositioning (~30fps) to follow compact receptor positions.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        
        var applyArrowLogic = cachedIsArrows;
        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Glass" || cachedMode == "Hidden Notes" || cachedMode == "Like Mobile");

        
        var state = PlayState.instance;
        if (state == null) return;
        
        var myStrum = state.playerStrumline;
        var oppStrum = cachedOppStrum;

        var isMob:Bool = FlxG.onMobile;
        var optManager = KssetteOptionsManager.instance;
        if (optManager != null && optManager.isMobileMode == true) isMob = true;
        
        if (antiCheatTriggered) {
            if (myStrum != null) {
                var targets = myStrum.getNotesMayHit();
                if (targets != null) {
                    for (note in targets) {
                        if (note != null && note.alive && !note.hasBeenHit) {
                            note.hasBeenHit = true;
                            state.noteMiss(note);
                        }
                    }
                }
            }
        }
        
        if (cachedCutoutSize < 0) {
            var cutout:Float = 0.0;
            cutout = FullScreenScaleMode.gameNotchSize.x;
            if (cutout <= 0) { 
                cutout = FullScreenScaleMode.gameCutoutSize.x; 
            }
            if (isMob && cutout < 60.0) cutout = 60.0;
            cachedCutoutSize = cutout;
        }
        
        var cutoutSize:Float = cachedCutoutSize;

        var showTimeBar:Bool = cachedShowTimeBar;
        var timeBarPos:String = cachedTimeBarPos;

        var marginLeft:Float = Constants.STRUMLINE_X_OFFSET + cutoutSize;
        var marginRight:Float = Constants.STRUMLINE_X_OFFSET + cutoutSize;

        if (showTimeBar) {
            if (timeBarPos == "Vertical Left") marginLeft += 22;
            if (timeBarPos == "Vertical Right") marginRight += 22;
        }

        var padding:Float = 12;
        if (myStrum != null && myStrum.background != null && myStrum.background.visible) {
            var pNotes = myStrum.strumlineNotes.members;
            if (pNotes != null && pNotes.length > 0) {
                var minX = Math.POSITIVE_INFINITY;
                for (note in pNotes) if (note != null && note.exists && note.x < minX) minX = note.x;
                if (minX != Math.POSITIVE_INFINITY)
                    myStrum.background.x = minX - padding;
            }
        }

        if (cachedMode == "Like Mobile" && oppStrum != null) {
            oppStrum.y = 50;
            oppStrum.zIndex = KassetteHUDElement.Z_STRUM_BACKGROUNDS;
            var receptors = oppStrum.strumlineNotes.members;
            if (receptors != null) {
                for (rec in receptors) {
                    if (rec != null) rec.y = 50;
                }
            }
        }

        if (oppStrum != null && oppStrum.background != null && oppStrum.background.visible) {
            var oNotes = oppStrum.strumlineNotes.members;
            if (oNotes != null && oNotes.length > 0) {
                var minX = Math.POSITIVE_INFINITY;
                for (note in oNotes) if (note != null && note.exists && note.x < minX) minX = note.x;
                if (minX != Math.POSITIVE_INFINITY)
                    oppStrum.background.x = minX - padding;
            }
        }

        if (cachedOppStrum != null) {
            cachedOppStrum.alpha = cachedOppOpacity;
            
            var currentReceptors = cachedOppStrum.strumlineNotes.members;
            if (currentReceptors != null) {
                for (receptor in currentReceptors) {
                    if (receptor != null) {
                        if (cachedMode == "Glass") receptor.alpha = 0.7;
                        else if (cachedMode == "P Style") receptor.alpha = 0.6 * cachedOppOpacity;
                        else if (cachedMode == "Hidden Notes") receptor.alpha = 0.0;
                        else receptor.alpha = cachedOppOpacity;
                    }
                }
            }
        }

        if (!isModActive) {
            if (!pHasShifted && myStrum != null && oppStrum != null) {
                var gSide = "NORMAL";
                var gammodHunter = KassetteHUDDatahunter.gammod;
                if (gammodHunter != null && gammodHunter.gammodPlayerSide != null) gSide = gammodHunter.gammodPlayerSide;

                if (gSide == "OPPOSITE") {
                    if (applyArrowLogic && !cachedIsMobPC) {
                    } else {
                        myStrum.x = marginLeft;
                        oppStrum.x = FlxG.width - oppStrum.width - marginRight;
                    }
                } else if (gSide == "BOTH") {
                    if (applyArrowLogic && !cachedIsMobPC) {
                        oppStrum.visible = false;
                    } else {
                        myStrum.x = (FlxG.width / 2) - (myStrum.width / 2);
                        oppStrum.visible = false;
                    }
                } else {
                    if (!(applyArrowLogic && !cachedIsMobPC)) {
                        oppStrum.x = marginLeft;
                    }
                }
                pHasShifted = true;
                hasShifted = true;
            }
            
            if (applyArrowLogic && !cachedIsMobPC && oppStrum != null) {
                var gSide = "NORMAL";
                var gammodHunter = KassetteHUDDatahunter.gammod;
                if (gammodHunter != null && gammodHunter.gammodPlayerSide != null) gSide = gammodHunter.gammodPlayerSide;
                
                var pLeft:Float = FlxG.width / 2;
                var pRight:Float = FlxG.width;
                if (myStrum != null) {
                    pLeft = myStrum.x;
                    pRight = myStrum.x + 448;
                    var pNotes = myStrum.strumlineNotes.members;
                    if (pNotes != null && pNotes.length > 0 && pNotes[0] != null) {
                        pLeft = pNotes[0].x;
                        var lastN = pNotes[pNotes.length - 1];
                        if (lastN != null) pRight = lastN.x + lastN.width;
                    }
                }

                var oNotes = oppStrum.strumlineNotes.members;
                if (oNotes != null && oNotes.length > 0 && oNotes[0] != null) {
                    var firstN = oNotes[0];
                    
                    var baseScale:Float = 0.7; 
                    var currentScale:Float = oppStrum.strumlineScale.x;
                    if (currentScale <= 0) currentScale = baseScale;
                    
                    var constantSpacing:Float = Strumline.NOTE_SPACING * baseScale; 
                    
                    var simulatedWidth:Float = (constantSpacing * (oNotes.length - 1)) + (firstN.frameWidth * baseScale);
                    
                    var margin:Float = 10;
                    var trueAvailable = gSide == "OPPOSITE" ? (FlxG.width - margin) - (pRight + margin) : (pLeft - margin) - margin;
                    
                    var scaleMul = 1.0;
                    if (trueAvailable < simulatedWidth && trueAvailable > 0) {
                         scaleMul = trueAvailable / simulatedWidth;
                         if (scaleMul < 0.6) scaleMul = 0.6;
                    }
                    
                    var targetScale = baseScale * scaleMul;
                    var applySpacing:Float = Strumline.NOTE_SPACING * targetScale;
                    
                    if (Math.abs(currentScale - targetScale) > 0.01) {
                        oppStrum.strumlineScale.set(targetScale, targetScale);
                    }
                    
                    var targetWidth = (applySpacing * (oNotes.length - 1)) + (firstN.frameWidth * targetScale);
                    
                    var safeLeft:Float = marginLeft;
                    var safeRight:Float = FlxG.width - targetWidth - marginRight;
                    
                    var targetX:Float = gSide == "OPPOSITE" ? safeRight : safeLeft;
                    
                    if (gSide == "OPPOSITE") {
                        if (targetX < pRight + margin) {
                            targetX = pRight + margin;
                            if (targetX + targetWidth > FlxG.width - margin) {
                                targetX = FlxG.width - margin - targetWidth;
                                if (targetX < pRight + margin) targetX = pRight + margin;
                            }
                        }
                    } else {
                        if (targetX + targetWidth > pLeft - margin) {
                            targetX = pLeft - margin - targetWidth;
                            if (targetX < margin) {
                                targetX = margin;
                                if (targetX + targetWidth > pLeft - margin) {
                                    targetX = pLeft - margin - targetWidth;
                                }
                            }
                        }
                    }

                    oppStrum.x = targetX;
                    
                    for (i in 0...oNotes.length) {
                        if (oNotes[i] != null) {
                            oNotes[i].x = targetX + (applySpacing * i);
                        }
                    }
                }
            }
            
            if (!applyArrowLogic) return;
        }

        if (myStrum != null && isModActive && !pHasShifted) {
            var pRealWidth:Float = 448;
            var pStartX:Float = myStrum.x;
            var pNotes = myStrum.strumlineNotes.members;
            if (pNotes != null && pNotes.length > 0) {
                var firstNote = pNotes[0];
                var lastNote = pNotes[pNotes.length - 1];
                pRealWidth = (lastNote.x + lastNote.width) - firstNote.x;
                pStartX = firstNote.x;
            }
            if (pRealWidth <= 0) pRealWidth = myStrum.width;
            if (pRealWidth <= 0) pRealWidth = 448;
            
            var centeredX:Float = (FlxG.width - pRealWidth) * 0.5;
            var shift:Float = centeredX - pStartX;
            if (Math.abs(shift) > 0.1) {
                myStrum.x += shift;
                if (myStrum.background != null) myStrum.background.x = centeredX - padding;
            }
            if (cachedMode == "Glass" && cachedOppStrum != null) cachedOppStrum.x = myStrum.x;
            pHasShifted = true;
        }

        if (cachedOppStrum != null && isModActive && !hasShifted) {
            var oppStrum = cachedOppStrum;
            var receptors = oppStrum.strumlineNotes.members;
            
            if (cachedMode == "Hidden Notes") {
                oppStrum.x = -5000;
                if (receptors != null) {
                    for (receptor in receptors) {
                        if (receptor != null) receptor.x = -5000;
                    }
                }
                hasShifted = true;
            }
            else if (cachedMode == "P Style" && receptors != null && receptors.length >= 4) {
                oppStrum.x = 0;
                
                var targetLeftX:Float = marginLeft;
                var targetRightX:Float = FlxG.width - marginRight - receptors[3].width;

                receptors[0].x = targetLeftX;
                receptors[1].x = targetLeftX + Strumline.NOTE_SPACING;
                receptors[3].x = targetRightX;
                receptors[2].x = targetRightX - Strumline.NOTE_SPACING;
                hasShifted = true;
            } 
            else if ((cachedMode == "On" || cachedMode == "Like Mobile") && receptors != null && receptors.length > 0) {
                oppStrum.x = 0;
                oppStrum.strumlineScale.set(0.65, 0.65);
                
                if (cachedMode == "Like Mobile") {
                    oppStrum.isDownscroll = false;
                    oppStrum.y = 50;
                }

                var sizeRatio:Float = 0.65;
                if (cachedMode == "Like Mobile") sizeRatio = 0.55;
                
                var targetSpacing:Float = Strumline.NOTE_SPACING * sizeRatio;

                for (receptor in receptors) {
                    if (receptor != null) {
                        var pixel:Bool = false;
                        if (receptor.antialiasing == false) pixel = true;
                        else pixel = cachedIsPixelStyle;
                        var defaultScale:Float = pixel ? 6.0 : 0.7;
                        receptor.scale.set(defaultScale * sizeRatio, defaultScale * sizeRatio);
                        receptor.updateHitbox();
                    }
                }

                var compactStartX:Float = marginLeft;
                var exactTotalWidth:Float = (targetSpacing * (receptors.length - 1)) + receptors[receptors.length - 1].width;
                
                if (cachedMode == "Like Mobile") {
                    if (cachedOppPos == "Right") {
                        compactStartX = FlxG.width - (10 + cachedCutoutSize) - exactTotalWidth;
                    } else {
                        compactStartX = 10 + cachedCutoutSize;
                    }
                } else if (cachedOppPos == "Right") {
                    compactStartX = FlxG.width - marginRight - exactTotalWidth;
                }

                // Anti-overlap protection for Middlescroll
                if (myStrum != null) {
                    var pLeft = myStrum.x;
                    var pRight = myStrum.x + 448;
                    var pNotes = myStrum.strumlineNotes.members;
                    if (pNotes != null && pNotes.length > 0) {
                        pLeft = pNotes[0].x;
                        var lastN = pNotes[pNotes.length - 1];
                        pRight = lastN.x + lastN.width;
                    }
                    
                    if (cachedOppPos != "Right") {
                        if (compactStartX + exactTotalWidth > pLeft - 10) {
                            compactStartX = pLeft - exactTotalWidth - 10;
                        }
                    } else {
                        if (compactStartX < pRight + 10) {
                            compactStartX = pRight + 10;
                        }
                    }
                }

                for (i in 0...receptors.length) {
                    if (receptors[i] != null) {
                        receptors[i].x = compactStartX + (targetSpacing * i);
                        if (cachedMode == "Like Mobile") receptors[i].y = 50;
                        receptors[i].updateHitbox();
                    }
                }
                
                hasShifted = true;
            }
        }

        // Receptor opacity moved up above the early return.

        splashUpdateTimer += event.elapsed;
        if (splashUpdateTimer >= 0.033) {
            splashUpdateTimer = 0.0;
            var splashes = cachedSplashes;
            if (splashes != null && splashes.members != null) {
                
                var receptors = cachedReceptors;
                var hasOffsets:Bool = cachedHasSplashOffsets;
                var offX:Float = cachedSplashOffsetX;
                
                for (splash in splashes.members) {
                    if (splash != null && splash.alive && splash.visible && splash.alpha > 0 && splash.animation != null && splash.animation.name != null) {
                        var animName = splash.animation.name;
                        var dir:Int = -1;
                        
                        if (animName.indexOf("LEFT") != -1) dir = 0;
                        else if (animName.indexOf("DOWN") != -1) dir = 1;
                        else if (animName.indexOf("UP") != -1) dir = 2;
                        else if (animName.indexOf("RIGHT") != -1) dir = 3;

                        if (dir != -1 && receptors != null && dir < receptors.length) {
                            var receptor = receptors[dir];
                            if (receptor != null) {
                                var expectedX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                if (hasOffsets) expectedX += offX * splash.scale.x;

                                if (Math.abs(splash.x - expectedX) > 0.1 || splash.scale.x != receptor.scale.x || splash.scale.y != receptor.scale.y) {
                                    splash.scale.set(receptor.scale.x, receptor.scale.y);
                                    splash.updateHitbox();

                                    var targetX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                    if (hasOffsets) targetX += offX * splash.scale.x;

                                    splash.x = targetX;
                                }
                        }
                    }
                }
            }
        }
    }
    }
    
    public var antiCheatTriggered:Bool = false;

    public function applyAntiCheatPenalty() {
        antiCheatTriggered = true;
        var state = PlayState.instance;
        if (state != null && state.playerStrumline != null) {
            state.playerStrumline.visible = false;
        }
    }
}