package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.Conductor;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.Paths;
import funkin.audio.FunkinSound;
import flixel.util.FlxTimer;
import Std;
import funkin.modding.events.ScriptEvent;

/**
 * KssetteResumeCount
 * 
 * Displays an animated custom countdown (3 -> 2 -> 1 -> GO!) when the player
 * resumes gameplay from pause. 
 * 
 * While the countdown is active:
 *  - The song score is locked to prevent drift.
 *  - Music and vocals are paused.
 *  - Note hits, misses, and ghost taps are cancelled to prevent penalty.
 * 
 * Countdown assets (sounds and images) are resolved automatically based on
 * the active NoteStyle, falling back to pixel or base funkin styles as needed.
 */

class KssetteResumeCount extends KHUDModifier {
    /** Indicates whether the resume countdown feature is enabled in the options. */
    var cachedActive:Bool = false;
    /** True if the 3-2-1 countdown animation is currently running. */
    var isCounting:Bool = false;
    /** True during the brief check period between resuming and starting the countdown. */
    var isResuming:Bool = false;
    /** Timer controlling the rhythm of the countdown sequence. */
    var currentTimer:FlxTimer;
    /** Timer used to defer execution to check if the state is stable after resuming. */
    var resumeTimer:FlxTimer;
    
    /** The original music volume before the countdown started. */
    var storedVolume:Float = 1.0;
    /** The original mono vocals volume. */
    var storedVocalsVolume:Float = 1.0;
    /** The original multi-track player vocals volume. */
    var storedPlayerVol:Float = 1.0;
    /** The original multi-track opponent vocals volume. */
    var storedOpponentVol:Float = 1.0;
    /** The original score to lock and prevent background drift. */
    var storedScore:Int = 0;
    
    /** The cached NoteStyle ID used to resolve assets. */
    var cachedStyle:String = "funkin";
    /** Indicates if the resolved style is pixel-based. */
    var cachedPixel:Bool = false;
    /** The scale factor applied to the countdown images. */
    var cachedScale:Float = 1.0;
    
    /** Base sound file names for standard styles. */
    var soundNames:Array<String> = ["GO", "ONE", "TWO", "THREE"];
    /** Base sound file names for numeric styles. */
    var soundNamesNum:Array<String> = ["Go", "1", "2", "3"];
    /** Base image file names for the countdown sprites. */
    var imageNames:Array<String> = ["go", "set", "ready", ""];
    
    /** Pre-loaded sound assets for each countdown step. */
    var cachedSounds:Array<Dynamic> = [null, null, null, null];
    /** Pre-loaded image assets for each countdown step. */
    var cachedImages:Array<Dynamic> = [null, null, null, null];
    /** Indicates if a specific image step should use pixel antialiasing. */
    var cachedImagePixel:Array<Bool> = [false, false, false, false];
    /** The calculated drawing scale for a specific image step. */
    var cachedImageScale:Array<Float> = [1.0, 1.0, 1.0, 1.0];
    /** The NoteStyle ID that the currently cached assets belong to. */
    var cachedAssetsStyle:String = "";
    
    /** Arrays to keep track of active countdown visual objects so they can be cleaned up. */
    var activeTweens:Array<FlxTween> = [];
    var activeSprites:Array<FlxSprite> = [];

    public function new() {
        super("KssetteResumeCount");
        elementType = "modifier";
    }

    /**
     * Cancels any active countdown timers to prevent orphaned events
     * when the state changes unexpectedly (e.g. death or exit).
     */
    function cancelTimers() {
        if (currentTimer != null) currentTimer.cancel();
        if (resumeTimer != null) resumeTimer.cancel();
        currentTimer = null;
        resumeTimer = null;
    }

    /**
     * Restores the audio volume to the levels stored before pausing.
     * @param state The active PlayState instance.
     */
    function restoreAudio(state:PlayState) {
        if (FlxG.sound.music != null) FlxG.sound.music.volume = storedVolume;
        if (state?.vocals != null) {
            if (state.vocals?.playerVolume != null) {
                state.vocals.playerVolume = storedPlayerVol;
                state.vocals.opponentVolume = storedOpponentVol;
            } else {
                state.vocals.volume = storedVocalsVolume;
            }
        }
        isResuming = false;
    }

    /**
     * Cancels an event if the countdown is currently active.
     * @param event The ScriptEvent to cancel.
     */
    function cancelIfLocked(event:Dynamic) { if (isCounting || isResuming) event.cancel(); }

    /**
     * Initializes the resume count module when a new song starts.
     * Registers with the API and pre-caches the countdown assets.
     */
    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        cachedActive = false;

        

        cachedActive = getSetting("kssette_resume_countdown") == true;
        isCounting = false;
        isResuming = false;

        var state = PlayState.instance;
        if (cachedActive && state != null) {
            cacheStyle(state);
            cacheCountdownAssets();
        }
    }

    /**
     * Per-frame update logic. Monitors for unexpected state changes 
     * and forces the song score to remain locked while the countdown is active.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        if (isCounting) {
            var state = PlayState.instance;
            if (state == null || state.startingSong || state.isPlayerDying || (state.conductorInUse != null && state.conductorInUse.songPosition <= 0)) {
                isCounting = false;
                isResuming = false;
                cancelTimers();
            } else if (state.songScore != storedScore) state.songScore = storedScore;
        }
    }

    /** Cancels note hits during the countdown. */
    override public function onNoteHit(event) { cancelIfLocked(event); }

    /** Cancels note misses during the countdown. */
    override public function onNoteMiss(event) { cancelIfLocked(event); }

    /** Cancels ghost tap misses during the countdown. */
    override public function onNoteGhostMiss(event) { cancelIfLocked(event); }
    
    /** Prevents the player from pausing again during the countdown. */
    override public function onPause(event:ScriptEvent) { cancelIfLocked(event); }

    /**
     * Triggered when the player resumes from pause. 
     * Silences audio immediately and defers the countdown start to ensure state stability.
     */
    override public function onResume(event) {
        super.onResume(event);
        var state = PlayState.instance;

        if (!cachedActive || isCounting || isResuming || state == null) return;
        if (state.startingSong || state.isPlayerDying || state.conductorInUse.songPosition <= 0) return;

        isResuming = true;
        storedScore = state.songScore;

        if (FlxG.sound.music != null) {
            storedVolume = FlxG.sound.music.volume;
            FlxG.sound.music.volume = 0;
        }
        if (state.vocals != null) {
            if (state.vocals?.playerVolume != null) {
                storedPlayerVol = state.vocals.playerVolume;
                storedOpponentVol = state.vocals.opponentVolume;
                state.vocals.playerVolume = 0;
                state.vocals.opponentVolume = 0;
            } else {
                storedVocalsVolume = state.vocals.volume;
                state.vocals.volume = 0;
            }
        }

        var originalState = state;

        resumeTimer = new FlxTimer().start(0.001, function(tmr:FlxTimer) {
            var checkState = PlayState.instance;
            
            if (checkState != originalState) { restoreAudio(checkState); return; }
            if (checkState == null || !checkState.exists || !checkState.active) { isResuming = false; return; }
            if (checkState.startingSong || checkState.isPlayerDying) { restoreAudio(checkState); return; }
            if (checkState.conductorInUse != null && checkState.conductorInUse.songPosition <= 0) { restoreAudio(checkState); return; }
            
            if (checkState?._exiting == true) { restoreAudio(checkState); return; }
            if (checkState?.isEndingSong == true) { restoreAudio(checkState); return; }

            startCustomCountdown();
        });
    }

    /**
     * Starts the custom 3-2-1 countdown logic.
     */
    function startCustomCountdown() {
        var state = PlayState.instance;
        if (state == null || isCounting) {
             isResuming = false;
             return;
        }

        isCounting = true; 
        isResuming = false;
        
        if (FlxG.sound.music != null) {
            FlxG.sound.music.pause();
            FlxG.sound.music.volume = storedVolume;
        }
        if (state.vocals != null) {
            state.vocals.pause();
            if (state.vocals?.playerVolume != null) {
                state.vocals.playerVolume = storedPlayerVol;
                state.vocals.opponentVolume = storedOpponentVol;
            } else {
                state.vocals.volume = storedVocalsVolume;
            }
        }

        cacheStyle(state);
        cacheCountdownAssets();

        doCount(3);
    }

    /**
     * Retrieves the current NoteStyle ID from the player's strumline
     * to resolve the correct set of countdown assets.
     */
    function cacheStyle(state:PlayState) {
        cachedStyle = "funkin";
        cachedPixel = false;
        cachedScale = 1.0;

        if (state?.playerStrumline?.noteStyle != null) {
            var rawId = state.playerStrumline.noteStyle?.id;
            if (rawId != null) cachedStyle = Std.string(rawId);
        }
    }

    /**
     * Pre-loads the sound and image assets for the current NoteStyle.
     * Evaluates multiple fallback paths (custom -> pixel -> funkin) 
     * to ensure assets are properly resolved.
     */
    function cacheCountdownAssets() {
        if (cachedAssetsStyle == cachedStyle) return;
        cachedAssetsStyle = cachedStyle;

        var fallbackStyle:String = "funkin";
        if (cachedStyle.indexOf("pixel") != -1) fallbackStyle = "pixel";

        for (num in 0...4) {
            var soundAsset:Dynamic = null;
            soundAsset = Paths.sound('gameplay/countdown/' + fallbackStyle + '/intro' + soundNames[num]);
            if (soundAsset == null) {
                soundAsset = Paths.sound('gameplay/countdown/' + fallbackStyle + '/intro' + soundNamesNum[num]);
            }
            if (soundAsset == null && fallbackStyle != "funkin") {
                soundAsset = Paths.sound('gameplay/countdown/funkin/intro' + soundNames[num]);
            }
            cachedSounds[num] = soundAsset;

            var imageAsset:Dynamic = null;
            var usePixel:Bool = false;
            var drawScale:Float = 1.0;

            if (imageNames[num] != "") {
                imageAsset = Paths.image('ui/countdown/' + fallbackStyle + '/' + imageNames[num]);
                if (fallbackStyle == "pixel") {
                    usePixel = true;
                    drawScale = 6.0;
                }
                if (imageAsset == null && fallbackStyle != "funkin") {
                    imageAsset = Paths.image('ui/countdown/funkin/' + imageNames[num]);
                    usePixel = false;
                    drawScale = 1.0;
                }
            }

            cachedImages[num] = imageAsset;
            cachedImagePixel[num] = usePixel;
            cachedImageScale[num] = drawScale;
        }
    }

    /**
     * Recursive countdown step executor.
     * Plays the associated sound and animates the sprite, then schedules
     * the next step (3 -> 2 -> 1 -> GO).
     * @param num The current countdown step (3 to 0).
     */
    function doCount(num:Int) {
        var state = PlayState.instance;
        if (state == null || !isCounting) return;
        if (state.startingSong || state.isPlayerDying) return;

        var beatTime:Float = (Conductor.instance != null) ? Conductor.instance.beatLengthMs / 1000 : 0.6;

        var soundAsset:Dynamic = cachedSounds[num];
        var imageAsset:Dynamic = cachedImages[num];
        var usePixel:Bool = cachedImagePixel[num];
        var drawScale:Float = cachedImageScale[num];

        if (soundAsset != null) FunkinSound.playOnce(soundAsset, 1.0);

        if (imageAsset != null) {
            var sprite = new FlxSprite().loadGraphic(imageAsset);
            sprite.scrollFactor.set(0, 0);

            if (usePixel) sprite.antialiasing = false;
            
            sprite.setGraphicSize(Std.int(sprite.width * drawScale));
            sprite.updateHitbox();
            sprite.screenCenter();
            if (state.camHUD != null) sprite.cameras = [state.camHUD];
            state.add(sprite);

            var tweenParams:Dynamic = {alpha: 0};
            var tweenDuration:Float = beatTime * 0.8;
            var tweenEase:Dynamic = FlxEase.cubeInOut;

            if (num == 0) {
                if (!usePixel) tweenParams = {alpha: 0, "scale.x": 1.4, "scale.y": 1.4};
                tweenDuration = beatTime;
                tweenEase = FlxEase.cubeOut;
            }
            
            var tw = FlxTween.tween(sprite, tweenParams, tweenDuration, { ease: tweenEase, onComplete: function(t:FlxTween) { 
                if (state != null) state.remove(sprite, true); 
                sprite.destroy(); 
                if (activeSprites != null) activeSprites.remove(sprite);
                if (activeTweens != null) activeTweens.remove(t);
            }});
            
            if (activeSprites != null) activeSprites.push(sprite);
            if (activeTweens != null) activeTweens.push(tw);
        }

        if (num > 0) {
            currentTimer = new FlxTimer().start(beatTime, function(tmr:FlxTimer) { doCount(num - 1); });
        } else {
            if (FlxG.sound.music != null) FlxG.sound.music.play();
            if (state.vocals != null) state.vocals.play();
            isCounting = false;
        }
    }
    
    override public function destroy() {
        if (currentTimer != null) currentTimer.cancel();
        currentTimer = null;
        if (resumeTimer != null) resumeTimer.cancel();
        resumeTimer = null;
        
        if (activeTweens != null) {
            for (t in activeTweens) t.cancel();
            activeTweens = [];
        }

        if (activeSprites != null) {
            for (s in activeSprites) s.destroy();
            activeSprites = [];
        }

        super.destroy();
    }
}
