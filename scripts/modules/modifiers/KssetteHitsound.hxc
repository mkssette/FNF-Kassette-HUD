package kassettehud.util;

/**
 * KssetteHitsound
 *
 * Plays a custom sound effect when the player hits notes or presses note keys.
 *
 * Modes:
 *   - "Off"         - Disabled; no custom hitsound plays.
 *   - "On Note Hit" - Plays on successful note hits (player notes only).
 *   - "Anytime"     - Plays on any key press, regardless of notes (ghost-tap style).
 *
 * The hitsound asset is loaded from "play/hitsound" in the mod's audio folder
 * and is cached at countdown start for zero-latency playback during gameplay.
 *
 * Managed settings:
 *   - kssette_hitsound:        "Off" | "On Note Hit" | "Anytime"
 *   - kssette_hitsound_volume: "10%" ... "100%"
 *
 * Dependencies:
 *   - KssetteApi.getKssValue() - reads option values
 *   - Paths.sound()            - loads the hitsound asset
 */

import flixel.FlxG;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.Paths;
import funkin.save.Save;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import Std;
import Math;
import StringTools;

class KssetteHitsound extends KHUDModifier {
    var isPaused:Bool = false;
    var hitSound:Dynamic = null;
    var _cMode:String = "Off";
    var _cVolume:Float = 1.0;

    /**
     * Initializes the KssetteHitsound modifier.
     * This module runs in the background during gameplay and listens for note hits or 
     * raw keyboard inputs to play a custom sound effect based on the user's settings.
     */
    public function new() {
        super('KssetteHitsound');
        elementType = "modifier";
        
    }

    /**
     * Fetches the latest user preferences for the hitsound mode and volume.
     * Normalizes percentage strings (e.g., "50%") into float multipliers (e.g., 0.5)
     * and maps legacy boolean toggles to the new "On Note Hit" / "Anytime" string modes.
     */
    function updateSettings() {
        var val = getSetting("kssette_hitsound");
        if (val == null) {
            _cMode = "Off";
        } else {
            var s = Std.string(val);
            if (s == "On" || s == "on" || s == "true" || val == true || s == "On Note Hit") _cMode = "On Note Hit";
            else if (s == "Anytime" || s == "anytime") _cMode = "Anytime";
            else _cMode = "Off";
        }

        var v:Dynamic = getSetting("kssette_hitsound_volume");
        if (v == null && Save.instance?.modOptions?.exists("kssette_hitsound_volume") == true) {
            v = Save.instance.modOptions.get("kssette_hitsound_volume");
        }
        if (v != null) {
            var p = Std.parseFloat(StringTools.replace(Std.string(v), "%", ""));
            if (!Math.isNaN(p)) _cVolume = p > 1.0 ? p / 100.0 : p;
            else _cVolume = 1.0;
        } else {
            _cVolume = 1.0;
        }
    }

    /**
     * Plays the cached hitsound audio file using the configured volume level.
     * If the sound hasn't been cached yet, it securely loads it from the assets path first.
     */
    function playHitSound() {
        if (hitSound == null) hitSound = Paths.sound("play/hitsound");
        if (hitSound != null) FunkinSound.playOnce(hitSound, _cVolume);
    }

    /**
     * Triggered right before the 3-2-1 countdown begins.
     * Pre-loads the hitsound asset into memory to guarantee zero-latency playback 
     * on the very first note hit, and ensures the component starts unpaused.
     * 
     * @param event The script event data regarding the countdown.
     */
    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        updateSettings();
        isPaused = false;
        hitSound = Paths.sound("play/hitsound");
    }

    /**
     * Triggered when the game is paused.
     * Sets a flag to prevent keyboard inputs in the pause menu from triggering the hitsound.
     * 
     * @param event The script event indicating the game was paused.
     */
    override function onPause(event:ScriptEvent) {
        super.onPause(event);
        isPaused = true;
    }

    /**
     * Triggered when a state transition fully finishes.
     * Resets the pause flag to re-enable hitsounds for the new state context.
     * 
     * @param event The script event indicating a state change completion.
     */
    override function onStateChangeEnd(event:ScriptEvent) {
        super.onStateChangeEnd(event);
        isPaused = false;
    }

    /**
     * Triggered when returning to the game from the pause menu.
     * Forces a settings refresh so any volume or mode changes made within the options 
     * menu while paused take effect immediately.
     * 
     * @param event The script event indicating the game resumed.
     */
    override function onResume(event:ScriptEvent) {
        super.onResume(event);
        updateSettings();
        isPaused = false;
    }

    /**
     * Per-frame update loop.
     * Specifically handles the "Anytime" mode by constantly monitoring the player's 
     * raw control inputs (Left, Down, Up, Right). If any directional key is pressed, 
     * it instantly plays the hitsound, effectively creating a ghost-tapping sound effect.
     * 
     * @param event The update script event containing delta time.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        super.onUpdate(event);

        if (isPaused) return;
        if (_cMode != "Anytime") return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying) return;

        var controlsObj = state?.controls;
        if (controlsObj == null) return;

        if (controlsObj.NOTE_LEFT_P || controlsObj.NOTE_DOWN_P || controlsObj.NOTE_UP_P || controlsObj.NOTE_RIGHT_P) {
            playHitSound();
        }
    }

    /**
     * Called when a note is hit. Handles "On Note Hit" mode:
     * plays the hitsound only for player notes (getMustHitNote == true).
     * Ignores opponent notes to prevent double-triggering in auto-play.
     */
    override function onNoteHit(event:Dynamic) {
        super.onNoteHit(event);
        
        if (isPaused) return;
        if (_cMode != "On Note Hit") return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying) return;

        var note = event.note;
        if (note?.noteData == null) return;

        // Use `?` for safe invocation; fall back to the property if the function is absent.
        var mustHit = note.noteData?.getMustHitNote();
        if (mustHit == null) mustHit = note.noteData?.mustHitNote;
        if (mustHit != true) return;

        playHitSound();
    }
}