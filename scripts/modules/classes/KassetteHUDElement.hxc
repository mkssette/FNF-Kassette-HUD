package kassettehud.util;

import funkin.play.PlayState;
import funkin.modding.module.ModuleHandler;
import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.Paths;
import openfl.utils.Assets;
import openfl.display.BitmapData;
import flixel.FlxCamera;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import kassettehud.util.KssetteFontManager;

class KassetteHUDElement {
    public var name:String = "Element";
    public var elementType:String = "visual";
    public var skinId:String = "default";
    public var active:Bool = true;

    // Track objects to auto-destroy them when this element is destroyed
    public var trackedObjects:Array<Dynamic> = [];

    // Preview variables for HUD Options Menu
    
    // Preview variables for HUD Options Menu
    public static var preview_bf:Dynamic = null;
    public static var preview_dad:Dynamic = null;
    public static var preview_scoreBopTrigger:Bool = false;
    public static var preview_simulatedAcc:Float = 0.0;
    public static var preview_missesCount:Int = 0;
    public static var preview_playerTurn:Bool = true;
    public static var preview_turnProgress:Float = 0.0;

    public var isMobile:Bool = false;
    public var isPreview:Bool = false;
    
    public function new(name:String) {
        this.name = name;
        this.isMobile = KssetteOptionsManager.instance != null ? KssetteOptionsManager.instance.isMobileMode : FlxG.onMobile;
    }

    /** Helper shortcut to fetch Kssette settings safely */
    public function getSetting(key:String):Dynamic {
        if (KssetteOptionsManager.instance != null) return KssetteOptionsManager.instance.getKssValue(key);
        return null;
    }

    /** Shortcut for getting string settings safely */
    public function getSettingString(key:String, defaultVal:String = ""):String {
        var val = getSetting(key);
        return val != null ? Std.string(val) : defaultVal;
    }
    
    /** Shortcut for getting boolean settings safely */
    public function getSettingBool(key:String, defaultVal:Bool = false):Bool {
        var val = getSetting(key);
        if (val == null) return defaultVal;
        return (val == true || Std.string(val) == "On" || Std.string(val) == "true");
    }

    /** Returns true if the global HUD visibility option is enabled */
    public function isHudVisible():Bool {
        var val = getSetting("kssette_show_hud");
        if (val == null) return true; // Default to visible on fresh saves!
        return (val == true || Std.string(val) == "On" || Std.string(val) == "true");
    }

    /** Returns true if downscroll is currently active in gameplay or preferences */
    public function isDownscroll():Bool {
        if (KssetteOptionsManager.instance != null) {
            return KssetteOptionsManager.instance.getDownscroll();
        }
        return false;
    }

    // Getters have been replaced with standard instance variables initialized in the constructor to improve HScript compatibility.

    public function onCountdownStart(event:Dynamic) {}
    public function onUpdate(event:Dynamic) {}

    /** Logic executed exclusively when inside PlayState */
    public function inGameplay(event:Dynamic) {}
    
    /** Logic executed exclusively when inside the KssetteOptionsState Preview */
    public function inPreview(event:Dynamic) {}

    public function onStepHit(event:Dynamic) {}
    public function onBeatHit(event:Dynamic) {}
    public function onSongStart(event:Dynamic) {}
    public function onSongRetry(event:Dynamic) {}
    public function onSongEnd(event:Dynamic) {}
    public function onResume(event:Dynamic) {}
    public function onPause(event:Dynamic) {}
    public function onStateChangeStart(event:Dynamic) {}
    public function onStateChangeEnd(event:Dynamic) {}
    public function onGhostMissNote(event:Dynamic) {}
    public function onNoteGhostMiss(event:Dynamic) {}
    public function onSubStateOpenBegin(event:Dynamic) {}
    public function onSubStateCloseEnd(event:Dynamic) {}
    public function onNoteHit(event:Dynamic) {}
    public function onNoteMiss(event:Dynamic) {}
    public function onNoteIncoming(event:Dynamic) {}
    public function onEvent(event:Dynamic) {}

    // ==========================================
    // STANDARDIZED UTILITY FUNCTIONS
    // ==========================================

    /** Adds an element safely to PlayState or FlxG.state, optionally assigning a camera. */
    public function safeAdd(obj:Dynamic, ?cam:Dynamic) {
        if (obj == null) return;
        if (cam != null) obj.cameras = [cam];
        var state = PlayState.instance;
        if (state != null && !isPreview) state.add(obj);
        else if (FlxG.state != null) FlxG.state.add(obj);
        
        if (trackedObjects.indexOf(obj) == -1) {
            trackedObjects.push(obj);
        }
    }

    /** Removes an element safely from PlayState and FlxG.state. */
    public function safeRemove(obj:Dynamic) {
        if (obj == null) return;
        var state = PlayState.instance;
        if (state != null && !isPreview) state.remove(obj, true);
        if (FlxG.state != null) FlxG.state.remove(obj, true);
    }

    /** Safely removes and destroys an element. */
    public function safeDestroy(obj:Dynamic) {
        if (obj != null) {
            safeRemove(obj);
            obj.destroy();
        }
    }

    /** Helper shortcut to get the current HUD font. */
    public function getHudFont():String {
        if (KssetteFontManager.instance != null) {
            var f = KssetteFontManager.instance.getHudFont();
            if (f != null && f != "null" && f != "") return f;
        }
        return "VCR OSD Mono";
    }

    /** 
     * Returns the loaded image graphic from the root of the current skin.
     * Functions like Paths.image, preserving internal folder structure (e.g., ui/hud/break).
     */
    public function getSkinImage(imageName:String, ?targetSkinId:String):Dynamic {
        if (imageName == null || imageName == "") return null;
        
        var actualSkinId = (targetSkinId != null && targetSkinId != "") ? targetSkinId : this.skinId;
        var bmp = _tryLoadImage(imageName, actualSkinId);
        
        if (bmp == null && actualSkinId != "default") {
            bmp = _tryLoadImage(imageName, "default");
        }
        
        if (bmp == null) {
            trace("[KassetteHUDElement] Error loading skin image: " + imageName);
        }
        
        return bmp;
    }

    private function _tryLoadImage(imageName:String, skinIdToUse:String):Dynamic {
        var relativePath = "skins/" + skinIdToUse + "/images/" + imageName + ".png";
        
        // 1. Try standard Assets system
        try {
            if (Assets.exists(relativePath)) {
                return Assets.getBitmapData(relativePath);
            }
        } catch(e:Dynamic) {}
        
        // 2. Fallback to direct filesystem access across all mod folders
        var _localAssetHunter = KassetteHUDDatahunter.asset;
        if (_localAssetHunter != null && _localAssetHunter.getModFolders != null) {
            try {
                var folders:Array<String> = _localAssetHunter.getModFolders();
                for (folder in folders) {
                    var directPath = "mods/" + folder + "/" + relativePath;
                    
                    var bmp = BitmapData.fromFile(directPath);
                    if (bmp != null) return bmp;
                    
                    var winPath = directPath.split("/").join("\\");
                    bmp = BitmapData.fromFile(winPath);
                    if (bmp != null) return bmp;
                }
            } catch(e:Dynamic) {}
        } else {
            // Failsafe if assetHunter isn't ready
            try {
                var directPath = "mods/FNF-Kassette-HUD/" + relativePath;
                var bmp = BitmapData.fromFile(directPath);
                if (bmp != null) return bmp;
                
                var winPath = directPath.split("/").join("\\");
                bmp = BitmapData.fromFile(winPath);
                if (bmp != null) return bmp;
            } catch(e:Dynamic) {}
        }
        
        return null;
    }

    /** Creates and formats a FlxText object automatically. */
    public function createText(x:Float, y:Float, w:Float, text:String, size:Int, color:Int = 0xFFFFFFFF, align:String = "left"):FlxText {
        var t = new FlxText(x, y, w, text, size);
        t.setFormat(getHudFont(), size, color, align, FlxTextBorderStyle.OUTLINE, 0xFF000000);
        return t;
    }

    /** Returns the display label for a judgement identifier. */
    public function getJudgeName(name:String):String {
        switch(name) {
            case 'sick': return 'Sicks';
            case 'good': return "Goods";
            case 'bad': return "Bads";
            case 'shit': return "Shits";
            case 'miss': return "Misses";
            case 'maxCombo': return "Max Combo";
            default: return "???";
        }
    }

    /** Formats a rank ID to its abbreviated display form. */
    public function formatRank(id:String):String {
        if (id == null || id == "" || id == "?") return "?";
        switch(id) {
            case "PERFECT_GOLD": return "P [GOLD]";
            case "PERFECT": return "P";
            case "EXCELLENT": return "E";
            case "GREAT": return "G";
            case "GOOD": return "Gd";
            case "LOSS": return "L";
            default: return "?";
        }
    }

    public function destroy() {
        for (obj in trackedObjects) {
            if (obj != null) {
                try {
                    safeRemove(obj);
                    obj.destroy();
                } catch(e:Dynamic) {}
            }
        }
        trackedObjects = [];
    }

    public function buildPreview(cam:FlxCamera) {
        this.isPreview = true;
    }
    public function updatePreview() {}
}
