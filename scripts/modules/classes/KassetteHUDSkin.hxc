package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;

class KassetteHUDSkin extends Module {
    public var skinId:String = "unknown";
    public var skinName:String = "Unknown Skin";
    public var author:String = "Unknown";
    public var description:String = "No description";

    public var elements = [];
    public var isBuilt:Bool = false;
    public var disabledOptions:Array<String> = [];
    var _previewUpdateTimer:Float = 0.0;

    public function new(config:Dynamic = null) {
        var id = "unknown";
        var name = "Unknown Skin";
        var author = "Unknown";
        var desc = "No description";

        if (config != null) {
            if (config.id != null) id = Std.string(config.id);
            if (config.name != null) name = Std.string(config.name);
            if (config.author != null) author = Std.string(config.author);
            if (config.description != null) desc = Std.string(config.description);
        }
        
        // Le damos un ID único al módulo para que V-Slice no lo sobreescriba
        super(id + "SkinModule");
        
        this.skinId = id;
        this.skinName = name;
        this.author = author;
        this.description = desc;
        this.active = false; // El Manager decidirá si se activa

        trace("[KassetteHUDSkin] Initializing skin: " + this.skinId);
        
        // Auto-registro en el Manager solo si no es la clase base
        if (this.skinId != "unknown") {
            var manager:Dynamic = ModuleHandler.getModule("KassetteSkinManager");
            if (manager != null) {
                manager.registerSkin(this);
            } else {
                trace("[KassetteHUDSkin] WARNING: KassetteSkinManager not found! Skin will not be registered.");
            }
        }
    }

    // A ser sobrescrito por las skins hijas
    public function buildElements():Dynamic {
        return [];
    }

    public function ensureElements() {
        if (isBuilt) return;
        elements = buildElements();
        for (el in elements) {
            el.skinId = this.skinId;
        }
        isBuilt = true;
    }

    public function destroyElements() {
        for (el in elements) {
            el.destroy();
        }
        elements = [];
        isBuilt = false;
    }

    public function addElement(element:Dynamic) {
        if (element != null) {
            element.skinId = this.skinId;
            elements.push(element);
        }
    }

    public function getElement(elementName:String):Dynamic {
        for (el in elements) {
            if (el != null && el.name == elementName) {
                return el;
            }
        }
        return null;
    }

    override public function onCountdownStart(event:Dynamic) {
        if (!active) return;
        ensureElements();
        for (el in elements) {
            try { el.isPreview = false; } catch(e:Dynamic) {}
            el.onCountdownStart(event);
        }
    }

    override public function onUpdate(event:Dynamic) {
        if (!active) return;
        
        var inPlayState = (PlayState.instance != null && FlxG.state == PlayState.instance);
        if (inPlayState) {
            for (el in elements) el.onUpdate(event);
        } else {
            var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
            _previewUpdateTimer += elapsed;
            if (_previewUpdateTimer >= 0.033) {
                for (el in elements) el.onUpdate(_previewUpdateTimer);
                _previewUpdateTimer = 0.0;
            }
        }
    }

    override public function onNoteHit(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onNoteHit(event);
    }

    override public function onSongEnd(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onSongEnd(event);
    }

    override public function onSongRetry(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onSongRetry(event);
    }

    override public function onStepHit(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onStepHit(event);
    }

    override public function onBeatHit(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onBeatHit(event);
    }

    override public function onSongStart(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onSongStart(event);
    }

    override public function onResume(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onResume(event);
    }

    override public function onPause(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onPause(event);
    }

    override public function onStateChangeStart(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onStateChangeStart(event);
    }

    override public function onStateChangeEnd(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onStateChangeEnd(event);
    }

    override public function onNoteMiss(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onNoteMiss(event);
    }

    override public function onNoteIncoming(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onNoteIncoming(event);
    }

    override public function onSubStateOpenBegin(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onSubStateOpenBegin(event);
    }

    override public function onSubStateCloseEnd(event:Dynamic) {
        if (!active) return;
        for (el in elements) el.onSubStateCloseEnd(event);
    }

    override public function onDestroy(event:Dynamic) {
        destroyElements();
    }
}
