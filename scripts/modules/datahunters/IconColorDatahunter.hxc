package kassettehud.util;

import kassettehud.util.KassetteHUDElement;
import flixel.util.FlxColor;
import funkin.util.ReflectUtil;
import flixel.FlxG;
import flixel.FlxSprite;
import StringTools;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.Paths;
import funkin.play.PlayState;

class IconColorDatahunter extends KassetteHUDDatahunter {
    public var iconColorCache:Dynamic;
    public var isMobileMode:Bool = false;
    
    public var cachedP1Scale:Float = 1.0;
    public var cachedP2Scale:Float = 1.0;
    public var cachedP1Bop:Int = 4;
    public var cachedP2Bop:Int = 4;

    public function new() {
        super("IconColorDatahunter");
        KassetteHUDDatahunter.icon = this;
        isMobileMode = FlxG.onMobile;
        
        if (ReflectUtil.hasField(FlxG, "kssIconColorCache")) {
            iconColorCache = ReflectUtil.field(FlxG, "kssIconColorCache");
        } else {
            iconColorCache = {};
            ReflectUtil.setField(FlxG, "kssIconColorCache", iconColorCache);
        }
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        // Nothing here yet
    }

    override public function onCountdownStart(event:ScriptEvent) {
        updateIconCache();
    }

    public function updateIconCache():Void {
        var state = PlayState.instance;
        if (state == null) return;

        if (state.iconP1 != null) {
            var prop1 = state.iconP1?.bopEvery;
            if (prop1 != null) cachedP1Bop = prop1;
            else cachedP1Bop = 4;

            var scale1:Float = 1.0;
            var isPixel1 = state.iconP1?.isPixelIcon;
            if (isPixel1 == true) scale1 = 5.0;
            else if (state.iconP1.antialiasing == false) scale1 = 5.0;
            cachedP1Scale = scale1;
            
            var p1Id = "generic_p1";
            if (state.iconP1.characterId != null) p1Id = Std.string(state.iconP1.characterId);
            if (!ReflectUtil.hasField(iconColorCache, p1Id)) extractIconColor(state.iconP1, true, p1Id);
        }

        if (state.iconP2 != null) {
            var prop2 = state.iconP2?.bopEvery;
            if (prop2 != null) cachedP2Bop = prop2;
            else cachedP2Bop = 4;

            var scale2:Float = 1.0;
            var isPixel2 = state.iconP2?.isPixelIcon;
            if (isPixel2 == true) scale2 = 5.0;
            else if (state.iconP2.antialiasing == false) scale2 = 5.0;
            cachedP2Scale = scale2;
            
            var p2Id = "generic_p2";
            if (state.iconP2.characterId != null) p2Id = Std.string(state.iconP2.characterId);
            if (!ReflectUtil.hasField(iconColorCache, p2Id)) extractIconColor(state.iconP2, false, p2Id);
        }
    }

    public function getIconColor(iconId:String, defaultColor:Int, isPlayer:Bool = false):Int {
        if (iconId != null && iconId != "" && iconId != "generic_p1" && iconId != "generic_p2") {
            if (ReflectUtil.hasField(iconColorCache, iconId)) {
                return ReflectUtil.field(iconColorCache, iconId);
            }
        }
        return defaultColor;
    }

    public function preCacheIconColor(iconId:String, isPlayer:Bool = false):Void {
        if (iconId == null || iconId == "" || iconId == "generic_p1" || iconId == "generic_p2") return;
        if (ReflectUtil.hasField(iconColorCache, iconId)) return;

        var graphic = null;
        graphic = Paths.image('icons/' + iconId);
        if (graphic == null) {
            graphic = Paths.image('icons/icon-' + iconId);
        }

        if (graphic != null) {
            var tempIcon = new flixel.FlxSprite().loadGraphic(graphic);
            extractIconColor(tempIcon, isPlayer, iconId);
            tempIcon.destroy();
        }
    }

    public function extractIconColor(icon:Dynamic, isPlayer:Bool = false, iconId:String = null):Int {

        var isCacheable = (iconId != null && iconId != "" && iconId != "generic_p1" && iconId != "generic_p2");
        var fallbackColor:Int = isPlayer ? 0xFF66FF33 : 0xFFFF0000;

        if (isCacheable) {
            if (ReflectUtil.hasField(iconColorCache, iconId)) {
                return ReflectUtil.field(iconColorCache, iconId);
            }
        }

        if (icon == null) {
            if (isCacheable) ReflectUtil.setField(iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var bitmap = null;
        if (icon.pixels != null) bitmap = icon.pixels;
        if (bitmap == null) {
            if (icon.graphic != null && icon.graphic.bitmap != null) bitmap = icon.graphic.bitmap;
        }
        
        if (bitmap == null) {
            if (isCacheable) ReflectUtil.setField(iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var bWidth:Int = 150;
        var bHeight:Int = 150;
        if (bitmap.width != null) bWidth = Std.int(bitmap.width);
        if (bitmap.height != null) bHeight = Std.int(bitmap.height);
        
        var w:Int = bWidth > 150 ? 150 : bWidth;
        var h:Int = bHeight > 150 ? 150 : bHeight;
        
        var detail:Int = isMobileMode ? 12 : 4;
        var frequency:Map<Int, Int> = [-1 => 0];
        frequency.remove(-1);
        var bestColor:Int = fallbackColor;
        var maxFreq:Int = 0;
        
        var x:Int = 0;
        while (x < w) {
            var y:Int = 0;
            while (y < h) {
                var pixel32:Int = bitmap.getPixel32(x, y);
                var alpha:Int = (pixel32 >> 24) & 0xFF;
                
                if (alpha > 200) {
                    var rgb:Int = pixel32 & 0xFFFFFF;
                    if (rgb != 0x000000 && rgb != 0xFFFFFF && rgb != 0x000001) {
                        var count:Null<Int> = frequency.get(rgb);
                        if (count == null) count = 0;
                        count++;
                        frequency.set(rgb, count);
                        if (count > maxFreq) {
                            maxFreq = count;
                            bestColor = rgb;
                        }
                    }
                }
                y += detail;
            }
            x += detail;
        }
        
        if (maxFreq == 0) {
            if (isCacheable) ReflectUtil.setField(iconColorCache, iconId, fallbackColor);
            return fallbackColor;
        }
        
        var finalColor = 0xFF000000 | bestColor;
        
        if (isCacheable) {
            ReflectUtil.setField(iconColorCache, iconId, finalColor);
        }

        return finalColor;
    }

    public function applyHealthBarColors(bar:Dynamic, isSolo:Bool, p1Color:Int, p2Color:Int):Void {
        if (bar == null) return;

        if (isSolo) {
            bar.createFilledBar(0xFF000000, p1Color);
        } else {
            var directionStr = Std.string(bar.fillDirection);
            if (directionStr == "LEFT_TO_RIGHT") {
                bar.createFilledBar(p1Color, p2Color);
            } else {
                bar.createFilledBar(p2Color, p1Color);
            }
        }
    }
}
