package kassettehud.util;

import kassettehud.util.KassetteHUDElement;

import openfl.utils.Assets;
import funkin.Paths;
import StringTools;
import Std;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.util.FileUtil;
import funkin.modding.PolymodHandler;

class AssetDatahunter extends KassetteHUDDatahunter {
    public var cachedFontMap:Map<String, String> = null;
    public var cachedResolvedFonts:Map<String, String> = null;
    public var cachedCustomFontPath:String = "";
    public var lastFontKey:String = "";
    public var cachedCustomPixelFontPath:String = "";
    public var lastPixelFontKey:String = "";
    
    public var preloadedAllFonts:Array<Dynamic> = [];
    public var preloadedFamiliesData:Array<Dynamic> = [];
    public var fontsPreloaded:Bool = false;

    public function new() {
        super("AssetDatahunter");
        KassetteHUDDatahunter.asset = this;
        preloadFontsIndex();
    }

    function getModFolders():Array<String> {
        var folders:Array<String> = [];
        try {
            var loadedMods = PolymodHandler.loadedModIds;
            if (loadedMods != null && loadedMods.length > 0) for (mod in loadedMods) folders.push(mod);
        } catch(e:Dynamic) {}

        if (folders.length == 0) {
            try {
                var readMods = FileUtil.readDir("mods");
                if (readMods != null) for (mod in readMods) folders.push(mod);
            } catch(e:Dynamic) {}
        }
        return folders;
    }

    public function getAvailableFonts():Map<String, String> {
        if (cachedFontMap != null) return cachedFontMap;
        
        var fonts:Map<String, String> = [
            "VCR (Default)" => "vcr.ttf",
            "Senpai Pixel (Default)" => "pixel.otf"
        ]; 
        var blacklist = ["vcr.ttf", "pixel.otf", "ds_digii.ttf", "ds_digib.ttf", "ds_digi.ttf", "nokiafc22.ttf", "arial.ttf", "5by7_b.ttf", "consolas.ttf", "quantico_bolditalic.ttf", "quantico_bold.ttf", "quantico_regular.ttf", "inconsolata_semibold.ttf", "inconsolata_bold.ttf", "inconsolata_medium.ttf", "vcr_italic.ttf", "inconsolata_extralight.ttf", "insolata_regular.ttf", "5by7.ttf", "quantico_italic.ttf", "monsterrat.ttf", "vcr_bold.ttf", "vcr_bolditalic.ttf", "incosolata_black.ttf"];

        var files = Assets.list();
        if (files != null) {
            try {
                for (file in files) {
                    var f = file.toLowerCase();
                    var normalizedFile = StringTools.replace(f, "\\", "/");
                    if (normalizedFile.indexOf("fonts/") != -1 && (StringTools.endsWith(normalizedFile, ".ttf") || StringTools.endsWith(normalizedFile, ".otf"))) {
                        var normalizedPath = StringTools.replace(file, "\\", "/");
                        var slashIdx = normalizedPath.lastIndexOf("/");
                        var fileName = slashIdx == -1 ? normalizedPath : normalizedPath.substr(slashIdx + 1);
                        if (blacklist.indexOf(fileName.toLowerCase()) == -1) {
                            fonts.set(fileName, fileName);
                        }
                    }
                }
            } catch(e:Dynamic) {}
        }
        
        for (folder in getModFolders()) {
            var path = "mods/" + folder + "/fonts";
            try {
                var dirFiles = FileUtil.readDir(path);
                if (dirFiles != null) {
                    for (file in dirFiles) {
                        var f = file.toLowerCase();
                        if (StringTools.endsWith(f, ".ttf") || StringTools.endsWith(f, ".otf")) {
                            if (blacklist.indexOf(f) == -1) {
                                fonts.set(file, file); 
                            }
                        }
                    }
                }
            } catch(e:Dynamic) {}
        }

        cachedFontMap = fonts;
        return fonts;
    }

    public function resolveCustomFont(fontKey:String):String {
        if (fontKey == "vcr.ttf" || fontKey == "VCR OSD Mono" || fontKey == "null" || fontKey == "") return "VCR OSD Mono";
        if (fontKey == "pixel.otf" || fontKey == "Pixel Arial 11" || fontKey == "Senpai Pixel (Default)") return Paths.font("pixel.otf");
        if (cachedResolvedFonts == null) {
            cachedResolvedFonts = ["__dummy__" => ""];
            cachedResolvedFonts.remove("__dummy__");
        }
        if (cachedResolvedFonts.exists(fontKey)) return cachedResolvedFonts.get(fontKey);
        
        var foundPath:String = ""; 
        var files = Assets.list();
        if (files != null) {
            try {
                for (file in files) {
                    var f = file.toLowerCase();
                    var normalizedFile = StringTools.replace(f, "\\", "/");
                    if (normalizedFile.indexOf("fonts/") != -1 && StringTools.endsWith(normalizedFile, fontKey.toLowerCase())) {
                        foundPath = file;
                        break;
                    }
                }
            } catch(e:Dynamic) {}
        }

        if (foundPath == "") {
            for (folder in getModFolders()) {
                if (foundPath != "") break; 
                var path = "mods/" + folder + "/fonts";
                try {
                    var dirFiles = FileUtil.readDir(path);
                    if (dirFiles != null) {
                        for (f in dirFiles) {
                            if (f.toLowerCase() == fontKey.toLowerCase()) {
                                foundPath = "mods/" + folder + "/fonts/" + f;
                                break;
                            }
                        }
                    }
                } catch(e:Dynamic) {}
            }
        }
        
        if (foundPath == "") foundPath = "VCR OSD Mono";
        cachedResolvedFonts.set(fontKey, foundPath);
        return foundPath;
    }

    public function preloadFontsIndex():Void {
        if (fontsPreloaded) return;
        var fontMap:Dynamic = getAvailableFonts();
        
        if (fontMap != null) {
            var keys:Array<String> = [];
            var kIter = fontMap.keys();
            for (k in kIter) keys.push(Std.string(k));
            
            var allFonts:Array<Dynamic> = [];
            var variantParts = ["-bold", "-italic", "-regular", "-light", "-medium", "-semibold", "-black", "_bold", "_italic", "_regular", " bold", " italic", " regular"];
            for (k in keys) {
                var fFile = fontMap.get(k);
                var fPath = "VCR OSD Mono";
                fPath = resolveCustomFont(fFile);

                var rawName = k;
                var lowerK = k.toLowerCase();
                if (StringTools.endsWith(lowerK, ".ttf") || StringTools.endsWith(lowerK, ".otf")) {
                    rawName = k.substr(0, k.length - 4);
                }

                var familyRaw = rawName;
                var rawLower = rawName.toLowerCase();
                var variantName = "Regular";
                
                for (v in variantParts) {
                    var vIdx = rawLower.lastIndexOf(v);
                    if (vIdx != -1 && vIdx > 0) {
                        familyRaw = rawName.substr(0, vIdx);
                        var vRaw = rawName.substr(vIdx + 1);
                        var cleanV = "";
                        for (i in 0...vRaw.length) {
                            var char = vRaw.charAt(i);
                            if (char != "-" && char != "_" && char != " ") cleanV += char;
                        }
                        if (cleanV.length > 0) {
                            variantName = cleanV.substr(0,1).toUpperCase() + cleanV.substr(1);
                        } else {
                            variantName = vRaw;
                        }
                        break;
                    }
                }

                if (familyRaw.toLowerCase() == "vcr" || k == "VCR (Default)") { familyRaw = "VCR OSD Mono"; variantName = "Default"; }
                if (familyRaw.toLowerCase() == "pixel" || k == "Senpai Pixel (Default)") { familyRaw = "Senpai Pixel"; variantName = "Default"; }

                allFonts.push({
                    key: k,
                    file: fFile,
                    path: fPath,
                    family: familyRaw,
                    variant: variantName
                });
            }

            var familiesData:Array<Dynamic> = [];
            for (f in allFonts) {
                var fam = f.family;
                var found = false;
                for (fd in familiesData) {
                    if (fd.name == fam) {
                        fd.variants.push(f);
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    familiesData.push({name: fam, variants: [f]});
                }
            }

            familiesData.sort(function(a:Dynamic, b:Dynamic):Int {
                var nameA:String = a.name.toLowerCase();
                var nameB:String = b.name.toLowerCase();
                if (nameA < nameB) return -1;
                if (nameA > nameB) return 1;
                return 0;
            });
            
            preloadedAllFonts = allFonts;
            preloadedFamiliesData = familiesData;
        }
        fontsPreloaded = true;
    }
}
