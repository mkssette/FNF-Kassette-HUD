package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.Preferences;
import funkin.Paths;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.play.components.HealthIcon;
import funkin.play.notes.Strumline;
import funkin.play.notes.NoteSprite;
import funkin.util.Constants;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.FlxCamera;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import Std;
import Math;

import StringTools;
import funkin.ui.FullScreenScaleMode;
import funkin.Conductor;

class KssetteHUDPreview extends Module {
    public var isPreview:Bool = false;
    public var previewCam:FlxCamera = null;
    var apiModule:Dynamic = null;

    var playerStrumPreview:Strumline;
    var opponentStrumPreview:Strumline;
    
    var healthBarBG:FlxSprite;
    var healthBarFillP1:FlxSprite;
    var healthBarFillP2:FlxSprite;
    var iconP1:HealthIcon;
    var iconP2:HealthIcon;

    var bopTimer:Float = 0.0;
    var cachedActive:Bool = true;

    var previewInTween:FlxTween = null;
    var previewOutTween:FlxTween = null;

    var fakeNotes:Array<FlxSprite> = [];
    var noteTimer:Float = 0.0;
    var targetNoteDelay:Float = 2.0;
    var ghostTimer:Float = 0.0;
    var targetGhostDelay:Float = 3.0;
    var noteCount:Int = 0;
    var playerTurn:Bool = true;
    
    var bfIdleTimer:Float = 0.0;
    var dadIdleTimer:Float = 0.0;
    var isArrowsScheme:Bool = false;
    var canSpawnOpp:Bool = true;

    public function new() {
        super("KssetteHUDPreview");
    }

    function killObj(obj:Dynamic) {
        if (obj == null) return;
        FlxG.state.remove(obj);
        obj?.destroy();
    }

    function cancelStrum(strum:Dynamic) {
        if (strum == null || !strum.exists) return;
        if (strum.strumlineNotes != null) {
            for (note in strum.strumlineNotes) {
                if (note != null && note.exists) FlxTween.cancelTweensOf(note);
            }
        }
        FlxTween.cancelTweensOf(strum);
    }

    public function cancelStrumTweens() {
        if (previewInTween != null) {
            previewInTween?.cancel();
            previewInTween = null;
        }
        if (previewOutTween != null) {
            previewOutTween?.cancel();
            previewOutTween = null;
        }
        cancelStrum(playerStrumPreview);
        cancelStrum(opponentStrumPreview);
    }

    public function cleanUp() {
        cancelStrumTweens();

        killObj(playerStrumPreview);
        killObj(opponentStrumPreview);
        killObj(healthBarBG);
        killObj(healthBarFillP1);
        killObj(healthBarFillP2);
        killObj(iconP1);
        killObj(iconP2);
        
        for (note in fakeNotes) {
            killObj(note);
        }
        fakeNotes = [];

        playerStrumPreview = null;
        opponentStrumPreview = null;
        healthBarBG = null;
        healthBarFillP1 = null;
        healthBarFillP2 = null;
        iconP1 = null;
        iconP2 = null;
    }

    override public function onStateChangeStart(event:Dynamic) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanUp();
    }

    public function setupUI(cam:FlxCamera) {
        cleanUp();

        healthBarBG = new FlxSprite(0, FlxG.height * 0.89);
        try {
            healthBarBG.loadGraphic(Paths.image('healthBar'));
        } catch(e:Dynamic) {
            healthBarBG.makeGraphic(601, 19, 0xFF000000);
        }
        healthBarBG.screenCenter(0x01);
        healthBarBG.scrollFactor.set(0, 0);
        healthBarBG.cameras = [cam];
        healthBarBG.zIndex = 110;
        FlxG.state.add(healthBarBG);

        var fw = Std.int((healthBarBG.width - 8) / 2);
        var fh = Std.int(healthBarBG.height - 8);

        healthBarFillP2 = new FlxSprite(healthBarBG.x + 4, healthBarBG.y + 4).makeGraphic(fw, fh, 0xFFFFFFFF);
        healthBarFillP2.color = 0xFFFF0000;
        healthBarFillP2.scrollFactor.set(0, 0);
        healthBarFillP2.cameras = [cam];
        healthBarFillP2.zIndex = 111;
        FlxG.state.add(healthBarFillP2);

        healthBarFillP1 = new FlxSprite(healthBarBG.x + 4 + fw, healthBarBG.y + 4).makeGraphic(fw, fh, 0xFFFFFFFF);
        healthBarFillP1.color = 0xFF66FF33;
        healthBarFillP1.scrollFactor.set(0, 0);
        healthBarFillP1.cameras = [cam];
        healthBarFillP1.zIndex = 111;
        FlxG.state.add(healthBarFillP1);

        iconP1 = new HealthIcon('bf', true);
        iconP1.autoUpdate = false;
        try {
            iconP1.loadGraphic(Paths.image('icons/icon-bf'), true, 150, 150);
            iconP1.animation.add('icon', [0, 1], 0, false, true);
            iconP1.animation.play('icon');
        } catch(e:Dynamic) {}
        iconP1.cameras = [cam];
        iconP1.scrollFactor.set(0, 0);
        iconP1.zIndex = 112;
        FlxG.state.add(iconP1);

        iconP2 = new HealthIcon('dad', false);
        iconP2.autoUpdate = false;
        try {
            iconP2.loadGraphic(Paths.image('icons/icon-dad'), true, 150, 150);
            iconP2.animation.add('icon', [0, 1], 0, false, false);
            iconP2.animation.play('icon');
        } catch(e:Dynamic) {}
        iconP2.cameras = [cam];
        iconP2.scrollFactor.set(0, 0);
        iconP2.zIndex = 112;
        FlxG.state.add(iconP2);
    }

    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        
        apiModule = ModuleHandler.getModule("KssetteApi");
        
        setupUI(cam);
        updatePreview();
    }

    public function updatePreview() {
        if (!isPreview || healthBarBG == null || !healthBarBG.exists) return;
        
        if (apiModule == null) apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;

        var isMob = false;
        var isMobPC = false;
        try {
            if (apiModule != null) {
                isMob = apiModule.isMobileMode == true;
                isMobPC = apiModule.isMobileLikePC() == true;
            }
        } catch(e:Dynamic) {}

        isArrowsScheme = false;
        if (isMob && !isMobPC) {
            try {
                if (Std.string(Preferences.controlsScheme) == "Arrows") isArrowsScheme = true;
            } catch(e:Dynamic) {}
            if (!isArrowsScheme) {
                try {
                    if (Save.instance?.mobileOptions?.controlsScheme != null) {
                        if (Std.string(Save.instance.mobileOptions.controlsScheme) == "Arrows") isArrowsScheme = true;
                    }
                } catch(e:Dynamic) {}
            }
        }

        var downscroll = false;
        if (apiModule != null && apiModule.getDownscroll != null) downscroll = apiModule.getDownscroll();
        else downscroll = Preferences.downscroll;
        
        var rawMs:Dynamic = apiModule.getKssValue("kssette_middlescroll");
        var ms:String = "";
        if (rawMs == true) ms = "On";
        else if (rawMs == false) ms = "Off";
        else ms = Std.string(rawMs);
        
        var oppPos = Std.string(apiModule.getKssValue("kssette_opponent_pos"));
        var coloredHB = apiModule.getKssValue("kssette_colored_healthbar") == true;

        var strumYOffset = 50.0;
        try { strumYOffset = Constants.STRUMLINE_Y_OFFSET; } catch(e:Dynamic) {}

        var targetY = downscroll ? FlxG.height - 150.0 : strumYOffset;
        var startY = downscroll ? targetY + 300.0 : targetY - 300.0;
        var currentY:Float = (playerStrumPreview != null && playerStrumPreview.exists) ? playerStrumPreview.y : startY;

        cancelStrumTweens();

        if (playerStrumPreview != null) {
            killObj(playerStrumPreview);
            playerStrumPreview = null;
        }
        if (opponentStrumPreview != null) {
            killObj(opponentStrumPreview);
            opponentStrumPreview = null;
        }

        var noteStyle = NoteStyleRegistry.instance.fetchDefault();

        var hideOpp = Std.string(apiModule.getKssValue("kssette_hide_opponent")) == "On" || Std.string(apiModule.getKssValue("kssette_hide_opponent")) == "true";
        var showOpp = (ms != "Hidden Notes") && !(ms == "Off" && hideOpp);
        if (showOpp) {
            opponentStrumPreview = new Strumline(noteStyle, false);
            opponentStrumPreview.cameras = [previewCam];
            opponentStrumPreview.scrollFactor.set(0, 0);
            opponentStrumPreview.zIndex = 10;
            var obg = opponentStrumPreview?.background; if (obg != null) obg.visible = false;
            
            var oppAlphaVal = 1.0;
            var rawOppOp:Dynamic = apiModule.getKssValue("kssette_opponent_opacity");
            if (rawOppOp != null) {
                var valStr = StringTools.replace(Std.string(rawOppOp), "%", "");
                var valNum = Std.parseFloat(valStr);
                if (!Math.isNaN(valNum)) oppAlphaVal = valNum / 100.0;
            }
            opponentStrumPreview.alpha = oppAlphaVal;
            
            FlxG.state.add(opponentStrumPreview);
        }

        playerStrumPreview = new Strumline(noteStyle, true);
        playerStrumPreview.cameras = [previewCam];
        playerStrumPreview.scrollFactor.set(0, 0);
        playerStrumPreview.zIndex = 10;
        var pbg = playerStrumPreview?.background; if (pbg != null) pbg.visible = false;
        FlxG.state.add(playerStrumPreview);

        var halfW = FlxG.width / 2.0;
        var cutoutSize = FullScreenScaleMode.gameCutoutSize?.x != null ? FullScreenScaleMode.gameCutoutSize.x / 2.5 : 0.0;

        var msOn = (ms != "Off" && ms != "null" && ms != "");
        var pStyle = (ms == "P Style");
        var isGlass = (ms == "Glass");
        var sxOff = Constants.STRUMLINE_X_OFFSET != null ? Constants.STRUMLINE_X_OFFSET : 50.0;
        
        var oppNotesActive = apiModule.getKssValue("kssette_mobile_opp_notes") == true;

        if (isArrowsScheme) {
            playerStrumPreview.x = 0;
            var pNotes:Array<Dynamic> = null;
            try { pNotes = playerStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
            
            if (pNotes != null) {
                var hintW = 146.0;
                var space = 80.0;
                var stX = Math.floor((FlxG.width - ((hintW + space) * 4.0)) / 2.0);
                
                for (i in 0...pNotes.length) {
                    var n = pNotes[i];
                    if (n != null && n.exists) {
                        var hCx = stX + (i * hintW) + (space * i) + (hintW / 2.0);
                        n.x = hCx - (n.width / 2.0);
                    }
                }
            }
            
            
            if (opponentStrumPreview != null && opponentStrumPreview.exists) {
                opponentStrumPreview.x = 0; 
                var oppReceptors:Array<Dynamic> = null;
                try { oppReceptors = opponentStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
                
                if (oppReceptors != null && oppReceptors.length >= 4) {
                    var defScale:Float = 0.7;
                    try { defScale = noteStyle.getStrumlineScale(); } catch(e:Dynamic) {}
                    var noteSpace = 112.0;
                    var sizeRatio = 0.55; 
                    var targetSpacing = noteSpace * sizeRatio;
                    
                    for (i in 0...4) {
                        var rec = oppReceptors[i];
                        if (rec != null && rec.exists) {
                            rec.scale.set(defScale * sizeRatio, defScale * sizeRatio);
                            rec.updateHitbox();
                            rec.alpha = 1.0;
                        }
                    }
                    
                    var compactStartX:Float = 10.0 + cutoutSize;
                    for (i in 0...4) {
                        var rec = oppReceptors[i];
                        if (rec != null && rec.exists) {
                            rec.x = compactStartX + (targetSpacing * i);
                        }
                    }
                }
            }
        } else {
            if (msOn) {
                playerStrumPreview.x = (FlxG.width - playerStrumPreview.width) / 2.0;
            } else {
                playerStrumPreview.x = (halfW + sxOff) + (cutoutSize / 2.0);
            }

            if (showOpp && opponentStrumPreview != null && opponentStrumPreview.exists) {
                if (!msOn) {
                    opponentStrumPreview.x = sxOff + cutoutSize;
                } else {
                    opponentStrumPreview.x = 0; 
                    
                    var oppReceptors:Array<Dynamic> = null;
                    try { oppReceptors = opponentStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
                    
                    if (oppReceptors != null && oppReceptors.length >= 4) {
                        var defScale:Float = 0.7;
                        try { defScale = noteStyle.getStrumlineScale(); } catch(e:Dynamic) {}

                        var noteSpace = 112.0;
                        var nw = (oppReceptors[0] != null && oppReceptors[0].exists) ? oppReceptors[0].width : noteSpace;
                        
                        if (pStyle) {
                            for (rec in oppReceptors) {
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale, defScale);
                                    rec.updateHitbox();
                                    rec.alpha = 0.6 * opponentStrumPreview.alpha;
                                }
                            }
                            
                            if (oppReceptors[0] != null && oppReceptors[0].exists) oppReceptors[0].x = sxOff;
                            if (oppReceptors[1] != null && oppReceptors[1].exists) oppReceptors[1].x = sxOff + noteSpace;
                            if (oppReceptors[3] != null && oppReceptors[3].exists) oppReceptors[3].x = FlxG.width - sxOff - nw;
                            if (oppReceptors[2] != null && oppReceptors[2].exists) oppReceptors[2].x = FlxG.width - sxOff - nw - noteSpace;
                            
                        } else if (isGlass) {
                            var compactStartX:Float = playerStrumPreview.x;
                            
                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale, defScale);
                                    rec.updateHitbox();
                                    rec.alpha = 0.7;
                                    rec.color = 0xFFAEAEAE;
                                    rec.x = compactStartX + (112.0 * i);
                                }
                            }
                        } else if (ms == "On" || ms == "Like Mobile" || (isArrowsScheme && ms == "Off")) {
                            var sizeRatio = 0.65;
                            if (ms == "Like Mobile" || (isArrowsScheme && ms == "Off")) sizeRatio = 0.55;
                            var targetSpacing = noteSpace * sizeRatio;
                            var actualNw = 0.0;

                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale * sizeRatio, defScale * sizeRatio);
                                    rec.updateHitbox();
                                    rec.alpha = 1.0 * opponentStrumPreview.alpha;
                                    if (i == 0) actualNw = rec.width;
                                }
                            }

                            var exactTotalWidth = (targetSpacing * 3) + actualNw;
                            var compactStartX:Float = sxOff;
                            if (ms == "Like Mobile") compactStartX = 10.0;
                            
                            if (ms != "Like Mobile" && oppPos == "Right" && !(isArrowsScheme && ms == "Off")) {
                                compactStartX = FlxG.width - sxOff - exactTotalWidth;
                            }

                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.x = compactStartX + (targetSpacing * i);
                                }
                            }
                        }
                    }
                }
            }
        }

        playerStrumPreview.y = currentY;
        if (opponentStrumPreview != null && opponentStrumPreview.exists) {
            if (ms == "Like Mobile" || isArrowsScheme) opponentStrumPreview.y = 50;
            else opponentStrumPreview.y = currentY;
        }

        previewInTween = FlxTween.tween(playerStrumPreview, {y: targetY}, 0.3, {ease: FlxEase.cubeOut});
        if (opponentStrumPreview != null && opponentStrumPreview.exists && opponentStrumPreview.visible) {
            var oppTargetY = targetY;
            if (ms == "Like Mobile" || isArrowsScheme) oppTargetY = 50;
            previewOutTween = FlxTween.tween(opponentStrumPreview, {y: oppTargetY}, 0.3, {ease: FlxEase.cubeOut});
        }

        cachedActive = apiModule.getKssValue("kssette_show_hud") == true;
        healthBarBG.visible = cachedActive;
        if (healthBarFillP1 != null && healthBarFillP1.exists) healthBarFillP1.visible = cachedActive;
        if (healthBarFillP2 != null && healthBarFillP2.exists) healthBarFillP2.visible = cachedActive;
        if (iconP1 != null && iconP1.exists) iconP1.visible = cachedActive;
        if (iconP2 != null && iconP2.exists) iconP2.visible = cachedActive;

        var hbY = downscroll ? FlxG.height * 0.11 : FlxG.height * 0.89;
        healthBarBG.y = hbY;
        if (healthBarFillP1 != null && healthBarFillP1.exists) healthBarFillP1.y = hbY + 4;
        if (healthBarFillP2 != null && healthBarFillP2.exists) healthBarFillP2.y = hbY + 4;

        var p1Color = 0xFF66FF33; 
        var p2Color = 0xFFFF0000;
        
        if (coloredHB) {
            p1Color = 0xFF31B0D1; 
            p2Color = 0xFFAF66CE; 
        }

        if (healthBarFillP1 != null && healthBarFillP1.exists) healthBarFillP1.color = p1Color;
        if (healthBarFillP2 != null && healthBarFillP2.exists) healthBarFillP2.color = p2Color;
    }

    function spawnFakeNote() {
        if (!isPreview || playerStrumPreview == null) return;
        
        var ms = "";
        var oppNotesActive = false;
        var isMob = false;
        var isMobPC = false;
        try {
            if (apiModule != null) {
                var rawMs:Dynamic = apiModule.getKssValue("kssette_middlescroll");
                if (rawMs == true) ms = "On";
                else if (rawMs == false) ms = "Off";
                else ms = Std.string(rawMs);
                
                oppNotesActive = apiModule.getKssValue("kssette_mobile_opp_notes") == true;
                isMob = apiModule.isMobileMode == true;
                isMobPC = apiModule.isMobileLikePC() == true;
            }
        } catch(e:Dynamic) {}

        var isPlayer = true;
        canSpawnOpp = true;
        if (opponentStrumPreview != null && opponentStrumPreview.exists) {
            if (ms == "Like Mobile" || (isArrowsScheme && !oppNotesActive)) {
                canSpawnOpp = false;
            }
        }
        
        noteCount++;
        if (noteCount > 4) {
            noteCount = 1;
            playerTurn = !playerTurn;
        }
        
        isPlayer = playerTurn;
        
        var strum = isPlayer ? playerStrumPreview : opponentStrumPreview;
        var pNotes = null;
        try { pNotes = strum.strumlineNotes.members; } catch(e:Dynamic) {}
        if (pNotes == null || pNotes.length < 4) return;
        
        var dir = Std.random(4);
        var rec = pNotes[dir];
        if (rec == null || !rec.exists) return;
        
        var downscroll = false;
        if (apiModule != null && apiModule.getDownscroll != null) downscroll = apiModule.getDownscroll();
        
        var style = NoteStyleRegistry.instance.fetchDefault();
        var fake = new NoteSprite(style, dir);
        fake.direction = dir; 
        
        fake.scale.set(rec.scale.x, rec.scale.y);
        fake.updateHitbox();
        
        fake.x = rec.x + (rec.width - fake.width) / 2.0;
        
        var isOpponentUpscroll = (!isPlayer && (ms == "Like Mobile" || isArrowsScheme));
        var useDownscroll = isOpponentUpscroll ? false : downscroll;
        
        fake.y = useDownscroll ? -100 : FlxG.height + 100;
        fake.cameras = [previewCam];
        fake.zIndex = 9;
        fake.ID = dir;
        fake.health = isPlayer ? 1 : 0;
        fake.alpha = 0.8;
        
        var ms = Std.string(apiModule.getKssValue("kssette_middlescroll"));
        if (!isPlayer && ms == "Glass") {
            fake.alpha = 0.25;
            fake.color = 0xFF666666;
        }
        
        if (!isPlayer && !canSpawnOpp) {
            fake.visible = false;
        }
        
        var targetY = rec.y;
        var fallTime = 2.5;
        
        var isPlayerNote = isPlayer;
        FlxTween.tween(fake, {y: targetY}, fallTime, {ease: FlxEase.linear, onComplete: function(t) {
            if (strum != null && strum.exists && fake.visible) {
                try {
                    strum.playConfirm(dir);
                    new flixel.util.FlxTimer().start(0.15, function(tmr) {
                        if (strum != null && strum.exists) strum.playStatic(dir);
                    });
                } catch(e:Dynamic) {}
            }
            
            try {
                var char = isPlayerNote ? apiModule.preview_bf : apiModule.preview_dad;
                if (char != null) {
                    char.playSingAnimation(dir, false, "");
                    char.holdTimer = 0.0;
                    
                    var strum = isPlayerNote ? playerStrumPreview : opponentStrumPreview;
                    if (strum != null && strum.exists) {
                        try {
                            var rec = strum.strumlineNotes.members[dir];
                            if (rec != null && rec.exists) {
                                rec.playConfirm();
                                rec.confirmHoldTimer = 0.0;
                            }
                        } catch(e:Dynamic) {}
                    }
                    
                    if (isPlayerNote) {
                        bfIdleTimer = 0.6;
                        try { 
                            apiModule.preview_scoreBopTrigger = true;
                            apiModule.preview_simulatedAcc += 25.0;
                            if (apiModule.preview_simulatedAcc > 100.0) apiModule.preview_simulatedAcc = 100.0;
                        } catch(e:Dynamic) {}
                    }
                    else {
                        dadIdleTimer = 0.6;
                        try {
                            apiModule.preview_simulatedAcc = 0.0;
                        } catch(e:Dynamic) {}
                    }
                }
            } catch(e:Dynamic) {}
            
            if (fakeNotes.indexOf(fake) != -1) fakeNotes.remove(fake);
            killObj(fake);
        }});
        fakeNotes.push(fake);
        FlxG.state.add(fake);
    }

    function spawnGhostTap() {
        if (apiModule == null || apiModule.preview_bf == null) return;
        var char = apiModule.preview_bf;
        var dir = Std.random(4);
        
        var ghostTapping = Std.string(apiModule.getKssValue("kssette_ghost_tapping"));
        var ghostSing = Std.string(apiModule.getKssValue("kssette_ghost_sing"));
        
        if (playerStrumPreview != null && playerStrumPreview.exists) {
            try {
                var rec = playerStrumPreview.strumlineNotes.members[dir];
                if (rec != null && rec.exists) {
                    rec.playPress();
                    rec.confirmHoldTimer = 0.0;
                }
            } catch(e:Dynamic) {}
        }
        
        var isMiss = false;
        if (ghostTapping == "Off" || ghostTapping == "false") {
            isMiss = true;
        } else if (ghostTapping == "In Breaks") {
            var hasPlayerNotes = false;
            for (n in fakeNotes) {
                if (n != null && n.exists && n.health == 1) {
                    hasPlayerNotes = true;
                    break;
                }
            }
            if (hasPlayerNotes) isMiss = true;
        }
        
        if (isMiss) {
            try {
                char.playSingAnimation(dir, true, "");
                bfIdleTimer = 0.6;
                apiModule.preview_simulatedAcc = 0.0;
                apiModule.preview_scoreBopTrigger = true; 
            } catch(e:Dynamic) {}
        } else {
            if (ghostSing == "On" || ghostSing == "true") {
                try {
                    char.playSingAnimation(dir, false, "");
                    bfIdleTimer = 0.6;
                } catch(e:Dynamic) {}
            }
        }
    }

    override public function onUpdate(event:Dynamic) {

        if (!isPreview) return;

        if (Std.isOfType(FlxG.state, PlayState)) {
            if (FlxG.state.subState == null) {
                isPreview = false;
                cleanUp();
                return;
            }
        }
        
        if (bfIdleTimer > 0) {
            bfIdleTimer -= event.elapsed;
            if (bfIdleTimer <= 0) {
                try { if (apiModule.preview_bf != null) apiModule.preview_bf.dance(true); } catch(e:Dynamic) {}
            }
        }
        if (dadIdleTimer > 0) {
            dadIdleTimer -= event.elapsed;
            if (dadIdleTimer <= 0) {
                try { if (apiModule.preview_dad != null) apiModule.preview_dad.dance(true); } catch(e:Dynamic) {}
            }
        }
        
        var beatDuration:Float = 0.5;
        if (Conductor.instance != null && Conductor.instance.crochet > 0) {
            beatDuration = Conductor.instance.crochet / 1000.0;
        }

        noteTimer += event.elapsed;
        if (noteTimer > targetNoteDelay) {
            noteTimer = 0;
            var beatsToWait = 2 + Std.random(3); // Wait 2, 3, or 4 beats
            targetNoteDelay = beatsToWait * beatDuration;
            spawnFakeNote();
        }
        
        if (apiModule != null) {
            apiModule.preview_playerTurn = playerTurn;
            var prog = ((noteCount - 1) + (noteTimer / targetNoteDelay)) / 4.0;
            if (prog < 0) prog = 0;
            if (prog > 1) prog = 1;
            apiModule.preview_turnProgress = prog;
        }
        
        ghostTimer += event.elapsed;
        if (ghostTimer > targetGhostDelay) {
            ghostTimer = 0;
            var ghostBeatsToWait = 3 + Std.random(5); // Wait 3 to 7 beats
            targetGhostDelay = ghostBeatsToWait * beatDuration;
            spawnGhostTap();
        }
        
        for (note in fakeNotes) {
            if (note != null && note.exists) {
                var isPlayer = note.health == 1;
                var strum = isPlayer ? playerStrumPreview : opponentStrumPreview;
                if (strum != null && strum.exists) {
                    try {
                        var rec = strum.strumlineNotes.members[note.ID];
                        if (rec != null && rec.exists) {
                            note.x = rec.x + (rec.width - note.width) / 2.0;
                            note.alpha = strum.alpha * 0.8;
                        }
                    } catch(e:Dynamic) {}
                }
            }
        }

        if (cachedActive && iconP1 != null && iconP1.exists && iconP2 != null && iconP2.exists && healthBarBG != null && healthBarBG.exists) {
            bopTimer += event.elapsed;
            if (bopTimer >= beatDuration) { 
                bopTimer = 0;
                iconP1.scale.set(1.2, 1.2);
                iconP2.scale.set(1.2, 1.2);
            }
            
            var bopRecover = event.elapsed * 1.5;
            var prevScale = iconP1.scale.x;
            if (iconP1.scale.x > 1.0) iconP1.scale.x -= bopRecover;
            if (iconP1.scale.y > 1.0) iconP1.scale.y -= bopRecover;
            if (iconP1.scale.x < 1.0) iconP1.scale.x = 1.0;
            if (iconP1.scale.y < 1.0) iconP1.scale.y = 1.0;

            iconP2.scale.x = iconP1.scale.x;
            iconP2.scale.y = iconP1.scale.y;

            if (prevScale != iconP1.scale.x) {
                iconP1.updateHitbox();
                iconP2.updateHitbox();
            }

            iconP1.y = healthBarBG.y - (iconP1.height / 2) + 10;
            iconP2.y = healthBarBG.y - (iconP2.height / 2) + 10;
            
            var hw = Std.int((healthBarBG.width - 8) / 2);
            var iconPos = Std.string(apiModule.getKssValue("kssette_icon_pos"));
            if (iconPos == "Corners") {
                var centerY = healthBarBG.y + (healthBarBG.height / 2);
                iconP1.x = healthBarBG.x + healthBarBG.width + 75 - iconP1.width;
                iconP2.x = healthBarBG.x + 75 - iconP2.width;
                iconP1.y = centerY + 75 - iconP1.height;
                iconP2.y = centerY + 75 - iconP2.height;
            } else {
                iconP1.x = healthBarBG.x + hw - 26;
                iconP2.x = healthBarBG.x + hw - (iconP2.width - 26);
            }
        }
    }
}
