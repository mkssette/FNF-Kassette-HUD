
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import funkin.Preferences;
import funkin.Paths;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.play.components.HealthIcon;
import funkin.play.notes.Strumline;
import funkin.play.notes.NoteSprite;
import funkin.util.Constants;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.FlxCamera;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import Std;
import Math;

import StringTools;
import funkin.ui.FullScreenScaleMode;
import funkin.Conductor;

import funkin.ui.ScriptedMusicBeatSubState;

class KssetteHUDPreview extends ScriptedMusicBeatSubState {
    public var isPreview:Bool = false;
    public var previewCam:FlxCamera = null;
    var bgOptionsText:FlxText;

    var playerStrumPreview:Strumline;
    var opponentStrumPreview:Strumline;

    var bopTimer:Float = 0.0;
    var cachedActive:Bool = true;

    var previewInTween:FlxTween = null;
    var previewOutTween:FlxTween = null;

    var fakeNotes:Array<FlxSprite> = [];
    var noteTimer:Float = 0.0;
    var targetNoteDelay:Float = 2.0;
    var ghostTimer:Float = 0.0;
    var elapsedTime:Float = 0.0;
    var targetGhostDelay:Float = 3.0;
    var noteCount:Int = 0;
    var playerTurn:Bool = true;
    
    var bfIdleTimer:Float = 0.0;
    var dadIdleTimer:Float = 0.0;
    var dadDancesCount:Int = 0;
    var isArrowsScheme:Bool = false;
    var canSpawnOpp:Bool = true;
    var cachedNoteStyle:Dynamic = null;

    public function new() {
        super();
        this.persistentUpdate = true;
        this.persistentDraw = true;
    }

    function killObj(obj:Dynamic) {
        if (obj == null) return;
        try {
            FlxG.state.remove(obj, true);
            obj.kill();
        } catch(e:Dynamic) {}
    }

    function cancelStrum(strum:Dynamic) {
        if (strum == null || !strum.exists) return;
        if (strum.strumlineNotes != null) {
            for (note in strum.strumlineNotes) {
                if (note != null && note.exists) FlxTween.cancelTweensOf(note);
            }
        }
        FlxTween.cancelTweensOf(strum);
    }

    public function cancelStrumTweens() {
        if (previewInTween != null) {
            previewInTween?.cancel();
            previewInTween = null;
        }
        if (previewOutTween != null) {
            previewOutTween?.cancel();
            previewOutTween = null;
        }
        cancelStrum(playerStrumPreview);
        cancelStrum(opponentStrumPreview);
    }

    public function cleanUp() {
        cancelStrumTweens();

        killObj(playerStrumPreview);
        killObj(opponentStrumPreview);
        
        for (note in fakeNotes) {
            killObj(note);
        }
        fakeNotes = [];

        playerStrumPreview = null;
        opponentStrumPreview = null;
    }

    override public function onStateChangeStart(event:Dynamic) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanUp();
    }

    public function setupUI(cam:FlxCamera) {
        cleanUp();
    }

    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        
        setupUI(cam);
        updatePreview(0.0);
    }

    public function updatePreview(elapsed:Float) {
        if (!isPreview) { return; }
        
        elapsedTime += elapsed;

        var isMob = false;
        var isMobPC = false;
        try {
            var optManager = KssetteOptionsManager.instance;
            if (optManager != null) {
                isMob = optManager.isMobileMode == true;
                isMobPC = optManager.isMobileLikePC() == true;
            }
        } catch(e:Dynamic) {}

        isArrowsScheme = false;
        if (isMob && !isMobPC) {
            try {
                if (Std.string(Preferences.controlsScheme) == "Arrows") isArrowsScheme = true;
            } catch(e:Dynamic) {}
            if (!isArrowsScheme) {
                try {
                    if (Save.instance?.mobileOptions?.controlsScheme != null) {
                        if (Std.string(Save.instance.mobileOptions.controlsScheme) == "Arrows") isArrowsScheme = true;
                    }
                } catch(e:Dynamic) {}
            }
        }

        var downscroll = false;
        if (KassetteHUDDatahunter.song != null) downscroll = KassetteHUDDatahunter.song.getDownscroll();
        else downscroll = Preferences.downscroll;
        
        var rawMs:Dynamic = KssetteOptionsManager.instance != null ? KssetteOptionsManager.instance.getKssValue("kssette_middlescroll") : null;
        var ms:String = "";
        if (rawMs == true) ms = "On";
        else if (rawMs == false) ms = "Off";
        else ms = Std.string(rawMs);
        
        var oppPos = Std.string(KssetteOptionsManager.instance != null ? KssetteOptionsManager.instance.getKssValue("kssette_opponent_pos") : null);
        var coloredHB = KssetteOptionsManager.instance != null && KssetteOptionsManager.instance.getKssValue("kssette_colored_healthbar") == true;

        var strumYOffset = 50.0;
        try { strumYOffset = Constants.STRUMLINE_Y_OFFSET; } catch(e:Dynamic) {}

        var targetY = downscroll ? FlxG.height - 150.0 : strumYOffset;
        var startY = downscroll ? targetY + 300.0 : targetY - 300.0;
        var currentY:Float = (playerStrumPreview != null && playerStrumPreview.exists) ? playerStrumPreview.y : startY;

        cancelStrumTweens();
        cachedNoteStyle = NoteStyleRegistry.instance.fetchDefault();

        var hideOpp = KssetteOptionsManager.instance != null && (Std.string(KssetteOptionsManager.instance.getKssValue("kssette_hide_opponent")) == "On" || Std.string(KssetteOptionsManager.instance.getKssValue("kssette_hide_opponent")) == "true");
        var showOpp = (ms != "Hidden Notes") && !(ms == "Off" && hideOpp);
        
        if (showOpp) {
            if (opponentStrumPreview == null || !opponentStrumPreview.exists) {
                opponentStrumPreview = new Strumline(cachedNoteStyle, false);
                opponentStrumPreview.cameras = [previewCam];
                opponentStrumPreview.scrollFactor.set(0, 0);
                opponentStrumPreview.zIndex = 10;
                FlxG.state.add(opponentStrumPreview);
            }
            var oppAlphaVal = 1.0;
            var rawOppOp:Dynamic = KssetteOptionsManager.instance != null ? KssetteOptionsManager.instance.getKssValue("kssette_opponent_opacity") : null;
            if (rawOppOp != null) {
                var valStr = StringTools.replace(Std.string(rawOppOp), "%", "");
                var valNum = Std.parseFloat(valStr);
                if (!Math.isNaN(valNum)) oppAlphaVal = valNum / 100.0;
            }
            opponentStrumPreview.alpha = oppAlphaVal;
            opponentStrumPreview.visible = true;
            
            var oppBgOption = KssetteOptionsManager.instance != null && (Std.string(KssetteOptionsManager.instance.getKssValue("kssette_opponent_bg")) == "On" || Std.string(KssetteOptionsManager.instance.getKssValue("kssette_opponent_bg")) == "true");
            var msOn = (ms != "Off" && ms != "null" && ms != "");
            if (msOn) oppBgOption = false; // Disabled on Middle Scroll
            var obg = opponentStrumPreview?.background; if (obg != null) obg.visible = oppBgOption;
        } else {
            if (opponentStrumPreview != null) {
                opponentStrumPreview.visible = false;
            }
        }

        if (playerStrumPreview == null || !playerStrumPreview.exists) {
            playerStrumPreview = new Strumline(cachedNoteStyle, true);
            playerStrumPreview.cameras = [previewCam];
            playerStrumPreview.scrollFactor.set(0, 0);
            playerStrumPreview.zIndex = 10;
            FlxG.state.add(playerStrumPreview);
        }
        var pbg = playerStrumPreview?.background; if (pbg != null) pbg.visible = true;

        var halfW = FlxG.width / 2.0;
        var cutoutSize = FullScreenScaleMode.gameCutoutSize?.x != null ? FullScreenScaleMode.gameCutoutSize.x / 2.5 : 0.0;

        var msOn = (ms != "Off" && ms != "null" && ms != "");
        var pStyle = (ms == "P Style");
        var isGlass = (ms == "Glass");
        var sxOff = Constants.STRUMLINE_X_OFFSET != null ? Constants.STRUMLINE_X_OFFSET : 50.0;
        
        var oppNotesActive = KssetteOptionsManager.instance != null && KssetteOptionsManager.instance.getKssValue("kssette_mobile_opp_notes") == true;

        if (isArrowsScheme) {
            playerStrumPreview.x = 0;
            var pNotes:Array<Dynamic> = null;
            try { pNotes = playerStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
            
            if (pNotes != null) {
                var hintW = 146.0;
                var space = 80.0;
                var stX = Math.floor((FlxG.width - ((hintW + space) * 4.0)) / 2.0);
                
                for (i in 0...pNotes.length) {
                    var n = pNotes[i];
                    if (n != null && n.exists) {
                        var hCx = stX + (i * hintW) + (space * i) + (hintW / 2.0);
                        n.x = hCx - (n.width / 2.0);
                    }
                }
            }
            
            
            if (opponentStrumPreview != null && opponentStrumPreview.exists) {
                opponentStrumPreview.x = 0; 
                var oppReceptors:Array<Dynamic> = null;
                try { oppReceptors = opponentStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
                
                if (oppReceptors != null && oppReceptors.length >= 4) {
                    var defScale:Float = 0.7;
                    try { defScale = noteStyle.getStrumlineScale(); } catch(e:Dynamic) {}
                    var noteSpace = 112.0;
                    var sizeRatio = 0.55; 
                    var targetSpacing = noteSpace * sizeRatio;
                    
                    for (i in 0...4) {
                        var rec = oppReceptors[i];
                        if (rec != null && rec.exists) {
                            rec.scale.set(defScale * sizeRatio, defScale * sizeRatio);
                            rec.updateHitbox();
                            rec.alpha = 1.0;
                        }
                    }
                    
                    var compactStartX:Float = 10.0 + cutoutSize;
                    for (i in 0...4) {
                        var rec = oppReceptors[i];
                        if (rec != null && rec.exists) {
                            rec.x = compactStartX + (targetSpacing * i);
                        }
                    }
                }
            }
        } else {
            if (msOn) {
                playerStrumPreview.x = (FlxG.width - playerStrumPreview.width) / 2.0;
            } else {
                playerStrumPreview.x = (halfW + sxOff) + (cutoutSize / 2.0);
            }

            if (showOpp && opponentStrumPreview != null && opponentStrumPreview.exists) {
                if (!msOn) {
                    opponentStrumPreview.x = sxOff + cutoutSize;
                    
                    var oppReceptors:Array<Dynamic> = null;
                    try { oppReceptors = opponentStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
                    
                    if (oppReceptors != null && oppReceptors.length >= 4) {
                        var defScale:Float = 0.7;
                        try { defScale = noteStyle.getStrumlineScale(); } catch(e:Dynamic) {}
                        
                        var noteSpace = 112.0;
                        for (i in 0...4) {
                            var rec = oppReceptors[i];
                            if (rec != null && rec.exists) {
                                rec.scale.set(defScale, defScale);
                                rec.updateHitbox();
                                rec.alpha = 1.0 * opponentStrumPreview.alpha;
                                rec.color = 0xFFFFFFFF;
                                rec.x = opponentStrumPreview.x + (noteSpace * i);
                            }
                        }
                    }
                } else {
                    opponentStrumPreview.x = 0; 
                    
                    var oppReceptors:Array<Dynamic> = null;
                    try { oppReceptors = opponentStrumPreview.strumlineNotes.members; } catch(e:Dynamic) {}
                    
                    if (oppReceptors != null && oppReceptors.length >= 4) {
                        var defScale:Float = 0.7;
                        try { defScale = noteStyle.getStrumlineScale(); } catch(e:Dynamic) {}

                        var noteSpace = 112.0;
                        var nw = (oppReceptors[0] != null && oppReceptors[0].exists) ? oppReceptors[0].width : noteSpace;
                        
                        if (pStyle) {
                            for (rec in oppReceptors) {
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale, defScale);
                                    rec.updateHitbox();
                                    rec.alpha = 0.6 * opponentStrumPreview.alpha;
                                }
                            }
                            
                            if (oppReceptors[0] != null && oppReceptors[0].exists) oppReceptors[0].x = sxOff;
                            if (oppReceptors[1] != null && oppReceptors[1].exists) oppReceptors[1].x = sxOff + noteSpace;
                            if (oppReceptors[3] != null && oppReceptors[3].exists) oppReceptors[3].x = FlxG.width - sxOff - nw;
                            if (oppReceptors[2] != null && oppReceptors[2].exists) oppReceptors[2].x = FlxG.width - sxOff - nw - noteSpace;
                            
                        } else if (isGlass) {
                            var compactStartX:Float = playerStrumPreview.x;
                            
                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale, defScale);
                                    rec.updateHitbox();
                                    rec.alpha = 0.7;
                                    rec.color = 0xFFAEAEAE;
                                    rec.x = compactStartX + (112.0 * i);
                                }
                            }
                        } else if (ms == "On" || ms == "Like Mobile" || (isArrowsScheme && ms == "Off")) {
                            var sizeRatio = 0.65;
                            if (ms == "Like Mobile" || (isArrowsScheme && ms == "Off")) sizeRatio = 0.55;
                            var targetSpacing = noteSpace * sizeRatio;
                            var actualNw = 0.0;

                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.scale.set(defScale * sizeRatio, defScale * sizeRatio);
                                    rec.updateHitbox();
                                    rec.alpha = 1.0 * opponentStrumPreview.alpha;
                                    if (i == 0) actualNw = rec.width;
                                }
                            }

                            var exactTotalWidth = (targetSpacing * 3) + actualNw;
                            var compactStartX:Float = sxOff;
                            if (ms == "Like Mobile") compactStartX = 10.0;
                            
                            if (ms != "Like Mobile" && oppPos == "Right" && !(isArrowsScheme && ms == "Off")) {
                                compactStartX = FlxG.width - sxOff - exactTotalWidth;
                            }

                            for (i in 0...4) {
                                var rec = oppReceptors[i];
                                if (rec != null && rec.exists) {
                                    rec.x = compactStartX + (targetSpacing * i);
                                }
                            }
                        }
                    }
                }
            }
        }

        playerStrumPreview.y = currentY;
        if (opponentStrumPreview != null && opponentStrumPreview.exists) {
            if (ms == "Like Mobile" || isArrowsScheme) opponentStrumPreview.y = 50;
            else opponentStrumPreview.y = currentY;
        }

        previewInTween = FlxTween.tween(playerStrumPreview, {y: targetY}, 0.3, {ease: FlxEase.cubeOut});
        if (opponentStrumPreview != null && opponentStrumPreview.exists && opponentStrumPreview.visible) {
            var oppTargetY = targetY;
            if (ms == "Like Mobile" || isArrowsScheme) oppTargetY = 50;
            previewOutTween = FlxTween.tween(opponentStrumPreview, {y: oppTargetY}, 0.3, {ease: FlxEase.cubeOut});
        }

        cachedActive = KssetteOptionsManager.instance != null && KssetteOptionsManager.instance.getKssValue("kssette_show_hud") == true;
    }

    function spawnFakeNote() {
        if (!isPreview || playerStrumPreview == null) return;
        
        var ms = "";
        var oppNotesActive = false;
        var isMob = false;
        var isMobPC = false;
        
        var optManager = KssetteOptionsManager.instance;
        if (optManager != null) {
            var rawMs:Dynamic = optManager.getKssValue("kssette_middlescroll");
            if (rawMs == true) ms = "On";
            else if (rawMs == false) ms = "Off";
            else ms = Std.string(rawMs);
            
            oppNotesActive = optManager.getKssValue("kssette_mobile_opp_notes") == true;
            isMob = optManager.isMobileMode == true;
            isMobPC = optManager.isMobileLikePC() == true;
        }

        var isPlayer = true;
        canSpawnOpp = true;
        if (opponentStrumPreview != null && opponentStrumPreview.exists) {
            if (ms == "Like Mobile" || (isArrowsScheme && !oppNotesActive)) {
                canSpawnOpp = false;
            }
        }
        
        noteCount++;
        if (noteCount > 4) {
            noteCount = 1;
            playerTurn = !playerTurn;
        }
        
        isPlayer = playerTurn;
        
        var strum = isPlayer ? playerStrumPreview : opponentStrumPreview;
        var pNotes = null;
        try { pNotes = strum.strumlineNotes.members; } catch(e:Dynamic) {}
        if (pNotes == null || pNotes.length < 4) return;
        
        var dir = Std.random(4);
        var rec = pNotes[dir];
        if (rec == null || !rec.exists) return;
        
        var downscroll = false;
        if (KassetteHUDDatahunter.song != null) downscroll = KassetteHUDDatahunter.song.getDownscroll();
        
        var style = cachedNoteStyle;
        if (style == null) style = NoteStyleRegistry.instance.fetchDefault();
        var fake = new NoteSprite(style, dir);
        fake.direction = dir; 
        
        fake.scale.set(rec.scale.x, rec.scale.y);
        fake.updateHitbox();
        
        fake.x = rec.x + (rec.width - fake.width) / 2.0;
        
        var isOpponentUpscroll = (!isPlayer && (ms == "Like Mobile" || isArrowsScheme));
        var useDownscroll = isOpponentUpscroll ? false : downscroll;
        
        fake.y = useDownscroll ? -100 : FlxG.height + 100;
        fake.cameras = [previewCam];
        fake.zIndex = 9;
        fake.ID = dir;
        fake.health = isPlayer ? 1 : 0;
        fake.alpha = 0.8;
        
        var ms = Std.string(KssetteOptionsManager.instance != null ? KssetteOptionsManager.instance.getKssValue("kssette_middlescroll") : null);
        if (!isPlayer && ms == "Glass") {
            fake.alpha = 0.25;
            fake.color = 0xFF666666;
        }
        
        if (!isPlayer && !canSpawnOpp) {
            fake.visible = false;
        }
        
        var targetY = rec.y;
        var fallTime = 2.5;
        
        var isPlayerNote = isPlayer;
        var dirStr = ["singLEFT", "singDOWN", "singUP", "singRIGHT"][dir];
        FlxTween.tween(fake, {y: targetY}, fallTime, {ease: FlxEase.linear, onComplete: function(t) {
            if (strum != null && strum.exists && fake.visible) {
                try {
                    strum.playConfirm(dir);
                    new FlxTimer().start(0.15, function(tmr) {
                        if (strum != null && strum.exists) strum.playStatic(dir);
                    });
                } catch(e:Dynamic) {}
            }
            
            try {
                var char = isPlayerNote ? KassetteHUDElement.preview_bf : KassetteHUDElement.preview_dad;
                if (char != null) {
                    try {
                        char.playAnimation(dirStr, true);
                        KassetteHUDElement.preview_scoreBopTrigger = true;
                        KassetteHUDElement.preview_simulatedAcc += 25.0;
                        if (KassetteHUDElement.preview_simulatedAcc > 100.0) KassetteHUDElement.preview_simulatedAcc = 100.0;
                    } catch(e:Dynamic) {}
                }
                else {
                    dadIdleTimer = 0.6;
                    try {
                        KassetteHUDElement.preview_simulatedAcc = 0.0;
                    } catch(e:Dynamic) {}
                }
                
                if (char != null) {
                    var strum = isPlayerNote ? playerStrumPreview : opponentStrumPreview;
                    if (strum != null && strum.exists) {
                        try {
                            var rec = strum.strumlineNotes.members[dir];
                            if (rec != null && rec.exists) {
                                rec.playConfirm();
                                rec.confirmHoldTimer = 0.0;
                            }
                        } catch(e:Dynamic) {}
                    }
                }
            } catch(e:Dynamic) {}
            
            if (fakeNotes.indexOf(fake) != -1) fakeNotes.remove(fake);
            killObj(fake);
        }});
        fakeNotes.push(fake);
        FlxG.state.add(fake);
    }

    function spawnGhostTap() {
        if (KassetteHUDElement.preview_bf == null) return;
        var char = KassetteHUDElement.preview_bf;
        var dir = Std.random(4);
        
        var optManager = KssetteOptionsManager.instance;
        var ghostTapping = Std.string(optManager != null ? optManager.getKssValue("kssette_ghost_tapping") : null);
        var ghostSing = Std.string(optManager != null ? optManager.getKssValue("kssette_ghost_sing") : null);
        
        if (playerStrumPreview != null && playerStrumPreview.exists) {
            try {
                var rec = playerStrumPreview.strumlineNotes.members[dir];
                if (rec != null && rec.exists) {
                    rec.playPress();
                    rec.confirmHoldTimer = 0.0;
                }
            } catch(e:Dynamic) {}
        }
        
        var isMiss = false;
        if (ghostTapping == "Off" || ghostTapping == "false") {
            isMiss = true;
        } else if (ghostTapping == "In Breaks") {
            var hasPlayerNotes = false;
            for (n in fakeNotes) {
                if (n != null && n.exists && n.health == 1) {
                    hasPlayerNotes = true;
                    break;
                }
            }
            if (hasPlayerNotes) isMiss = true;
        }
        
        var dirStr = ["singLEFT", "singDOWN", "singUP", "singRIGHT"][dir];
        if (isMiss) {
            bfIdleTimer = 0.6;
            try {
                KassetteHUDElement.preview_simulatedAcc = 0.0;
            } catch(e:Dynamic) {}
            try {
                char.playAnimation(dirStr, true);
            } catch(e:Dynamic) {}
        } else {
            if (ghostSing == "On" || ghostSing == "true") {
                bfIdleTimer = 0.6;
                try {
                    char.playAnimation(dirStr, true);
                } catch(e:Dynamic) {}
            }
        }
    }

    override public function update(elapsed:Float):Void {
        super.update(elapsed);
        elapsedTime += elapsed;
        if (!isPreview) {
            return;
        }

        if (PlayState.instance != null) {
            if (FlxG.state.subState == null) {
                isPreview = false;
                cleanUp();
                return;
            }
        }
        
        if (bfIdleTimer > 0) {
            bfIdleTimer -= elapsed;
            if (bfIdleTimer <= 0) {
                try { if (KassetteHUDElement.preview_bf != null) KassetteHUDElement.preview_bf.dance(true); } catch(e:Dynamic) {}
            }
        }
        if (dadIdleTimer > 0) {
            dadIdleTimer -= elapsed;
            if (dadIdleTimer <= 0) {
                try { if (KassetteHUDElement.preview_dad != null) KassetteHUDElement.preview_dad.dance(true); } catch(e:Dynamic) {}
            }
        } else {
            var c = Math.floor(elapsedTime / 4.0);
            if (c > dadDancesCount) {
                dadDancesCount = c;
                try { if (KassetteHUDElement.preview_dad != null) KassetteHUDElement.preview_dad.dance(true); } catch(e:Dynamic) {}
            }
        }
        
        var beatDuration:Float = 0.5;
        if (Conductor.instance != null && Conductor.instance.crochet > 0) {
            beatDuration = Conductor.instance.crochet / 1000.0;
        }

        noteTimer += elapsed;
        if (noteTimer > targetNoteDelay) {
            noteTimer = 0;
            var beatsToWait = 2 + Std.random(3); // Wait 2, 3, or 4 beats
            targetNoteDelay = beatsToWait * beatDuration;
            spawnFakeNote();
        }
        
        if (true) {
            KassetteHUDElement.preview_playerTurn = playerTurn;
            var prog = ((noteCount - 1) + (noteTimer / targetNoteDelay)) / 4.0;
            if (prog < 0) prog = 0;
            if (prog > 1) prog = 1;
            KassetteHUDElement.preview_turnProgress = prog;
        }
        
        ghostTimer += elapsed;
        if (ghostTimer > targetGhostDelay) {
            ghostTimer = 0;
            var ghostBeatsToWait = 3 + Std.random(5); // Wait 3 to 7 beats
            targetGhostDelay = ghostBeatsToWait * beatDuration;
            spawnGhostTap();
        }
        
        for (note in fakeNotes) {
            if (note != null && note.exists) {
                var isPlayer = note.health == 1;
                var strum = isPlayer ? playerStrumPreview : opponentStrumPreview;
                if (strum != null && strum.exists) {
                    try {
                        var rec = strum.strumlineNotes.members[note.ID];
                        if (rec != null && rec.exists) {
                            note.x = rec.x + (rec.width - note.width) / 2.0;
                            note.alpha = strum.alpha * 0.8;
                        }
                    } catch(e:Dynamic) {}
                }
            }
        }

    }
}
