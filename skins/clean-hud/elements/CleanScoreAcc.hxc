package kassettehud.util;

import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxCamera;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.Preferences;
import flixel.text.FlxTextFormat;
import flixel.util.FlxColor;
import funkin.Paths;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KssetteFontManager;
import kassettehud.util.KassetteHUDDatahunter;
import funkin.modding.module.ModuleHandler;
import StringTools;
import Std;

class CleanScoreAcc extends KassetteHUDElement {
    var scoreTxt:FlxText;
    var accTxt:FlxText;

    var previewScoreTxt:FlxText;
    var previewAccTxt:FlxText;
    
    var _fmtPerfectGold:FlxTextFormat;
    var _fmtPerfect:FlxTextFormat;
    var _fmtExcellent:FlxTextFormat;
    var _fmtGreat:FlxTextFormat;
    var _fmtGood:FlxTextFormat;
    var _fmtShit:FlxTextFormat;

    function getRankFormat(rank:String):FlxTextFormat {
        var fmt:FlxTextFormat = null;
        if (rank == null) return null;
        switch(rank.toUpperCase()) {
            case "PERFECT_GOLD":
                if (_fmtPerfectGold == null) _fmtPerfectGold = new FlxTextFormat(0xFFF9E859);
                fmt = _fmtPerfectGold;
            case "PERFECT":
                if (_fmtPerfect == null) _fmtPerfect = new FlxTextFormat(0xFFFFAEFF);
                fmt = _fmtPerfect;
            case "EXCELLENT":
                if (_fmtExcellent == null) _fmtExcellent = new FlxTextFormat(0xFFFFFFC5);
                fmt = _fmtExcellent;
            case "GREAT":
                if (_fmtGreat == null) _fmtGreat = new FlxTextFormat(0xFFDCE6F1);
                fmt = _fmtGreat;
            case "GOOD":
                if (_fmtGood == null) _fmtGood = new FlxTextFormat(0xFFE19978);
                fmt = _fmtGood;
            case "SHIT", "LOSS":
                if (_fmtShit == null) _fmtShit = new FlxTextFormat(0xFF4460B7);
                fmt = _fmtShit;
        }
        return fmt;
    }
    
    var _lastFont:String = "";

    public function new() {
        super("CleanScoreAcc");
        this.name = "CleanScoreAcc";
    }

    override public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        
        var cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        previewScoreTxt = new FlxText(10, FlxG.height * 0.1, 0, "S: 0", 20);
        previewScoreTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        previewScoreTxt.scrollFactor.set(0, 0);
        safeAdd(previewScoreTxt, cam);
        
        previewAccTxt = new FlxText(10, previewScoreTxt.y + 24, 0, "A: 0.00%", 20);
        previewAccTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        previewAccTxt.scrollFactor.set(0, 0);
        safeAdd(previewAccTxt, cam);
    }

    override public function updatePreview() {
        onUpdate(0);
    }

    function killObj(obj:Dynamic) {
        if (obj == null) return;
        if (PlayState.instance != null) PlayState.instance.remove(obj, true);
        obj.destroy();
    }

    override public function onCountdownStart(event:Dynamic) {
        isPreview = false;
        var state = PlayState.instance;
        if (state == null) return;
        
        // Hide vanilla score texts
        if (state.scoreTxt != null) state.scoreTxt.visible = false;
        
        killObj(scoreTxt);
        killObj(accTxt);

        var cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        scoreTxt = new FlxText(10, FlxG.height * 0.1, 0, "S: 0", 20);
        scoreTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        scoreTxt.scrollFactor.set(0, 0);
        scoreTxt.cameras = [state.camHUD];
        scoreTxt.zIndex = 1500;
        state.add(scoreTxt);

        accTxt = new FlxText(10, scoreTxt.y + 24, 0, "A: 0.00%", 20);
        accTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        accTxt.scrollFactor.set(0, 0);
        accTxt.cameras = [state.camHUD];
        accTxt.zIndex = 1500;
        state.add(accTxt);
    }

    override public function onUpdate(event:Dynamic) {
        var state = PlayState.instance;
        var optManager = KssetteOptionsManager.instance;
        if (optManager == null) return;

        var showHud = optManager.getKssValue("kssette_show_hud") == true;
        var downscroll = false;
        if (KassetteHUDDatahunter.song != null) downscroll = KassetteHUDDatahunter.song.getDownscroll();
        else downscroll = Preferences.downscroll;

        var inverted = optManager.getKssValue("kssette_score_pos") == "Inverted";
        var atTop = inverted ? !downscroll : downscroll;

        var targetY = atTop ? FlxG.height * 0.1 : FlxG.height * 0.9 - 48;

        var cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        var fontChanged = (_lastFont != cachedFont);
        if (fontChanged) _lastFont = cachedFont;

        if (isPreview) {
            if (previewScoreTxt != null) {
                if (fontChanged) previewScoreTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
                previewScoreTxt.visible = showHud;
                previewScoreTxt.y = targetY;
            }
            if (previewAccTxt != null) {
                if (fontChanged) previewAccTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
                previewAccTxt.visible = showHud;
                previewAccTxt.y = targetY + 24;
            }
            return;
        }

        if (state == null || scoreTxt == null || accTxt == null) return;

        if (fontChanged) {
            scoreTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
            accTxt.setFormat(cachedFont, 20, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        }

        scoreTxt.visible = showHud;
        accTxt.visible = showHud;
        scoreTxt.y = targetY;
        accTxt.y = targetY + 24;

        // Anti-Overlap System
        // No more transparency anti-overlap for side texts since they physically evade the notes now.
        scoreTxt.alpha = 1.0;
        accTxt.alpha = 1.0;
        
        if (state.scoreTxt != null) state.scoreTxt.visible = false;

        // Update score
        var scoreStr = "0";
        var rankID = "?";
        var scoreHunter = KassetteHUDDatahunter.score;
        if (scoreHunter != null) {
            scoreStr = scoreHunter.getScore(state);
            rankID = scoreHunter.getRankID(state);
        } else {
            scoreStr = Std.string(Math.floor(state.songScore));
        }
        
        var formattedRank = formatRank(rankID);
        var scoreTextStr = "S: " + scoreStr;
        var rankStart = -1;
        var rankLen = 0;
        
        if (formattedRank != "?" && formattedRank != "") {
            scoreTextStr += " [" + formattedRank + "]";
            rankStart = scoreTextStr.lastIndexOf("[") + 1;
            rankLen = formattedRank.length;
        }
        
        scoreTxt.text = scoreTextStr;
        scoreTxt.clearFormats();
        
        if (rankStart != -1) {
            var rFmt = getRankFormat(rankID);
            if (rFmt != null) {
                var activeFont = scoreTxt.textField != null ? scoreTxt.textField.defaultTextFormat.font : cachedFont;
                if (rFmt.format != null) rFmt.format.font = activeFont;
                scoreTxt.addFormat(rFmt, rankStart, rankStart + rankLen);
            }
        }
        
        // Update accuracy
        var acc = 0.0;
        var scoreHunter = KassetteHUDDatahunter.score;
        if (scoreHunter != null) {
            acc = scoreHunter.getFinalAccuracy();
        }
        accTxt.text = "A: " + acc + "%";
    }
}
