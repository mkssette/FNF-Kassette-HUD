package kassettehud.util;

import kassettehud.util.KassetteHUDSkin;
import kassettehud.util.KassetteHUDElement;

class KssetteDefaultSkin extends KassetteHUDSkin {
    public function new(?_id:String) {
        super({
            id: "default",
            name: "Default Skin",
            author: "Mikassette",
            description: "The default Kassette HUD skin."
        });
    }

    override public function buildElements():Dynamic {
        // Asumiendo que las clases base ya están disponibles (importadas o en el mismo scope base)
        return [
            new KssetteHealthBar(),
            new KssetteTimeBar(),
            new KssetteAccuracy(),
            new KssetteShowTitle(),
            new KssetteBreakBar()
        ];
    }
}
