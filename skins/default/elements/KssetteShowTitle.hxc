package kassettehud.util;

/**
 * KssetteShowTitle
 *
 * Displays the song title, artist, and difficulty at the start of a song.
 * Uses a customizable intro animation (Clap, Racer, Classic) with adjustable
 * text positions and fonts.
 *
 * Managed settings:
 *   - kssette_show_song_title: "On" | "Off"
 *   - kssette_show_song_diff: "On" | "Off"
 *   - kssette_intro_text: custom intro animation style
 *   - kssette_intro_font_title: font for the song title
 *   - kssette_intro_font_artist: font for the artist name
 *   - kssette_intro_album: show album art
 *
 * Dependencies:
 *   - KssetteApi (for settings and song data)
 *   - AlbumRegistry (for album art graphics)
 */

import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import flixel.FlxSprite;
import funkin.Paths;
import funkin.data.freeplay.album.AlbumRegistry;
import Std;

class KssetteShowTitle extends KassetteHUDElement {
    var titleTxt:FlxText;
    var artistTxt:FlxText;
    var albumSprite:FlxSprite;

    var isActive:Bool = false;
    
    var titleTargetX:Float = 0;
    var artistTargetX:Float = 0;
    var albTargetX:Float = 0;
    var floatDist:Float = 60;
    var totalTitleWidth:Float = 0;
    var animStyle:String = "Classic";
    var animPos:String = "Center";
    var animAlbum:String = "On";
    var isFadingOut:Bool = false;


    public var previewCam:FlxCamera = null;
    var previewTimer:Float = 0.0;
    
    // Datahunters
    var songHunter:Dynamic = null;
    var optManager:Dynamic = null;
    
    var cachedTitleFont:String = "";
    var cachedArtistFont:String = "";

    public function new() {
        super("KssetteShowTitle");
        this.name = "KssetteShowTitle";
    }

    /**
     * Safely cancels tweens, removes from scene, and destroys a UI object.
     * @param obj The graphic or text object to clean up.
     */
    function killObj(obj:Dynamic) {
        if (obj != null) {
            FlxTween.cancelTweensOf(obj);
            safeDestroy(obj);
        }
    }

    /**
     * Cleans up all title texts and the album sprite.
     */
    function cleanUp() {
        killObj(titleTxt);
        killObj(artistTxt);
        killObj(albumSprite);
        titleTxt = null;
        artistTxt = null;
        albumSprite = null;
    }

    /**
     * Resolves the font names for the title and artist from KssetteApi.
     */
    function cacheIntroFonts() {
        var titleFontKey = "vcr.ttf";
        var artistFontKey = "vcr.ttf";

        var tk = getSetting("kssette_intro_font_title");
        if (tk != null) titleFontKey = Std.string(tk);

        var ak = getSetting("kssette_intro_font_artist");
        if (ak != null) artistFontKey = Std.string(ak);

        cachedTitleFont = "VCR OSD Mono";
        cachedArtistFont = "VCR OSD Mono";
        var globalAssetHunter = KassetteHUDDatahunter.asset;
        if (globalAssetHunter != null) {
            cachedTitleFont = Std.string(globalAssetHunter.resolveCustomFont(titleFontKey));
            cachedArtistFont = Std.string(globalAssetHunter.resolveCustomFont(artistFontKey));
        }
    }

    /**
     * Called when the PlayState starts changing. Cleans up UI to prevent leaks.
     */
    override public function onStateChangeStart(event:Dynamic) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanUp();
    }

    /**
     * Called when a song is retried. Resets the fade out flag and cleans up UI.
     */
    override public function onSongRetry(event:Dynamic) {
        super.onSongRetry(event);
        isFadingOut = false;
        cleanUp();
    }

    /**
     * Cleans up all objects when the module is destroyed.
     */
    override public function onDestroy(event:Dynamic) {
        super.onDestroy(event);
        cleanUp();
    }

    /**
     * Initializes the intro UI elements based on the current song and settings.
     * @param cam The camera to render the UI on.
     */
    function setupUI(cam:FlxCamera) {
        cleanUp();
        if (!isActive) return;

        var titleStr = "Unknown";
        var artistStr = "Unknown Artist";

        if (isPreview) {
            titleStr = "Preview Song";
            artistStr = "Artist Name";
        } else {
            var state = PlayState.instance;
            if (state != null) {
                if (state.currentChart != null) {
                    if (state.currentChart.songName != null) {
                        var cName = Std.string(state.currentChart.songName);
                        if (cName != "") titleStr = cName;
                    }
                    if (state.currentChart.songArtist != null) {
                        var cArt = Std.string(state.currentChart.songArtist);
                        if (cArt != "") artistStr = cArt;
                    }
                }
            }

            var sh = KassetteHUDDatahunter.song != null ? KassetteHUDDatahunter.song : songHunter;
            if (titleStr == "Unknown" || titleStr == "null") {
                titleStr = sh != null ? Std.string(sh.getSongTitle()) : "Unknown";
            }
            if (artistStr == "Unknown Artist" || artistStr == "null") {
                artistStr = sh != null ? Std.string(sh.getSongArtist()) : "Unknown Artist";
            }
        }

        cacheIntroFonts();

        var titleBaseSize = 44;
        var artistBaseSize = 32;

        var showAlbum = getSettingBool("kssette_intro_album", true);

        var albumArtAsset:String = null;

        if (showAlbum) {
            if (isPreview) {
                albumArtAsset = "freeplay/albumRoll/freeplayAlbum/spritemap1";
            } else {
                var albumId:String = null;
                if (PlayState.instance != null && PlayState.instance.currentSong != null) {
                        var diff = null;
                        if (PlayState.instance != null && PlayState.instance.currentSong != null) {
                            diff = PlayState.instance.currentSong.getDifficulty(PlayState.instance.currentDifficulty, PlayState.instance.currentVariation);
                        }
                        if (diff != null) albumId = diff.album;
                }
                
                if (albumId != null) {
                    var albumData = AlbumRegistry.instance.fetchEntry(albumId);
                    if (albumData != null) {
                        albumArtAsset = albumData.getAlbumArtAssetKey();
                    }
                }
            }
        }
        
        if (albumArtAsset != null) {
            albumSprite = new FlxSprite(0, 0);
            var g = Paths.image(albumArtAsset);
            if (g != null) {
                albumSprite.loadGraphic(g);
                albumSprite.setGraphicSize(250, 250);
                albumSprite.updateHitbox();
                albumSprite.antialiasing = true;
            } else {
                albumSprite = null;
            }
        }

        var baseY = (FlxG.height / 2) - 150; 

        titleTxt = new FlxText(0, baseY, 0, titleStr, titleBaseSize);
        titleTxt.setFormat(cachedTitleFont, titleBaseSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        titleTxt.borderSize = 3;
        titleTxt.updateHitbox();

        artistTxt = new FlxText(0, baseY + 50, 0, artistStr, artistBaseSize);
        artistTxt.setFormat(cachedArtistFont, artistBaseSize, 0xFFCCCCCC, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        artistTxt.borderSize = 2;
        artistTxt.updateHitbox();

        totalTitleWidth = titleTxt.width;
        var artistWidth = artistTxt.width;
        
        if (animStyle == "Clap") animPos = "Center";

        albTargetX = 0;

        if (animPos == "Left") {
            titleTargetX = 50;
            artistTargetX = 50;
            albTargetX = FlxG.width - 50 - 250;
        } else if (animPos == "Right") {
            titleTargetX = FlxG.width - 50 - totalTitleWidth;
            artistTargetX = FlxG.width - 50 - artistWidth;
            albTargetX = 50;
        } else {
            titleTargetX = (FlxG.width / 2) - (totalTitleWidth / 2);
            artistTargetX = (FlxG.width / 2) - (artistWidth / 2);
            albTargetX = (FlxG.width / 2) - 125;
        }

        if (animStyle == "Clap") {
            titleTxt.x = titleTargetX;
            titleTxt.y = -200;
            titleTxt.alpha = 1;

            artistTxt.x = artistTargetX;
            artistTxt.y = FlxG.height + 200;
            artistTxt.alpha = 1;
            
            if (albumSprite != null) {
                albumSprite.x = albTargetX;
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
            }
        } else if (animStyle == "Racer") {
            titleTxt.x = titleTargetX;
            titleTxt.y = FlxG.height + 50;
            titleTxt.alpha = 1;

            artistTxt.x = artistTargetX;
            artistTxt.y = FlxG.height + 100;
            artistTxt.alpha = 1;
            
            if (albumSprite != null) {
                albumSprite.x = albTargetX;
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
            }
        } else {
            titleTxt.x = -totalTitleWidth - 200;
            titleTxt.y = baseY;
            titleTxt.alpha = 0; 

            artistTxt.x = FlxG.width + 200;
            artistTxt.y = baseY + 50;
            artistTxt.alpha = 0; 
            
            if (albumSprite != null) {
                if (animPos == "Left") {
                    albumSprite.x = FlxG.width + 300;
                    albumSprite.y = baseY + 100;
                } else if (animPos == "Right") {
                    albumSprite.x = -300;
                    albumSprite.y = baseY + 100;
                } else {
                    albumSprite.x = albTargetX;
                    albumSprite.y = FlxG.height + 300;
                }
                albumSprite.alpha = 1;
            }
        }
        
        if (albumSprite != null) {
            albumSprite.zIndex = KassetteHUDElement.Z_SCREEN_OVERLAYS;
            safeAdd(albumSprite, cam);
        }

        artistTxt.zIndex = KassetteHUDElement.Z_SCREEN_OVERLAYS;
        safeAdd(artistTxt, cam);

        titleTxt.zIndex = KassetteHUDElement.Z_SCREEN_OVERLAYS;
        safeAdd(titleTxt, cam);

        if (artistStr == "Unknown Artist" || artistStr == "null" || artistStr == "") {
            artistTxt.visible = false;
            if (animStyle != "Racer") titleTxt.y = baseY + 15; 
        }
    }

    /**
     * Starts the intro animation based on the configured animation style (Clap, Racer, or Classic).
     */
    function startAnim() {
        if (!isActive) return;

        if (animStyle == "Clap") {
            var tBaseY = (FlxG.height / 2) - 80;
            var aBaseY = tBaseY + 50;
            if (artistTxt != null && !artistTxt.visible) tBaseY = (FlxG.height / 2) - 60;
            var albBaseY = tBaseY + 100;

            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
                if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY}, 0.4, {ease: FlxEase.expoOut, startDelay: 0.2, onComplete: function(t1:FlxTween) {
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY}, 3.0 - 0.2, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: -350}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && albumSprite != null) killObj(albumSprite);
                        }});
                    }});
                }});
            }

            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.y = -200;
                titleTxt.alpha = 1;
                if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: tBaseY}, 0.4, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: tBaseY}, 3.0, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: -200}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }
            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.y = FlxG.height + 200;
                artistTxt.alpha = 1;
                if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: aBaseY}, 0.4, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: aBaseY}, 3.0, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: FlxG.height + 200}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        } else if (animStyle == "Racer") {
            var tBaseY = (FlxG.height / 2) - 150;
            var aBaseY = tBaseY + 50;
            if (artistTxt != null && !artistTxt.visible) tBaseY = tBaseY + 15;
            var albBaseY = tBaseY + 100;

            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                albumSprite.alpha = 1;
                if (animPos == "Left") {
            // Album is on Right. Starts on Right.
                    albumSprite.y = albBaseY;
                    albumSprite.x = FlxG.width + 300;
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: FlxG.width + 300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else if (animPos == "Right") {
            // Album is on Left. Starts on Left.
                    albumSprite.y = albBaseY;
                    albumSprite.x = -300;
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX + 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else {
                    albumSprite.y = FlxG.height + 300;
                    albumSprite.x = albTargetX;
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                }
            }

            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.y = FlxG.height + 50;
                titleTxt.alpha = 1;
                if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: tBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.1, onComplete: function(t1:FlxTween) {
                    if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: tBaseY - 30}, 3.4, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {y: -200}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }
            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.y = FlxG.height + 100;
                artistTxt.alpha = 1;
                if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: aBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.2, onComplete: function(t1:FlxTween) {
                    if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: aBaseY - 30}, 3.3, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {y: -200}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        } else {
            var baseY = (FlxG.height / 2) - 150;
            var albBaseY = baseY + 100;
            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                if (animPos == "Left") {
                    albumSprite.x = FlxG.width + 300;
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: FlxG.width + 300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else if (animPos == "Right") {
                    albumSprite.x = -300;
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: albTargetX + 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {x: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else {
                    if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: albBaseY - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {y: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                }
            }
            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.x = -totalTitleWidth - 200;
                titleTxt.alpha = 0;
                if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {x: titleTargetX - (floatDist/2), alpha: 1}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {x: titleTargetX + (floatDist/2)}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {x: FlxG.width + 200, alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }

            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.x = FlxG.width + 200;
                artistTxt.alpha = 0;
                if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {x: artistTargetX + (floatDist/2), alpha: 1}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {x: artistTargetX - (floatDist/2)}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {x: -artistTxt.width - 200, alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        }
    }

    /**
     * Sets up the UI at the start of the countdown.
     */
    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isFadingOut = false;
        cleanUp();
        isPreview = false;

        var rawStyle = getSetting("kssette_intro_text");
        animStyle = Std.string(rawStyle);
        
        var rawPos = getSetting("kssette_intro_pos");
        if (rawPos != null) animPos = Std.string(rawPos);
        else animPos = "Center";
        
        isActive = (animStyle != "Off" && animStyle != "false");
        if (!isActive) return;

        var state = PlayState.instance;
        if (state == null || state.camHUD == null) return;

        setupUI(state.camHUD);
    }

    /**
     * Triggers the intro animation once the song actually starts.
     */
    override public function onSongStart(event:Dynamic) {
        super.onSongStart(event);
        if (!isPreview && isActive) {
            startAnim();
        }
    }

    /**
     * Prepares the UI for the options menu preview mode.
     * @param cam The preview camera to render onto.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        isFadingOut = false;
        previewCam = cam;
        
        var rawStyle = getSetting("kssette_intro_text");
        animStyle = Std.string(rawStyle);
        
        var rawPos = getSetting("kssette_intro_pos");
        if (rawPos != null) animPos = Std.string(rawPos);
        else animPos = "Center";
        
        var rawAlbum = getSetting("kssette_intro_album");
        if (rawAlbum != null) animAlbum = Std.string(rawAlbum);
        else animAlbum = "On";
        
        isActive = (animStyle != "Off" && animStyle != "false");

        setupUI(cam);
        if (isActive) {
            previewTimer = 0.5;
        }
    }







    /**
     * Refreshes the preview state, pulling new settings from KssetteApi.
     */
    public function updatePreview() {
        if (!isPreview) return;

        var rawStyle = getSetting("kssette_intro_text");
        var currentActive = (Std.string(rawStyle) != "Off" && Std.string(rawStyle) != "false");
        var newStyle = Std.string(rawStyle);
        
        var rawPos = getSetting("kssette_intro_pos");
        var newPos = rawPos != null ? Std.string(rawPos) : "Center";
        
        var rawAlbum = getSetting("kssette_intro_album");
        var newAlbum = rawAlbum != null ? Std.string(rawAlbum) : "On";
        
        var oldTitleFont = cachedTitleFont;
        var oldArtistFont = cachedArtistFont;
        cacheIntroFonts();

        var changed = false;
        if (isActive != currentActive) {
            isActive = currentActive;
            changed = true;
        }
        if (animStyle != newStyle) { animStyle = newStyle; changed = true; }
        if (animPos != newPos) { animPos = newPos; changed = true; }
        if (animAlbum != newAlbum) { animAlbum = newAlbum; changed = true; }
        if (oldTitleFont != cachedTitleFont || oldArtistFont != cachedArtistFont) changed = true;

        if (changed) {
            setupUI(previewCam);
            if (isActive) {
                previewTimer = 0.5;
            } else {
                cleanUp();
            }
        }
    }

    /**
     * Forces the UI to fade out rapidly. Usually triggered when the first
     * note is approaching to ensure the screen is clear.
     */
    function forceFadeOut() {
        isFadingOut = true;
        if (titleTxt != null && titleTxt.visible) {
            FlxTween.cancelTweensOf(titleTxt);
            if (titleTxt != null && titleTxt.exists) FlxTween.tween(titleTxt, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && titleTxt != null) killObj(titleTxt); }});
        }
        if (artistTxt != null && artistTxt.visible) {
            FlxTween.cancelTweensOf(artistTxt);
            if (artistTxt != null && artistTxt.exists) FlxTween.tween(artistTxt, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && artistTxt != null) killObj(artistTxt); }});
        }
        if (albumSprite != null && albumSprite.visible) {
            FlxTween.cancelTweensOf(albumSprite);
            if (albumSprite != null && albumSprite.exists) FlxTween.tween(albumSprite, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && albumSprite != null) killObj(albumSprite); }});
        }
    }

    /**
     * Per-frame update. Handles the preview cycle loop and checks if
     * the intro needs to fade out before the first note hits.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        if (isPreview && isActive) {
            if (previewTimer > 0) {
                previewTimer -= elapsed;
                if (previewTimer <= 0) {
                    previewTimer = 0.0;
                    startAnim();
                }
            }
        } else if (!isPreview && isActive && !isFadingOut) {
            var state = PlayState.instance;
            if (state != null && state.conductorInUse != null) {
                var breakHunter = KassetteHUDDatahunter.breakData;
                var notes = breakHunter != null ? breakHunter.playerNoteTimes : [];
                if (notes != null && notes.length > 0) {
                    var firstNoteTime = notes[0].start;
                    var currentTime = state.conductorInUse.songPosition;
                    if (firstNoteTime - currentTime < 1200) {
                        forceFadeOut();
                    }
                }
            }
        }
    }
    
    override public function destroy() {
        if (titleTxt != null) titleTxt.destroy();
        if (artistTxt != null) artistTxt.destroy();
        if (albumSprite != null) albumSprite.destroy();
        
        titleTxt = null;
        artistTxt = null;
        albumSprite = null;
        
        super.destroy();
    }
}
