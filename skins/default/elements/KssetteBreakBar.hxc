package kassettehud.util;

/**
 * KssetteBreakBar
 *
 * Displays a progress bar during long note gaps ("breaks") in the chart.
 * A break is defined as a player-side gap of at least 2500ms with no notes.
 * The bar shows how far through the break the player currently is, counting
 * down toward the next incoming note.
 *
 * Visual styles (kssette_breakbar_style):
 *   - "Default" - Rounded rectangle bar with a break icon on the left.
 *   - "Classic" - Outline-only rectangle with a "BREAK" text label.
 *   - "Pie"     - Circular arc that fills clockwise, with a break icon center.
 *
 * Position modes (kssette_breakbar_pos):
 *   - "Center"    - Centered horizontally on screen.
 *   - "Strumline" - Centered over the player strumline.
 *
 * The break detection relies on KssetteApi.playerNoteTimes[], which is
 * pre-parsed from the chart at song start. The BreakBar also exposes
 * getBreakData() via KssetteApi so other modules (GhostTapping) can
 * check whether a break is currently active.
 *
 * Settings managed:
 *   - kssette_show_breakbar:   "On" | "Off"
 *   - kssette_breakbar_style:  "Default" | "Classic" | "Pie"
 *   - kssette_breakbar_pos:    "Center" | "Strumline"
 *
 * Dependencies:
 *   - KssetteApi.playerNoteTimes[] - sorted array of player note time windows
 *   - KssetteApi.getHudFont()      - HUD font for Classic label text
 */

import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import funkin.Paths;
import Math;
import Std;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.math.FlxPoint;
import flixel.math.FlxRect;
import flixel.util.FlxSpriteUtil;
import funkin.graphics.FunkinSprite;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;

class KssetteBreakBar extends KassetteHUDElement {
    /** Horizontal offset for 'Default' and 'Pie' styles. */
    var offsetX:Float = 12;
    /** Vertical offset for 'Default' and 'Pie' styles. */
    var offsetY:Float = 0;
    
    /** Horizontal offset of the icon in 'Default' style. */
    var iconOffsetX:Float = 10;
    /** Vertical offset of the icon in 'Default' style. */
    var iconOffsetY:Float = -7;

    /** Border sprite for 'Default' and 'Pie' styles. */
    var border:FlxSprite;
    /** Break icon sprite for 'Default' and 'Pie' styles. */
    var breakIcon:FunkinSprite;
    
    /** Array of sprites for the 'Classic' style borders. */
    var borders:Array<FlxSprite> = [];
    /** "BREAK" text for the 'Classic' style. */
    var breakText:FlxText;

    /** Fill sprite indicating break progress. */
    var barFill:FlxSprite;
    /** Base width of the bar. */
    var barWidth:Float = 260;
    /** Base height of the bar. */
    var barHeight:Float = 20;
    /** Target alpha value for fade in/out animations. */
    var alphaTarget:Float = 0;
    /** Current alpha value, interpolated towards `alphaTarget`. */
    var currentAlpha:Float = 0;
    /** Cached reference to KssetteApi module. */

    /** Cached flag indicating if the break bar is active. */
    var cachedActive:Bool = false;
    /** Clip rect for the fill sprite in 'Default' style. */
    var fillClip:FlxRect = null;
    /** Last applied fill width to prevent redundant updates. */
    var lastFillW:Int = -1;
    /** Timer to throttle per-frame update frequency. */
    var updateTimer:Float = 0.0;
    /** Cached text font for the UI. */
    var cachedFont:String = "VCR OSD Mono";
    /** Current style of the bar ('Default', 'Classic', 'Pie'). */
    var currentStyle:String = "Default";
    /** Current position of the bar ('Center', 'Strumline'). */
    var currentPos:String = "Center";
    
    /** Cached player note times used to calculate breaks. */
    var cachedNoteTimes:Array<Dynamic> = [];
    /** Current index into cachedNoteTimes (advances as song progresses). */
    var localNoteIndex:Int = 0;

    /** True when rendering in the options menu preview instead of gameplay. */

    /** Camera to render into during preview mode. */
    public    var previewCam:FlxCamera = null;
    var songHunter:Dynamic = null;
    var optManager:Dynamic = null;
    /** Accumulated time used to animate the preview break bar. */
    var previewBreakTimer:Float = 0.0;
    
    public function new() {
        super("KssetteBreakBar");
        this.name = "KssetteBreakBar";
    }

    /**
     * Destroys all bar/icon/text sprites and resets clip state.
     * Called before rebuilding the UI on song start or style change.
     */
    public function cleanupUI() {
        safeDestroy(border);
        safeDestroy(barFill);
        safeDestroy(breakIcon);
        safeDestroy(breakText);
        if (borders != null) {
            for (b in borders) safeDestroy(b);
        }
        border = null;
        barFill = null;
        breakIcon = null;
        breakText = null;
        borders = [];
        fillClip = null;
        lastFillW = -1;
    }

    /** Cleans up UI and resets preview flag when leaving the current state. */
    override public function onStateChangeStart(event) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanupUI();
    }


    /**
     * Software-renders a rounded rectangle into a FlxSprite's bitmap.
     * When hollow=true, carves out a transparent inner rectangle to create
     * an outline effect. Corner rounding is computed with per-pixel distance
     * from the corner origin.
     *
     * @param sprite  Target sprite whose graphic is overwritten.
     * @param w       Width in pixels.
     * @param h       Height in pixels.
     * @param rad     Corner radius in pixels.
     * @param color   Fill color (ARGB).
     * @param hollow  If true, only renders the border (thickness = thick).
     * @param thick   Border thickness in pixels (hollow mode only).
     */
    function drawRoundedRect(sprite:FlxSprite, w:Int, h:Int, rad:Int, color:Int, hollow:Bool = false, thick:Int = 2) {
        sprite.makeGraphic(w, h, 0x00000000);
        var b = sprite.graphic.bitmap;
        var rSq = rad * rad;
        for (y in 0...h) {
            for (x in 0...w) {
                var inside = true;
                var dx = 0.0; var dy = 0.0;
                if (x < rad && y < rad) { dx = rad - x - 0.5; dy = rad - y - 0.5; }
                else if (x >= w - rad && y < rad) { dx = x - (w - rad) + 0.5; dy = rad - y - 0.5; }
                else if (x < rad && y >= h - rad) { dx = rad - x - 0.5; dy = y - (h - rad) + 0.5; }
                else if (x >= w - rad && y >= h - rad) { dx = x - (w - rad) + 0.5; dy = y - (h - rad) + 0.5; }
                if ((dx * dx) + (dy * dy) > rSq) inside = false;
                if (inside) b.setPixel32(x, y, color);
            }
        }
        
        if (hollow) {
            var innerW = w - (thick * 2);
            var innerH = h - (thick * 2);
            var innerRad = rad - thick;
            if (innerRad < 0) innerRad = 0;
            var innerRSq = innerRad * innerRad;
            
            for (y in 0...innerH) {
                for (x in 0...innerW) {
                    var inside = true;
                    if (innerRad > 0) {
                        var dx = 0.0; var dy = 0.0;
                        if (x < innerRad && y < innerRad) { dx = innerRad - x - 0.5; dy = innerRad - y - 0.5; }
                        else if (x >= innerW - innerRad && y < innerRad) { dx = x - (innerW - innerRad) + 0.5; dy = innerRad - y - 0.5; }
                        else if (x < innerRad && y >= innerH - innerRad) { dx = innerRad - x - 0.5; dy = y - (innerH - innerRad) + 0.5; }
                        else if (x >= innerW - innerRad && y >= innerH - innerRad) { dx = x - (innerW - innerRad) + 0.5; dy = y - (innerH - innerRad) + 0.5; }
                        if ((dx * dx) + (dy * dy) > innerRSq) inside = false;
                    }
                    if (inside) b.setPixel32(x + thick, y + thick, 0x00000000);
                }
            }
        }
    }

    /**
     * Configures and initializes all UI elements for the break bar.
     * @param cam The HUD camera to which elements are attached.
     */
    public function setupUI(cam:FlxCamera) {
        cleanupUI();

        cachedFont = getHudFont();
        var rawStyle = getSetting("kssette_breakbar_style");
        if (rawStyle == "Classic") currentStyle = "Classic";
        else if (rawStyle == "Pie") currentStyle = "Pie";
        else currentStyle = "Default";
        var rawPos = getSetting("kssette_breakbar_pos");
        currentPos = (rawPos == "Strumline") ? "Strumline" : "Center";
        var state = PlayState.instance;

        var centerY = (FlxG.height / 2) - 60;
        var centerX = (FlxG.width / 2);
        if (currentStyle == "Default" || currentStyle == "Pie") {
            centerY += offsetY;
            centerX += offsetX;
        }

        if (currentPos == "Strumline") {
            if (isPreview) {
                var st:Dynamic = FlxG.state;
                var previewMod = (st != null ? st.hudPreview : null);
                if (previewMod != null && previewMod.playerStrumPreview != null) {
                    var sX = previewMod.playerStrumPreview.x;
                    var sW = previewMod.playerStrumPreview.width;
                    if (sW == 0) sW = 448;
                    centerX = sX + (sW / 2);
                }
            } else if (state != null && state.playerStrumline != null) {
                var sW = state.playerStrumline.width;
                if (sW == 0) sW = 448;
                centerX = state.playerStrumline.x + (sW / 2);
            }
        }

        var startX = centerX - (barWidth / 2);

        if (currentStyle == "Classic") {
            var thick = 4;
            
            var bTop = new FlxSprite(startX, centerY).makeGraphic(Std.int(barWidth), thick, 0xFFFFFFFF);
            var bBot = new FlxSprite(startX, centerY + barHeight - thick).makeGraphic(Std.int(barWidth), thick, 0xFFFFFFFF);
            var bLeft = new FlxSprite(startX, centerY + thick).makeGraphic(thick, Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            var bRight = new FlxSprite(startX + barWidth - thick, centerY + thick).makeGraphic(thick, Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            
            borders = [bTop, bBot, bLeft, bRight];
            for (b in borders) {
                b.scrollFactor.set(0, 0);
                b.zIndex = 1010;
                b.alpha = 0;
                b.cameras = [cam];
                safeAdd(b, cam);
            }
            
            barFill = new FlxSprite(startX + thick, centerY + thick).makeGraphic(Std.int(barWidth - thick * 2), Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            safeAdd(barFill, cam);

            breakText = createText(startX, centerY - 28, barWidth, "BREAK", 20, 0xFFFFFFFF, "center");
            breakText.scrollFactor.set(0, 0);
            breakText.zIndex = 1012;
            breakText.alpha = 0;
            safeAdd(breakText, cam);

        } else if (currentStyle == "Pie") {
            var radius = 45;
            var cX = centerX - radius;
            var cY = centerY - radius;
            
            border = new FlxSprite(cX, cY);
            drawRoundedRect(border, radius*2, radius*2, radius, 0xFFFFFFFF, true, 3);
            border.scrollFactor.set(0, 0);
            border.zIndex = 1010;
            border.alpha = 0;
            safeAdd(border, cam);
            
            barFill = new FlxSprite(cX + 3, cY + 3);
            barFill.makeGraphic(radius*2 - 6, radius*2 - 6, 0x00000000);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            lastFillW = -1;
            lastPieDegree = -1;
            safeAdd(barFill, cam);
            
            breakIcon = new FunkinSprite(0, 0);
            var iconImg = getSkinImage("break", "default");
            if (iconImg != null) {
                breakIcon.loadGraphic(iconImg);
            } else {
                breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
            }
            if (breakIcon.graphic != null) {
                var sRatio = 40 / breakIcon.graphic.width;
                breakIcon.scale.set(sRatio, sRatio);
                breakIcon.updateHitbox();
            }
            breakIcon.x = centerX - (breakIcon.width / 2);
            breakIcon.y = centerY - (breakIcon.height / 2);
            breakIcon.scrollFactor.set(0, 0);
            breakIcon.zIndex = 1012;
            breakIcon.alpha = 0;
            safeAdd(breakIcon, cam);

        } else {
            border = new FlxSprite(startX, centerY);
            drawRoundedRect(border, Std.int(barWidth), Std.int(barHeight), 5, 0xFFFFFFFF, true, 3);
            border.scrollFactor.set(0, 0);
            border.zIndex = 1010;
            border.alpha = 0;
            safeAdd(border, cam);
            
            barFill = new FlxSprite(startX + 5, centerY + 5);
            drawRoundedRect(barFill, Std.int(barWidth - 10), Std.int(barHeight - 10), 2, 0xFF999999, false, 0);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            lastFillW = -1;
            safeAdd(barFill, cam);

            breakIcon = new FunkinSprite(0, 0);
            var iconImg = getSkinImage("break", "default");
            if (iconImg != null) {
                breakIcon.loadGraphic(iconImg);
            } else {
                breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
            }
            
            if (breakIcon.graphic != null) {
                var sRatio = 35 / breakIcon.graphic.width;
                breakIcon.scale.set(sRatio, sRatio);
                breakIcon.updateHitbox();
            }

            breakIcon.x = startX - breakIcon.width - 15 + iconOffsetX; 
            breakIcon.y = centerY + (barHeight - breakIcon.height) / 2 + iconOffsetY;
            
            breakIcon.scrollFactor.set(0, 0);
            breakIcon.zIndex = 1012;
            breakIcon.alpha = 0;
            breakIcon.cameras = [cam];
            if (state != null && !isPreview) state.add(breakIcon);
            else FlxG.state.add(breakIcon);
        }

        currentAlpha = 0;
        alphaTarget = 0;
    }

    /**
     * Updates the fill width of the Default-style bar by adjusting its
     * clipRect. Only triggers a bitmap-level update when the width actually
     * changes (guarded by lastFillW comparison).
     *
     * @param fillW  New fill width in pixels.
     */
    function setFillWidth(fillW:Int):Void {
        if (barFill == null || !barFill.exists) return;
        if (currentStyle == "Classic" || currentStyle == "Pie") return; 
        if (fillW < 1) fillW = 1;
        if (fillW == lastFillW) return;
        lastFillW = fillW;
        if (fillClip == null) {
            fillClip = new FlxRect(0, 0, barWidth - 10, barHeight - 10);
        } else {
            fillClip.width = fillW;
        }
        barFill.clipRect = fillClip;
    }

    /** Last degree applied to the Pie-style fill. */
    var lastPieDegree:Int = -1;

    /**
     * Renders the Pie-style arc fill by drawing a polygon of vertices
     * that traces an arc from -90° (top) clockwise to the degree matching
     * the current progress. Uses FlxSpriteUtil.drawPolygon.
     *
     * Only redraws when the degree value changes (guarded by lastPieDegree).
     *
     * @param prog  Progress ratio (0.0 = empty, 1.0 = full).
     */
    function setPieFill(prog:Float):Void {
        if (barFill == null || !barFill.exists) return;
        if (currentStyle != "Pie") return;
        
        var degree = Std.int(prog * 360);
        if (degree == lastPieDegree) return;
        lastPieDegree = degree;
        
        FlxSpriteUtil.fill(barFill, 0x00000000);
        if (prog <= 0) return;
        
        var radius = 42; 
        var thickness = 10;
        var innerRadius = radius - thickness;
        var cX = radius;
        var cY = radius;

        var vertices:Array<Dynamic> = [];
        
        var startAngle = -90; 
        var endAngle = -90 + degree;
        
        var step = 10;
        var angle = startAngle;
        while (angle < endAngle) {
            var rad = angle * Math.PI / 180;
            vertices.push(FlxPoint.get(cX + Math.cos(rad) * radius, cY + Math.sin(rad) * radius));
            angle += step;
        }
        var radEnd = endAngle * Math.PI / 180;
        vertices.push(FlxPoint.get(cX + Math.cos(radEnd) * radius, cY + Math.sin(radEnd) * radius));
        
        angle = endAngle;
        while (angle > startAngle) {
            var rad = angle * Math.PI / 180;
            vertices.push(FlxPoint.get(cX + Math.cos(rad) * innerRadius, cY + Math.sin(rad) * innerRadius));
            angle -= step;
        }
        var radStart = startAngle * Math.PI / 180;
        vertices.push(FlxPoint.get(cX + Math.cos(radStart) * innerRadius, cY + Math.sin(radStart) * innerRadius));
        
        if (vertices.length >= 3) {
            FlxSpriteUtil.drawPolygon(barFill, vertices, 0xFF999999);
        }
    }
    
    /**
     * Called at song start. Registers with KssetteApi, caches the note time
     * array, reads settings, and builds the UI sprites on camHUD.
     */
    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        
        var state = PlayState.instance;
        if (state == null) return;


        cachedActive = getSetting("kssette_show_breakbar") == true;
        breakHunter = KassetteHUDDatahunter.breakData;
        cachedNoteTimes = breakHunter != null ? breakHunter.playerNoteTimes : [];
        
        localNoteIndex = 0;
        updateTimer = 0.0;
        isPreview = false;

        trace("[KssetteBreakBar] onCountdownStart - active=" + cachedActive + " notes=" + (cachedNoteTimes != null ? cachedNoteTimes.length : 0));

        if (state.camHUD != null) setupUI(state.camHUD);
    }

    /**
     * Entry point for the options menu preview. Builds the bar UI on the
     * given preview camera and triggers an initial preview render.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;

        setupUI(cam);
        previewBreakTimer = 6.0;
        updatePreview();
    }

    /**
     * Refreshes the preview to reflect the current settings.
     * Rebuilds the UI if the style or position setting changed since last update.
     */
    public function updatePreview() {
        if (!isPreview) return;
        if (currentStyle == "Classic") {
            if (breakText == null || !breakText.exists) return;
        } else {
            if (breakIcon == null || !breakIcon.exists) return;
        }

        // apiModule removed
        
        cachedActive = getSetting("kssette_show_breakbar") == true;
        var rawStyle = getSetting("kssette_breakbar_style");
        var newStyle = (rawStyle == "Classic" || rawStyle == "Pie") ? Std.string(rawStyle) : "Default";
        
        var rawPos = getSetting("kssette_breakbar_pos");
        var newPos = (rawPos == "Strumline") ? "Strumline" : "Center";
        
        if (currentStyle != newStyle || currentPos != newPos) setupUI(previewCam);
    }

    /**
     * Per-frame update. Manages the break detection logic, bar fill
     * progress, alpha lerp, and dynamic strumline-following when active.
     *
     * Break detection algorithm:
     *   1. Advance localNoteIndex past any note windows that have already started.
     *   2. Check the gap between the end of the previous note and the start of
     *      the next note. If >= 2500ms, a break is active.
     *   3. Within the break, wait 400ms from the gap start and 400ms before the
     *      gap end before showing the bar (to avoid flickering on short gaps).
     *   4. Progress = how far through the visible portion of the gap the player is.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        if (barFill == null || !barFill.exists) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Default" && (breakIcon == null || !breakIcon.exists)) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Classic" && (breakText == null || !breakText.exists)) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Pie" && (breakIcon == null || !breakIcon.exists)) {
            alphaTarget = 0;
            return;
        }

        updateTimer += elapsed;
        if (updateTimer < 0.008) return;
        elapsed = updateTimer;
        updateTimer = 0.0;

        var breakProgress:Float = 0.0;

        if (isPreview) {
            alphaTarget = 0;
            if (cachedActive) {
                // Read preview state from KssetteApi using ? safe access.
                var isP:Bool = KassetteHUDElement.preview_playerTurn != false;
                var prog:Float = KassetteHUDElement.preview_turnProgress != null ? KassetteHUDElement.preview_turnProgress : 0.0;
                if (!isP) {
                    alphaTarget = 1;
                    breakProgress = 1.0 - prog;
                    if (currentStyle == "Default") setFillWidth(Std.int((barWidth - 10) * breakProgress));
                    if (currentStyle == "Pie") setPieFill(breakProgress);
                }
            }
        } else if (cachedActive) {
            var state = PlayState.instance;
            if (state != null && state.conductorInUse != null) {
                var currentTimes = breakHunter != null ? breakHunter.playerNoteTimes : cachedNoteTimes;
                if (currentTimes != null && currentTimes.length > 0) {
                    var currentTime = state.conductorInUse.songPosition;
                    var noteIndex:Int = localNoteIndex;

                    while (noteIndex > 0 && currentTimes[noteIndex - 1].start > currentTime) {
                        noteIndex--;
                    }

                    while (noteIndex < currentTimes.length && currentTimes[noteIndex].start <= currentTime) {
                        noteIndex++;
                    }
                    
                    localNoteIndex = noteIndex;

                    if (noteIndex < currentTimes.length) {
                        var nextTime:Float = currentTimes[noteIndex].start;
                        var prevTime:Float = 0;
                        if (noteIndex > 0) prevTime = currentTimes[noteIndex - 1].end;
                        
                        var gap = nextTime - prevTime;
                        if (gap >= 2500) {
                            var timeSincePrev = currentTime - prevTime;
                            var timeUntilNext = nextTime - currentTime;

                            if (timeSincePrev > 400 && timeUntilNext > 400) {
                                var totalVisibleTime = gap - 800; 
                                var currentVisibleTime = timeSincePrev - 400;
                                var prog = 1.0 - (currentVisibleTime / totalVisibleTime);
                                if (prog < 0) prog = 0;
                                if (prog > 1) prog = 1;
                                alphaTarget = 1;
                                breakProgress = 1.0 - prog;
                                if (currentStyle == "Default") setFillWidth(Std.int((barWidth - 10) * prog));
                                if (currentStyle == "Pie") setPieFill(prog);
                            } else {
                                alphaTarget = 0;
                            }
                        } else {
                            alphaTarget = 0;
                        }
                    } else {
                        alphaTarget = 0;
                    }
                } else {
                    alphaTarget = 0;
                }
            } else {
                alphaTarget = 0;
            }
        } else {
            alphaTarget = 0;
        }
        
        if (currentStyle == "Classic" && alphaTarget > 0) {
            var prog = 1.0 - breakProgress;
            if (prog < 0) prog = 0;
            if (prog > 1) prog = 1;
            barFill.scale.x = prog;
        }

        if (currentPos == "Strumline" && alphaTarget > 0) {
            var targetCenterX:Float = -1;
            if (isPreview) {
                var st:Dynamic = FlxG.state;
                var previewMod = (st != null ? st.hudPreview : null);
                if (previewMod != null && previewMod.playerStrumPreview != null) {
                    var sW = previewMod.playerStrumPreview.width;
                    if (sW == 0) sW = 448;
                    targetCenterX = previewMod.playerStrumPreview.x + (sW / 2);
                }
            } else {
                var state = PlayState.instance;
                if (state != null && state.playerStrumline != null) {
                    var sW = state.playerStrumline.width;
                    if (sW == 0) sW = 448;
                    targetCenterX = state.playerStrumline.x + (sW / 2);
                }
            }
            if (targetCenterX != -1) {
                if (currentStyle == "Default" || currentStyle == "Pie") targetCenterX += offsetX;
                if (currentStyle == "Classic") {
                    var newStartX = targetCenterX - (barWidth / 2);
                    var thick = 4;
                    if (borders != null && borders.length == 4) {
                        borders[0].x = newStartX; borders[1].x = newStartX;
                        borders[2].x = newStartX; borders[3].x = newStartX + barWidth - thick;
                    }
                    if (barFill != null) barFill.x = newStartX + thick;
                    if (breakText != null) breakText.x = newStartX;
                } else if (currentStyle == "Pie") {
                    var radius = 45;
                    var cX = targetCenterX - radius;
                    if (border != null) border.x = cX;
                    if (barFill != null) barFill.x = cX + 3;
                    if (breakIcon != null) breakIcon.x = targetCenterX - (breakIcon.width / 2);
                } else {
                    var newStartX = targetCenterX - (barWidth / 2);
                    if (border != null) border.x = newStartX;
                    if (barFill != null) barFill.x = newStartX + 5;
                    if (breakIcon != null) breakIcon.x = newStartX - breakIcon.width - 15 + iconOffsetX;
                }
            }
        }

        if (currentAlpha == 0 && alphaTarget == 0) return;

        currentAlpha += (alphaTarget - currentAlpha) * (elapsed * 10);
        if (Math.abs(alphaTarget - currentAlpha) < 0.01) currentAlpha = alphaTarget;
        
        if (currentStyle == "Classic") {
            var borderAlpha = currentAlpha * 0.6;
            if (borders != null && borders.length == 4) {
                borders[0].alpha = borderAlpha;
                borders[1].alpha = borderAlpha;
                borders[2].alpha = borderAlpha;
                borders[3].alpha = borderAlpha;
            }
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.4;
            if (breakText != null && breakText.exists) breakText.alpha = currentAlpha * 0.8;
        } else if (currentStyle == "Pie") {
            if (border != null && border.exists) border.alpha = currentAlpha * 0.5;
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.5;
            if (breakIcon != null && breakIcon.exists) breakIcon.alpha = currentAlpha * 0.5;
        } else {
            if (border != null && border.exists) border.alpha = currentAlpha * 0.5;
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.5;
            if (breakIcon != null && breakIcon.exists) breakIcon.alpha = currentAlpha * 0.5;
        }
    }
    
    override public function destroy() {
        if (border != null) border.destroy();
        if (breakIcon != null) breakIcon.destroy();
        if (breakText != null) breakText.destroy();
        if (barFill != null) barFill.destroy();
        
        border = null;
        breakIcon = null;
        breakText = null;
        barFill = null;
        
        super.destroy();
    }
}
