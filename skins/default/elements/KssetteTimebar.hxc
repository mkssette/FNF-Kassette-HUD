package kassettehud.util;

/**
 * KssetteTimeBar
 *
 * Renders a song progress bar during gameplay. The bar grows from 0% to 100%
 * as the song progresses and can be positioned in various screen locations.
 *
 * Layout modes (kssette_timebar_pos):
 *   - "Top" / "Bottom": Full-width edge bars (uses a dedicated camera).
 *   - "Top Left/Right": Compact mini bars in a corner.
 *   - "Bottom Left/Right": Compact mini bars in a corner.
 *   - "Vertical Left/Right": Full-height side bars.
 *   - "In Health": Thin bar positioned above/below the health bar.
 *
 * For edge positions (Top/Bottom/Vertical), a separate FlxCamera is created
 * so the bar renders on top of all game elements, including the pause substate.
 *
 * Managed settings:
 *   - kssette_show_timebar: "On" | "Off"
 *   - kssette_timebar_pos:  see Layout modes above
 *
 * Dependencies:
 *   - KssetteApi.getKssValue()  - reads option values
 *   - KssetteApi.getDownscroll() - determines health bar Y for "In Health" mode
 */

import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.FlxCamera;
import Std;

import flixel.util.FlxStringUtil;
import funkin.modding.events.SubStateScriptEvent;
import funkin.play.PauseSubState;
import funkin.ui.FullScreenScaleMode;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;

class KssetteTimeBar extends KassetteHUDElement {
    /** The colored foreground bar representing song progress. */
    public var timeBar:FlxSprite;
    /** The dark background behind the foreground bar. */
    public var timeBarBG:FlxSprite;
    /** Height/thickness of the bar in pixels (foreground). */
    var barSize:Float = 11;
    /** Indicates if the time bar is currently visible and active. */
    var cachedActive:Bool = false;
    /** Current position setting string (e.g., "Top", "Bottom Left"). */
    var timeBarPos:String = "Bottom";
    /** Cached reference to the KssetteApi module. */
    var songHunter:Dynamic = null;
    var optManager:Dynamic = null;    /** Reference to PlayState for song position queries. */

    /** Total song duration in milliseconds; used to calculate progress ratio. */
    var songLengthMs:Float = 0.0;
    /** Timer to throttle bar updates to ~120fps instead of every frame. */
    var updateTimer:Float = 0.0;
    /** Dedicated camera for edge mode bars (renders above all HUD layers). */
    var customCam:FlxCamera = null;

    /** Set to true during the options menu preview to use a custom camera instead of camHUD. */

    /** Camera for rendering in preview mode. */
    public var previewCam:FlxCamera = null;

    public function new() {
        super("KssetteTimeBar");
        this.name = "KssetteTimeBar";
    }

    /**
     * Utility: returns true if a dynamic value represents an "on" state.
     * Accepts boolean `true`, "On", "on", or "true" as true values.
     */
    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    /** Returns the HUD camera from the given PlayState instance. */
    function hudCamera(state:PlayState):FlxCamera {
        return state.camHUD;
    }

    /**
     * Creates a single bar sprite (FlxSprite) and adds it to the appropriate state.
     *
     * @param y      Vertical position in screen space.
     * @param h      Height in pixels.
     * @param color  Fill color (ARGB).
     * @param z      Z-index for draw order sorting.
     * @param cam    Camera to assign the sprite to.
     */
    function makeBar(y:Float, h:Int, color:Int, z:Int, cam:FlxCamera):FlxSprite {
        var bar = new FlxSprite(0, y).makeGraphic(FlxG.width, h, color);
        bar.origin.set(0, 0);
        bar.scrollFactor.set(0, 0);
        bar.zIndex = z;
        safeAdd(bar, cam);
        return bar;
    }

    /**
     * Destroys existing bar sprites and camera, resetting all state.
     * Called before rebuilding the UI (e.g., at song start or when changing position).
     */
    public function cleanupUI() {
        songLengthMs = 0.0;
        updateTimer = 0.0;
        safeDestroy(timeBar);
        safeDestroy(timeBarBG);
        if (customCam != null) {
            FlxG.cameras.remove(customCam);
            customCam.destroy();
            customCam = null;
        }
        timeBar = null;
        timeBarBG = null;
    }

    /**
     * Creates the background and foreground bar sprites and adds them to the scene.
     * For edge positions (Top/Bottom/Vertical), a dedicated FlxCamera is created
     * so the bar draws above all other HUD elements, including the pause menu.
     *
     * @param cam The base HUD camera to use for non-edge positions.
     */
    public function setupUI(cam:FlxCamera) {
        cleanupUI();

        var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        var targetCam:FlxCamera = cam;

        if (isBorder && !isPreview) {
            if (customCam == null) {
                customCam = new FlxCamera();
                customCam.bgColor = 0x00000000;
                FlxG.cameras.add(customCam, false);
            }
            targetCam = customCam;
        }

        var zIdx:Int = isBorder ? 1018 : (timeBarPos == "In Health" ? 109 : 15);

        timeBarBG = makeBar(0, Std.int(barSize + 4), 0xFF000000, zIdx, targetCam);
        timeBar = makeBar(2, Std.int(barSize), 0xFFFFFFFF, zIdx + 1, targetCam);
        FlxG.state.refresh();
    }

    /**
     * Recalculates and applies the position of both bar sprites based on the
     * current `timeBarPos` setting. Handles all layout variants, including
     * mini corners, vertical, health bar alignment, and mobile notch offsets.
     */
    public function updatePositions() {
        if (timeBarBG == null || timeBar == null) return;

        var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        var isInHealth:Bool = (timeBarPos == "In Health");
        var isMini:Bool = (timeBarPos == "Bottom Left" || timeBarPos == "Bottom Right" || timeBarPos == "Top Left" || timeBarPos == "Top Right");

        var currentBgW:Int = isVertical ? Std.int(barSize + 4) : (isMini ? 360 : (isInHealth ? 360 : FlxG.width));
        var currentBgH:Int = isVertical ? FlxG.height : Std.int(barSize + 4);
        var currentBarW:Int = isVertical ? Std.int(barSize) : currentBgW;
        var currentBarH:Int = isVertical ? currentBgH : Std.int(barSize);

        if (Std.int(timeBarBG.width) != currentBgW || Std.int(timeBarBG.height) != currentBgH) {
            timeBarBG.makeGraphic(currentBgW, currentBgH, 0xFF000000);
            timeBar.makeGraphic(currentBarW, currentBarH, 0xFFFFFFFF);
        }

        timeBarBG.origin.set(0, 0);
        timeBar.origin.set(0, isVertical ? currentBarH : 0);

        var cachedX:Float = 0;
        var cachedY:Float = 0;
        var paddingX:Float = 0;
        var paddingY:Float = 20;

        var cutoutSize:Float = 0.0;
        var isMob:Bool = this.isMobile;
        var showTimeBar = getSettingBool("kssette_show_timebar");

        if (isMob) {
            cutoutSize = FullScreenScaleMode.gameNotchSize.x;
            if (cutoutSize <= 0) {
                cutoutSize = FullScreenScaleMode.gameCutoutSize.x;
            }
            if (cutoutSize < 60.0) cutoutSize = 60.0; // Anti-Notch
        }

        switch (timeBarPos) {
            case "Top":
                cachedX = (FlxG.width - currentBgW) / 2;
            case "Top Left":
                cachedX = paddingX + cutoutSize; cachedY = paddingY;
            case "Top Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = paddingY;
            case "Bottom Left":
                cachedX = paddingX + cutoutSize; cachedY = FlxG.height - currentBgH - paddingY;
            case "Bottom Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = FlxG.height - currentBgH - paddingY;
            case "Vertical Left":
                cachedX = paddingX + cutoutSize; cachedY = 0;
            case "Vertical Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = 0;
            case "In Health":
                var bgW = 601; // Default healthbar width
                var hbX:Float = (FlxG.width - bgW) / 2;
                
                var hbPosPref = getSettingString("kssette_healthbar_position", "Center");
                if (hbPosPref == "Left") {
                    hbX = 90;
                } else if (hbPosPref == "Right") {
                    hbX = FlxG.width - bgW - 90;
                }
                
                // Adjust to timebar's center
                hbX += (bgW - currentBgW) / 2;
                
                var downscrollValue = isDownscroll();
                var hbY:Float = downscrollValue ? FlxG.height * 0.11 : FlxG.height * 0.89;
                var hbH:Float = 19;
                var state = PlayState.instance;
                if (state != null && state.healthBarBG != null) {
                    hbY = state.healthBarBG.y;
                    hbH = state.healthBarBG.height;
                }
                cachedX = hbX;
                cachedY = downscrollValue ? hbY + hbH : hbY - currentBgH;
            default:
                cachedX = (FlxG.width - currentBgW) / 2;
                cachedY = FlxG.height - currentBgH;
        }

        timeBarBG.x = cachedX;
        timeBarBG.y = cachedY;
        
        if (isVertical) {
            timeBar.x = cachedX + 2;
            timeBar.y = cachedY;
        } else {
            timeBar.x = cachedX;
            timeBar.y = cachedY + 2;
        }
    }

    /**
     * Entry point for the options menu preview system.
     * Sets up the bar in preview mode (no PlayState required) and
     * immediately renders the current position/visibility settings.
     *
     * @param cam Camera to render the preview on.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        setupUI(cam);
        updatePreview();
    }

    /**
     * Refreshes the preview bar to reflect the current settings.
     * Re-reads the position and active state from KssetteApi, and updates
     * visibility and scaling to show a 50% progress example.
     */
    public function updatePreview() {
        if (!isPreview) return;

        cachedActive = isOn(getSetting("kssette_show_timebar"));
        timeBarPos = Std.string(getSetting("kssette_timebar_pos"));

        updatePositions();

        if (timeBarBG != null) timeBarBG.visible = cachedActive;
        if (timeBar != null) {
            timeBar.visible = cachedActive;
            var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isVertical) {
                timeBar.scale.y = 0.5;
                timeBar.scale.x = 1.0;
            } else {
                timeBar.scale.x = 0.5;
                timeBar.scale.y = 1.0;
            }
        }
    }

    /**
     * Called at the start of the song. Reads settings, builds the bar UI, and
     * initializes progress to 0. Resets preview mode if active.
     */
    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        isPreview = false;

        cachedActive = isOn(getSetting("kssette_show_timebar"));
        timeBarPos = Std.string(getSetting("kssette_timebar_pos"));

        trace("[KssetteTimeBar] onCountdownStart - active=" + cachedActive + " pos=" + timeBarPos);

        var state = PlayState.instance;
        songLengthMs = 0.0;
        updateTimer = 0.0;
        if (state != null && state.camHUD != null) {
            setupUI(hudCamera(state));
            songLengthMs = state.currentSongLengthMs;
            updatePositions();

            if (timeBarBG != null) timeBarBG.visible = cachedActive;
            if (timeBar != null) {
                timeBar.visible = cachedActive;
                var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
                if (isVertical) { timeBar.scale.y = 0; timeBar.scale.x = 1.0; }
                else            { timeBar.scale.x = 0; timeBar.scale.y = 1.0; }
            }
        }
    }

    /**
     * Hides the bar when the pause substate opens (only in edge mode).
     * Edge bars use a separate camera which would otherwise remain visible
     * over the pause overlay.
     */
    override public function onSubStateOpenBegin(event:SubStateScriptEvent) {
        super.onSubStateOpenBegin(event);
        if (event.targetState != null && Std.isOfType(event.targetState, PauseSubState)) {
            var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isBorder) {
                if (timeBarBG != null) timeBarBG.visible = false;
                if (timeBar != null) timeBar.visible = false;
            }
        }
    }

    /** Restores bar visibility when the pause substate closes (only in edge mode). */
    override public function onSubStateCloseEnd(event:SubStateScriptEvent) {
        super.onSubStateCloseEnd(event);
        if (event.targetState != null && Std.isOfType(event.targetState, PauseSubState)) {
            var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isBorder) {
                if (timeBarBG != null) timeBarBG.visible = cachedActive;
                if (timeBar != null) timeBar.visible = cachedActive;
            }
        }
    }

    /**
     * Per-frame update. Calculates song progress as a ratio of conductor position
     * to total song duration, then applies it to the bar's scale.
     *
     * Throttled to ~120Hz (0.008s) to prevent sprite regeneration every frame.
     * Also mirrors camHUD's visibility to the dedicated edge camera.
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        if (isPreview) return;

        var state = PlayState.instance;
        if (customCam != null && state?.camHUD != null) {
            if (customCam.visible != state.camHUD.visible) customCam.visible = state.camHUD.visible;
            if (customCam.alpha   != state.camHUD.alpha)   customCam.alpha   = state.camHUD.alpha;
        }

        if (!cachedActive || timeBar == null || !timeBar.exists || state == null || state.conductorInUse == null) return;

        // Intenta leer la duración de la canción si no estaba disponible al inicio de la cuenta atrás.
        if (songLengthMs <= 0.0) {
            songLengthMs = state.currentSongLengthMs;
        }    
        if (songLengthMs <= 0) return;

        updateTimer += elapsed;
        if (updateTimer < 0.008) return;
        updateTimer = 0.0;
        
        if (songLengthMs <= 0.0) return;
        var progress:Float = state.conductorInUse.songPosition / songLengthMs;
        if (progress < 0) progress = 0;
        else if (progress > 1) progress = 1;

        // Aplica el progreso al eje apropiado según la orientación.
        var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        if (isVertical) { timeBar.scale.y = progress; timeBar.scale.x = 1.0; }
        else            { timeBar.scale.x = progress; timeBar.scale.y = 1.0; }
    }
    
    override public function destroy() {
        if (timeBar != null) timeBar.destroy();
        if (timeBarBG != null) timeBarBG.destroy();
        
        timeBar = null;
        timeBarBG = null;

        super.destroy();
    }
}
