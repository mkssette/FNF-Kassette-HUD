package kassettehud.util;

/**
 * KssetteAccuracy
 *
 * Calculates and displays real-time player accuracy, score, misses, rank,
 * and combo tier during gameplay. Also manages the time display, song info
 * text, mode indicator marquee (Botplay/AutoPlay), and per-judgement counters.
 *
 * Accuracy modes (kssette_acc_mode):
 *   - "Classic"   - (hits - misses) / total * 100. Standard percentage.
 *   - "Ascending" - Same formula, but weighted by note progress so the value
 *                   starts at 0 and climbs toward the true percentage as notes
 *                   are processed.
 *   - "Off"       - Accuracy not displayed.
 *
 * Smooth display (kssette_smooth_display):
 *   When enabled, the displayed accuracy lerps toward the true value at 8x
 *   speed per frame rather than snapping instantly.
 *
 * Score bop (kssette_score_bop):
 *   Briefly scales the score text to 1.1x on every successful player note hit.
 *
 * Security system:
 *   If Botplay is active but the modeText marquee is hidden or mismatched,
 *   securityTriggered is set and the player strumline is disabled to prevent
 *   score abuse via HUD hiding.
 *
 * Settings managed:
 *   - kssette_acc_mode, kssette_show_score, kssette_show_misses
 *   - kssette_show_rank, kssette_show_tier, kssette_smooth_display
 *   - kssette_show_song_time, kssette_show_song_title, kssette_show_song_diff
 *   - kssette_score_bop, kssette_judge_pos, kssette_score_pos, kssette_info_pos
 *
 * Dependencies:
 *   - KssetteApi.getRankID()    - current letter rank
 *   - KssetteApi.getComboTier() - current combo tier string
 *   - KssetteApi.getModeMessage() - current mode label (Botplay, etc.)
 *   - Highscore.tallies          - live judgement counters
 */

import flixel.FlxG;
import funkin.modding.module.ModuleHandler;
import kassettehud.util.KassetteHUDElement;
import kassettehud.util.KssetteOptionsManager;
import kassettehud.util.KassetteHUDDatahunter;
import kassettehud.util.KssetteFontManager;
import funkin.play.PlayState;
import funkin.Paths;
import funkin.Preferences;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxTextFormat;
import flixel.util.FlxStringUtil;
import flixel.util.FlxColor;
import funkin.Highscore;
import flixel.FlxG;
import Std;
import Math;

class TinyNightAccuracy extends KassetteHUDElement {
    /** Text separator used between score, accuracy, rank, etc. */
    var separator:String = " / ";
    
    // Datahunters
    var songHunter:Dynamic = null;
    var scoreHunter:Dynamic = null;
    var gammodHunter:Dynamic = null;
    var iconHunter:Dynamic = null;
    
    /** Primary HUD text object (score, accuracy, rank, tier). */
    public var uiText:FlxText;
    /** Secondary text showing song title and/or difficulty. */
    public var infoText:FlxText; 
    /** Text showing remaining song time. */
    public var timeText:FlxText; 
    /** Scrolling marquee showing the current game mode (e.g., "Botplay"). */
    public var modeText:FlxText; 
    /** Label FlxText objects for each judgement counter (Sicks, Goods, etc.). */
    public var judgeLabels:Array<FlxText> = [];
    /** Value FlxText objects for each judgement counter. */
    public var judgeValues:Array<FlxText> = [];
    /** Header text ("Score | Rank") shown above the judgement counter panel. */
    public var judgeHeaderText:FlxText;
    /** Last text applied to judgeHeaderText, to avoid redundant rebuilds. */
    var _lastJudgeHeader:String = "";
    
    /** Judgement identifier strings shown in the panel. */
    public var judgeNames:Array<String> = ["sick", "good", "bad", "shit", "miss", "maxCombo"];
    
    /** Last cached score value; change detection guard. */
    var lastScore:Int = -1;
    /** Last cached miss count; change detection guard. */
    var lastMisses:Int = -1;
    /** Last cached max combo; change detection guard. */
    var lastMaxCombo:Int = -1;
    /** Last cached total notes hit; change detection guard. */
    var lastNotesHit:Int = -1;
    /** Last displayed remaining-time in seconds; change detection guard. */
    var lastTimeSeconds:Int = -1;
    /** Last displayed accuracy value; change detection guard. */
    var lastVisualAcc:Float = -1;
    
    /** Last cached sick count for the judge panel. */
    var lastSick:Int = -1;
    /** Last cached good count for the judge panel. */
    var lastGood:Int = -1;
    /** Last cached bad count for the judge panel. */
    var lastBad:Int = -1;
    /** Last cached shit count for the judge panel. */
    var lastShit:Int = -1;
    /** Last cached miss count for the judge panel. */
    var lastMissesJudge:Int = -1;
    /** Last cached max combo for the judge panel. */
    var lastMaxComboJudge:Int = -1;

    /** True if the anti-cheat system has been triggered. */
    var securityTriggered:Bool = false;
    /** Total player note count pre-computed from the chart. */
    var cachedTotalNotes:Int = -1;
    /** Adjusted actual note total (may differ when tallies exceed pre-count). */
    var cachedActualTotal:Int = -1;
    /** Accuracy value currently shown on screen (used for smooth lerp). */
    var displayedAcc:Float = 0;
    /** Timer that throttles UI text rebuilds to ~30fps (mobile: ~10fps). */
    var uiUpdateTimer:Float = 0.0;
    /** True when a UI text rebuild is pending on the next threshold tick. */
    var pendingTextUpdate:Bool = false;
    /** Timer used to simulate accuracy changes in the options menu preview. */
    var previewAccTimer:Float = 0.0;
    /** Per-frame throttle timer (~120Hz gate before any update logic runs). */
    var frameUpdateTimer:Float = 0.0;
    
    /** Cached HUD font string (from KssetteApi.getHudFont()). */
    public var cachedFont:String = "";

    /** Active FlxTextFormat applied to the rank portion of uiText. */
    var currentTargetFmt:FlxTextFormat = null;
    /** Cached character length of the formatted rank string. */
    var cachedRankLen:Int = 0;
    /** Prefix text built before the accuracy percentage. */
    var cachedPrefix:String = "";
    /** Suffix text built after the accuracy percentage (rank, tier). */
    var cachedSuffix:String = "";
    /** Whether a separator is needed between prefix and accuracy. */
    var prefixNeedsSepForAcc:Bool = false;
    /** Target accuracy value that displayedAcc lerps toward. */
    var targetAcc:Float = 0.0;

    // --- Cached FlxTextFormat instances (created once, reused each frame) ---
    var _fmtPerfectGold:FlxTextFormat;
    var _fmtPerfect:FlxTextFormat;
    var _fmtExcellent:FlxTextFormat;
    var _fmtGreat:FlxTextFormat;
    var _fmtGood:FlxTextFormat;
    var _fmtShit:FlxTextFormat;
    var _fmtDefault:FlxTextFormat;
    var _fmtUnranked:FlxTextFormat;
    var _fmtMult:FlxTextFormat;
    var _fmtHighscore:FlxTextFormat;
    /** Current hue angle for the rainbow highscore color animation. */
    var _rainbowHue:Float = 0.0;

    // --- Cached text content and format ranges (avoids unnecessary rebuilds) ---
    var _lastBuiltScoreInt:Int = -1;
    var _lastBuiltMisses:Int = -1;
    var _lastBuiltAcc:Float = -1;
    var _lastBuiltRank:String = "";
    var _lastBuiltTier:String = "";
    var _lastBuiltMult:Float = 1.0;
    var _lastBuiltUnranked:Bool = false;
    
    // Cached full text string and format range indices for efficient partial re-formatting.
    var _cachedText:String = "";
    var _unrankedStart:Int = -1;
    var _unrankedEnd:Int = -1;
    var _multStart:Int = -1;
    var _multEnd:Int = -1;
    var _scoreStart:Int = -1;
    var _scoreEnd:Int = -1;
    var _rankStart:Int = -1;

    /** Cached reference to options manager. */
    var optManager:Dynamic = null;
    // --- Cached option flags (read once per settings update) ---
    var _cShowScore:Bool = true;
    var _cShowMisses:Bool = true;
    var _cShowRank:Bool = true;
    var _cShowTier:Bool = true;
    var _cAccMode:String = "Classic";
    var _cJudgePos:String = "Off";
    var _cShowTime:Bool = true;
    var _cShowTitle:Bool = true;
    var _cShowDiff:Bool = true;
    var _cSmooth:Bool = false;
    var _cIsBotplay:Bool = false;
    var _cJudgesVisible:Bool = false;
    var _cScoreBop:Bool = false;
    var _bopTimer:Float = 0.0;

    /** Cached accuracy rank string (e.g. "PERFECT_GOLD"). */
    var cachedRankStr:String = "?";
    /** Cached combo tier string (e.g. "SFC", "GFC"). */
    var cachedTierStr:String = "N/A";
    /** Cached mode message string (e.g. "Botplay"); empty when no mode is active. */
    var cachedModeMsg:String = "";

    /** True when rendering in the options menu preview instead of gameplay. */

    /** Camera to render into during preview mode. */
    public var previewCam:FlxCamera = null;

    public function new() {
        super("TinyNightAccuracy");
        this.name = "TinyNightAccuracy";
    }

    /**
     * Destroys all UI text objects created by this module.
     * Called before rebuilding the UI or when leaving PlayState.
     */
    public function cleanupUI() {
        safeDestroy(uiText);
        safeDestroy(infoText);
        safeDestroy(timeText);
        safeDestroy(modeText);
        for (t in judgeLabels) safeDestroy(t);
        for (t in judgeValues) safeDestroy(t);
        judgeLabels = [];
        judgeValues = [];
        safeDestroy(judgeHeaderText);
        judgeHeaderText = null;
        _lastJudgeHeader = "";
    }

    /**
     * Creates a FlxText node with standard HUD formatting and adds it to the scene.
     *
     * @param x      X position.
     * @param y      Y position.
     * @param w      Field width (0 = auto).
     * @param text   Initial text content.
     * @param size   Font size in points.
     * @param align  Text alignment ("center", "left", "right").
     * @param z      Z-index for draw-order sorting.
     * @param cam    Camera to assign the text to.
     * @return       The created FlxText instance.
     */
    function makeText(x:Float, y:Float, w:Float, text:String, size:Int, align:String, z:Int, cam:FlxCamera):FlxText {
        var t = createText(x, y, w, text, size, FlxColor.WHITE, align);
        t.zIndex = z;
        safeAdd(t, cam);
        return t;
    }

    /**
     * Builds all UI text objects and adds them to the scene.
     * Destroys any existing UI first via cleanupUI().
     * @param cam  The HUD camera to assign all text nodes to.
     */
    public function setupUI(cam:FlxCamera) {
        cleanupUI();

        uiText = makeText(0, 0, 0, "", 18, "center", 100, cam);
        uiText.updateHitbox();

        timeText = makeText(0, 0, FlxG.width / 2 - 10, "", 28, "right", 2000, cam);
        infoText = makeText(0, 0, FlxG.width / 2 - 10, "", 16, "left", 2000, cam);
        modeText = makeText(FlxG.width, 200, 0, "", 24, "left", 2000, cam);
        judgeLabels = [];
        judgeLabels = [];
        judgeValues = [];
        
        judgeHeaderText = makeText(0, 0, 200, "", 18, "center", 100, cam);
        
        for (i in 0...judgeNames.length) {
            judgeLabels.push(makeText(0, 0, 200, getJudgeName(judgeNames[i]), 20, "left", 100, cam));
            judgeValues.push(makeText(0, 0, 200, "0", 20, "right", 100, cam));
        }
    }

    /**
     * Returns the cached or freshly-created FlxTextFormat for a given rank ID.
     * Colors match the in-game rank palettes (gold, purple, yellow, etc.).
     * The format's font is synchronized to the active uiText font on each call.
     *
     * @param rank  Rank ID (e.g. "PERFECT_GOLD", "GREAT").
     * @return      A FlxTextFormat with the appropriate color.
     */
    function getRankFormat(rank:String):FlxTextFormat {
        var fmt:FlxTextFormat = null;
        switch(rank.toUpperCase()) {
            case "PERFECT_GOLD":
                if (_fmtPerfectGold == null) _fmtPerfectGold = new FlxTextFormat(0xFFF9E859);
                fmt = _fmtPerfectGold;
            case "PERFECT":
                if (_fmtPerfect == null) _fmtPerfect = new FlxTextFormat(0xFFFFAEFF);
                fmt = _fmtPerfect;
            case "EXCELLENT":
                if (_fmtExcellent == null) _fmtExcellent = new FlxTextFormat(0xFFFFFFC5);
                fmt = _fmtExcellent;
            case "GREAT":
                if (_fmtGreat == null) _fmtGreat = new FlxTextFormat(0xFFDCE6F1);
                fmt = _fmtGreat;
            case "GOOD":
                if (_fmtGood == null) _fmtGood = new FlxTextFormat(0xFFE19978);
                fmt = _fmtGood;
            case "SHIT":
                if (_fmtShit == null) _fmtShit = new FlxTextFormat(0xFF4460B7);
                fmt = _fmtShit;
            default:
                if (_fmtDefault == null) _fmtDefault = new FlxTextFormat(0xFFFFFFFF);
                fmt = _fmtDefault;
        }
        
        if (fmt != null && fmt.format != null && uiText != null && uiText.textField != null && uiText.textField.defaultTextFormat != null) {
            fmt.format.font = uiText.textField.defaultTextFormat.font;
        }
        return fmt;
    }

    /**
     * Called at song start. Registers with KssetteApi, invalidates the rank
     * cache, pre-computes the total note count, builds the UI, and applies
     * initial position/settings.
     *
     * Also hides PlayState's built-in scoreText and re-adds strumline
     * backgrounds to camHUD for correct draw ordering.
     */
    override function onCountdownStart(event) {
        optManager = KssetteOptionsManager.instance;
        if (optManager == null) return;
        
        scoreHunter = KassetteHUDDatahunter.score;
        songHunter = KassetteHUDDatahunter.song;
        gammodHunter = KassetteHUDDatahunter.gammod;
        iconHunter = KassetteHUDDatahunter.icon;

        optManager.invalidateCache();
        
        var state = PlayState.instance;
        if (state == null) return;
        
        cachedTotalNotes = songHunter != null ? songHunter.getNoteCount() : 0;
        cachedActualTotal = -1;
        
        cachedRankStr = "?";
        cachedTierStr = "N/A";
        lastTimeSeconds = -1;
        lastVisualAcc = -1;
        
        lastSick = -1;
        lastGood = -1;
        lastBad = -1;
        lastShit = -1;
        lastMissesJudge = -1;
        lastMaxComboJudge = -1;
        
        uiUpdateTimer = 0.0;
        previewAccTimer = 0.0;
        frameUpdateTimer = 0.0;
        pendingTextUpdate = false;
        
        _lastP1Id = "";
        _lastP2Id = "";
        _hbUpdateTimer = 0.0;

        _lastBuiltScoreInt = -1;
        _lastBuiltMisses = -1;
        _lastBuiltAcc = -1;
        _lastBuiltRank = "";
        _lastBuiltTier = "";
        _lastBuiltMult = 1.0;
        _lastBuiltUnranked = false;
        _cachedText = "";
        
        cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        securityTriggered = false;
        displayedAcc = 0;
        isPreview = false;
        
        if (state.scoreText != null) state.scoreText.visible = false;

        if (state.playerStrumline != null) {
            var bg1 = state.playerStrumline?.background;
            if (bg1 != null) {
                state.playerStrumline.remove(bg1, true);
                bg1.zIndex = 10;
                bg1.cameras = [state.camHUD];
                state.add(bg1);
            }
        }
        if (state.opponentStrumline != null) {
            var bg2 = state.opponentStrumline?.background;
            if (bg2 != null) {
                state.opponentStrumline.remove(bg2, true);
                bg2.zIndex = 10;
                bg2.cameras = [state.camHUD];
                state.add(bg2);
            }
        }


            setupUI(state.camHUD);
            updateSettings();
            updatePositions();
            
            lastScore = -1; lastMisses = -1; lastMaxCombo = -1; lastNotesHit = -1;
            
            state.refresh();
    }

    /** Called on resume. Re-applies settings and positions in case options changed. */
    override public function onResume(event) {
        updateSettings();
        updatePositions();
    }

    /**
     * Entry point for the options menu preview. Sets up the HUD UI in preview
     * mode and renders a static example (score=123456, acc=100%, rank=P[GOLD]).
     * @param cam  The preview camera to render into.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        optManager = KssetteOptionsManager.instance;
        if (optManager != null) {
            cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        }
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        setupUI(cam);
        updatePreview();
    }

    /**
     * Refreshes the preview to show the current settings. Called by the
     * options menu whenever a relevant setting changes.
     */
    public function updatePreview() {
        if (!isPreview || uiText == null) return;
        
        if (optManager == null) optManager = KssetteOptionsManager.instance;
        if (optManager == null) return;

        updateSettings();
        updatePositions();
        
        if (_cAccMode != "Ascending") {
            updateAccuracyText(123456, 0, 100.00, "PERFECT_GOLD", "SFC");
            lastVisualAcc = 100.00;
        }
        trace("[KssetteAccuracy] updatePreview() called. uiText.text: " + uiText.text + " | y: " + uiText.y + " | isPreview: " + isPreview);

        for (i in 0...judgeLabels.length) {
            if (judgeValues[i] != null) {
                var fakeVal = 0;
                if (i == 0) fakeVal = 135;
                else if (i == 1) fakeVal = 12;
                else if (i == 5) fakeVal = 147;
                
                if (judgeValues[i].text != Std.string(fakeVal)) {
                    judgeValues[i].text = Std.string(fakeVal);
                }
            }
        }
    }

    /**
     * Reads and caches all relevant option values from KssetteApi.
     * Also updates font, text visibility, info text, time text, and judge labels.
     * Called at countdown start, on resume, and during preview updates.
     */
    function updateSettings() {
        if (optManager == null) return;
        
        var rawScore = false;
        _cShowScore = false;
        
        var rawMisses = false;
        _cShowMisses = false;
        
        var rawRank = false;
        _cShowRank = false;
        
        var rawTier = false;
        _cShowTier = false;
        
        _cAccMode = Std.string(optManager.getKssValue("kssette_acc_mode"));
        
        var rawJPos = optManager.getKssValue("kssette_judge_pos");
        _cJudgePos = Std.string(rawJPos);
        if (_cJudgePos == "null" || _cJudgePos == "") _cJudgePos = "Bottom";
        
        var rawSmooth = optManager.getKssValue("kssette_smooth_display");
        _cSmooth = (rawSmooth == true || Std.string(rawSmooth) == "On" || Std.string(rawSmooth) == "true");
        
        var rawTime = optManager.getKssValue("kssette_show_song_time");
        _cShowTime = (rawTime == true || Std.string(rawTime) == "On" || Std.string(rawTime) == "true");
        
        var rawTitle = optManager.getKssValue("kssette_show_song_title");
        _cShowTitle = false;
        
        var rawDiff = optManager.getKssValue("kssette_show_song_diff");
        _cShowDiff = false;
        
        var rawBop = optManager.getKssValue("kssette_score_bop");
        _cScoreBop = (rawBop == true || Std.string(rawBop) == "On" || Std.string(rawBop) == "true");
        
        var songHunter = KassetteHUDDatahunter.song;
        if (songHunter != null) {
            cachedModeMsg = Std.string(songHunter.getModeMessage());
        } else {
            cachedModeMsg = null;
        }
        
        _cIsBotplay = (cachedModeMsg != null && (cachedModeMsg.indexOf("Botplay") != -1 || cachedModeMsg.indexOf("AutoPlay") != -1));
        
        var optManager = KssetteOptionsManager.instance;
        if (optManager != null) {
            var jPos = Std.string(optManager.getKssValue("kssette_judge_pos"));
            _cJudgesVisible = (jPos != "Off" && jPos != "false" && jPos != "null");
        } else {
            _cJudgesVisible = true;
        }

        cachedFont = KssetteFontManager.instance != null ? KssetteFontManager.instance.getHudFont() : "VCR OSD Mono";
        if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";

        if (uiText != null && uiText.exists) {
            uiText.visible = true; 
            if (uiText.font != cachedFont) uiText.font = cachedFont;
        }

        if (infoText != null && infoText.exists) {
            if (infoText.font != cachedFont) infoText.font = cachedFont;
            infoText.visible = (_cShowTitle || _cShowDiff);
            if (infoText.visible) {
                var infoTextStr:String = "";
                if (isPreview) {
                    if (_cShowTitle) infoTextStr += "Preview Song";
                    if (_cShowDiff) {
                        if (infoTextStr != "") infoTextStr += " - ";
                        infoTextStr += "HARD";
                    }
                } else {
                    if (_cShowTitle) {
                        var sTitle = Std.string(songHunter.getSongTitle());
                        if (sTitle != "" && sTitle != "null") infoTextStr += sTitle;
                    }
                    if (_cShowDiff) {
                        if (infoTextStr != "") infoTextStr += " - ";
                        var sDiff = Std.string(songHunter.getDifficulty());
                        if (sDiff != "" && sDiff != "null") infoTextStr += sDiff;
                    }
                }
                
                if (infoText.text != infoTextStr) infoText.text = infoTextStr;
            }
        }

        if (timeText != null && timeText.exists) {
            if (timeText.font != cachedFont) timeText.font = cachedFont;
            timeText.visible = _cShowTime;
            if (isPreview && _cShowTime) {
                if (timeText.text != "[3:20]") timeText.text = "[3:20]";
            }
        }

        for (i in 0...judgeLabels.length) {
            if (judgeLabels[i] != null && judgeLabels[i].exists) {
                judgeLabels[i].visible = _cJudgesVisible;
                if (judgeLabels[i].font != cachedFont) judgeLabels[i].font = cachedFont;
            }
            if (judgeValues[i] != null && judgeValues[i].exists) {
                judgeValues[i].visible = _cJudgesVisible;
                if (judgeValues[i].font != cachedFont) judgeValues[i].font = cachedFont;
            }
        }
        
        if (judgeHeaderText != null && judgeHeaderText.exists) {
            judgeHeaderText.visible = _cJudgesVisible;
            if (judgeHeaderText.font != cachedFont) judgeHeaderText.font = cachedFont;
        }

        if (modeText != null && modeText.exists) {
            if (modeText.font != cachedFont) modeText.font = cachedFont;
        }
    }

    /**
     * Computes and applies the screen positions of all HUD text elements
     * based on downscroll mode, timebar position, score panel position,
     * and info panel position. Also lays out the judgement counter panel.
     */
    public function updatePositions() {
        if (uiText == null || !uiText.exists) return;
        
        var blockX:Float = 10.0;
        var blockW:Float = 260.0;
        var barBlockW:Float = 160.0;
        
        var lineH:Float = 26.0;
        var gapToUi:Float = 34.0;
        var reservedH:Float = 210.0;
        
        var songHunter = KassetteHUDDatahunter.song;
        var downscroll = false;
        if (songHunter != null) downscroll = songHunter.getDownscroll();
        else downscroll = Preferences.downscroll;
        
        var stackTopY:Float = downscroll ? 10.0 : (FlxG.height - reservedH - 10.0);
        
        if (timeText != null && timeText.exists && timeText.size != 20) timeText.size = 20;
        if (infoText != null && infoText.exists && infoText.size != 20) infoText.size = 20;
        if (uiText != null && uiText.exists && uiText.size != 20) uiText.size = 20;

        if (timeText != null) {
            // timeText is now positioned next to the judge counter
        }
        
        if (infoText != null) {
            infoText.setPosition(blockX, stackTopY + lineH);
            infoText.fieldWidth = blockW;
            infoText.alignment = "left";
        }
        
        uiText.setPosition(blockX, stackTopY + lineH + gapToUi);
        uiText.fieldWidth = barBlockW;
        uiText.alignment = "center";
        
        if (uiText.zIndex < 900) {
            uiText.zIndex = 1000;
        }
        
        var optManager = KssetteOptionsManager.instance;
        var jPos:String = "Left";
        var showTimeBar = false;
        var timeBarPos = "Top";
        
        if (optManager != null) {
            jPos = Std.string(optManager.getKssValue("kssette_judge_pos"));
            showTimeBar = optManager.getKssValue("kssette_show_timebar") == true;
            timeBarPos = Std.string(optManager.getKssValue("kssette_timebar_pos"));
        }

        var jMarginLeft:Float = 6;
        var jMarginRight:Float = 6;
        if (optManager != null && optManager.isMobileMode == true) {
            jMarginLeft = 85;
            jMarginRight = 85;
        }
        if (showTimeBar) {
            if (timeBarPos == "Vertical Left") jMarginLeft += 22;
            if (timeBarPos == "Vertical Right") jMarginRight += 22;
        }

        var tw = 200; var sy = 22; var sx = jMarginLeft; var sY = (FlxG.height - judgeNames.length * sy) * 0.5;
        if (jPos == "Right") sx = FlxG.width - tw - jMarginRight;
        if (jPos == "Top Right") { sx = FlxG.width - tw - jMarginRight; sY = 100; }
        
        if (judgeHeaderText != null) {
            judgeHeaderText.setPosition(sx, sY - 26);
            judgeHeaderText.fieldWidth = tw;
            judgeHeaderText.alignment = "left";
        }
        if (timeText != null) {
            timeText.setPosition(sx, sY - 26);
            timeText.fieldWidth = tw;
            timeText.alignment = "right";
        }
        
        for (i in 0...judgeLabels.length) {
            var nx = sx; var ny = sY + (i * sy);
            if (judgeLabels[i] != null) {
                if (judgeLabels[i].x != nx) judgeLabels[i].x = nx;
                if (judgeLabels[i].y != ny) judgeLabels[i].y = ny;
            }
            if (judgeValues[i] != null) {
                if (judgeValues[i].x != nx) judgeValues[i].x = nx;
                if (judgeValues[i].y != ny) judgeValues[i].y = ny;
            }
        }
    }

    /**
     * Builds the main uiText string and applies colored FlxTextFormat ranges
     * for score, rank, multiplier, and unranked status. The text is only fully
     * rebuilt when any relevant parameter changes; otherwise only format ranges
     * are re-applied for the highscore rainbow effect.
     *
     * @param scoreInt  Current integer score.
     * @param misses    Total miss count.
     * @param acc       Displayed accuracy percentage (already floored to 2dp).
     * @param rankStr   Rank identifier string (e.g. "PERFECT_GOLD").
     * @param tierStr   Combo tier string (e.g. "SFC").
     */
    public function updateAccuracyText(scoreInt:Int, misses:Int, acc:Float, rankStr:String, tierStr:String) {
        if (uiText == null || !uiText.exists) return;

        var isUnranked = false;
        var multiplierValue:Float = 1.0;
        var gammodHunter = KassetteHUDDatahunter.gammod;
        if (gammodHunter != null) {
            isUnranked = gammodHunter.gammodUnranked == true;
            if (gammodHunter.gammodMultiplier != null) multiplierValue = gammodHunter.gammodMultiplier;
        }
        
        var paramsChanged = (_lastBuiltScoreInt != scoreInt || _lastBuiltMisses != misses || _lastBuiltAcc != acc || _lastBuiltRank != rankStr || _lastBuiltTier != tierStr || _lastBuiltMult != multiplierValue || _lastBuiltUnranked != isUnranked);

        if (paramsChanged || _cachedText == "") {
            _unrankedStart = -1; _unrankedEnd = -1;
            _multStart = -1; _multEnd = -1;
            _scoreStart = -1; _scoreEnd = -1;
            _rankStart = -1;
            
            var scoreStr = FlxStringUtil.formatMoney(scoreInt, false, true);
            var strMain = "";
            var needSep = false;

            if (_cAccMode != "Off" && _cAccMode != "null" && _cAccMode != "false") {
                if (needSep) strMain += separator;
                
                var accStr = Std.string(acc);
                var dotIdx = accStr.indexOf(".");
                if (dotIdx == -1) {
                    accStr += ".00";
                } else if (accStr.length - dotIdx == 2) {
                    accStr += "0";
                }
                
                strMain += "Acc: " + accStr + "%";
                needSep = true;
            }

            cachedSuffix = "";
            var suffixNeedSep = false;

            if (_cShowTier) {
                if (suffixNeedSep) cachedSuffix += separator;
                cachedSuffix += tierStr;
            }

            var newText:String = "";
            if (strMain != "") newText += strMain;
            
            var rIdx:Int = newText.length;
            
            if (cachedSuffix != "") {
                if (newText != "") {
                    newText += separator;
                    rIdx += separator.length;
                }
                newText += cachedSuffix;
            }

            _rankStart = rIdx + 6;
            _cachedText = newText;

            _lastBuiltScoreInt = scoreInt;
            _lastBuiltMisses = misses;
            _lastBuiltAcc = acc;
            _lastBuiltRank = rankStr;
            _lastBuiltTier = tierStr;
            _lastBuiltMult = multiplierValue;
            _lastBuiltUnranked = isUnranked;
        }

        var isHighscore = false;
        var hsColor:Int = 0xFFFFFFFF;
        var gammodHunter = KassetteHUDDatahunter.gammod;
        if (gammodHunter != null && gammodHunter.gammodHighscoreActive == true) {
            isHighscore = true;
            hsColor = FlxColor.fromHSB(_rainbowHue, 1.0, 1.0);
        }

        var textChanged = (uiText.text != _cachedText);
        if (textChanged) {
            uiText.text = _cachedText;
        }

        if (textChanged || isHighscore) {
            uiText.clearFormats();

            var activeFontFamily:String = null;
            if (uiText.textField != null && uiText.textField.defaultTextFormat != null) {
                activeFontFamily = uiText.textField.defaultTextFormat.font;
            }

            if (_lastBuiltUnranked && _unrankedStart != -1) {
                if (_fmtUnranked == null) _fmtUnranked = new FlxTextFormat(0xFFFF0000);
                if (_fmtUnranked.format != null && activeFontFamily != null) _fmtUnranked.format.font = activeFontFamily;
                uiText.addFormat(_fmtUnranked, _unrankedStart, _unrankedEnd);
            }

            if (_lastBuiltMult != 1.0 && _multStart != -1) {
                if (_fmtMult == null) _fmtMult = new FlxTextFormat(0xFF66FFFF);
                if (_fmtMult.format != null && activeFontFamily != null) _fmtMult.format.font = activeFontFamily;
                uiText.addFormat(_fmtMult, _multStart, _multEnd);
            }

            if (isHighscore && _scoreStart != -1) {
                if (_fmtHighscore == null) _fmtHighscore = new FlxTextFormat(hsColor);
                else _fmtHighscore.format.color = hsColor;
                if (_fmtHighscore.format != null && activeFontFamily != null) _fmtHighscore.format.font = activeFontFamily;
                uiText.addFormat(_fmtHighscore, _scoreStart, _scoreEnd);
            }
        if (_cShowRank && currentTargetFmt != null && _rankStart != -1) {
                if (currentTargetFmt.format != null && activeFontFamily != null) currentTargetFmt.format.font = activeFontFamily;
                uiText.addFormat(currentTargetFmt, _rankStart, _rankStart + cachedRankLen);
            }
            // Removed uiText.screenCenter(0x01) for compact mode
        }
        
        if (judgeHeaderText != null && judgeHeaderText.exists) {
            var scoreStrH = FlxStringUtil.formatMoney(scoreInt, false, true);
            var rankStrH = _cShowRank ? formatRank(rankStr) : "";
            var headerStr = "Score: " + scoreStrH;
            var headerRankStart:Int = -1;

            if (rankStrH != "") {
                headerStr += " | ";
                headerRankStart = headerStr.length;
                headerStr += rankStrH;
            }

            var headerChanged = (headerStr != _lastJudgeHeader);
            if (headerChanged) {
                judgeHeaderText.text = headerStr;
                _lastJudgeHeader = headerStr;
            }

            if (headerChanged && _cShowRank && headerRankStart != -1) {
                judgeHeaderText.clearFormats();

                var rankFmtH = getRankFormat(rankStr);
                var activeFontFamilyH:String = null;
                if (judgeHeaderText.textField != null && judgeHeaderText.textField.defaultTextFormat != null) {
                    activeFontFamilyH = judgeHeaderText.textField.defaultTextFormat.font;
                }
                if (rankFmtH.format != null && activeFontFamilyH != null) rankFmtH.format.font = activeFontFamilyH;

                judgeHeaderText.addFormat(rankFmtH, headerRankStart, headerRankStart + rankStrH.length);
            }
        }
    }
    
    /**
     * Called on each note hit. Triggers the score bop animation when enabled,
     * and re-routes the hit to a miss if the security system has been triggered.
     * Only processes player notes (getMustHitNote == true).
     */
    override function onNoteHit(event) {
        super.onNoteHit(event);
        if (isPreview) return;

        if (securityTriggered) {
            event.cancel();
            if (PlayState.instance != null) PlayState.instance.noteMiss(event.note);
        }
        
        var note = event.note;
        if (note?.noteData != null) {
            var mh = note.noteData?.getMustHitNote();
            if (mh == null) mh = note.noteData?.mustHitNote;
            if (!mh) return;
        }

        if (_cScoreBop && uiText != null) {
            uiText.scale.set(1.1, 1.1);
        }
    }

    /**
     * Per-frame update. Manages three primary responsibilities:
     *
     * 1. Preview mode: simulates accuracy changes and reacts to preview triggers.
     * 2. Gameplay mode:
     *    a. Updates the time text countdown.
     *    b. Scrolls the mode marquee text.
     *    c. Runs the anti-cheat check (Botplay detection).
     *    d. Reads Highscore.tallies and computes target accuracy.
     *    e. Applies smooth accuracy lerp.
     *    f. Throttled UI text rebuild (~30fps, or immediately on major changes).
     */
    override public function onUpdate(event:Dynamic) {
        var elapsed:Float = (Std.isOfType(event, Float)) ? event : (event != null ? event.elapsed : 0);
        
        if (uiText != null && uiText.exists && _cScoreBop) {
            var bopElapsed = elapsed;
            if (bopElapsed > 0.016) bopElapsed = 0.016; 
            
            var lerpFactor = 1.0 - (bopElapsed * 15.0);
            if (lerpFactor < 0) lerpFactor = 0;
            var newX = 1.0 + ((uiText.scale.x - 1.0) * lerpFactor);
            var newY = 1.0 + ((uiText.scale.y - 1.0) * lerpFactor);
            
            if (Math.abs(newX - 1.0) > 0.001 || Math.abs(newY - 1.0) > 0.001) {
                uiText.scale.set(newX, newY);
            } else if (uiText.scale.x != 1.0 || uiText.scale.y != 1.0) {
                uiText.scale.set(1.0, 1.0);
            }
        }
        
        if (isPreview) {
            updateSettings();
            updatePositions();
            
            if (uiText != null && uiText.exists) {
                if (optManager != null) {
                    var newMode = _cAccMode;
                    if (newMode != _cAccMode) { // wait _cAccMode is already updated by updateSettings
                        lastVisualAcc = -1.0; 
                    }
                }
                
                if (_cScoreBop) {
                    if (KassetteHUDElement.preview_scoreBopTrigger) {
                        KassetteHUDElement.preview_scoreBopTrigger = false;
                        uiText.scale.set(1.1, 1.1);
                    }
                }
                
                var targetVisualAcc:Float = 100.0;
                if (_cAccMode == "Ascending") {
                    targetVisualAcc = KassetteHUDElement.preview_simulatedAcc;
                } else if (_cAccMode == "Classic") {
                    targetVisualAcc = 100.0;
                }
                
                if (!_cSmooth) {
                    displayedAcc = targetVisualAcc;
                } else {
                    displayedAcc += (targetVisualAcc - displayedAcc) * (elapsed * 8);
                    if (Math.abs(targetVisualAcc - displayedAcc) < 0.001) displayedAcc = targetVisualAcc;
                }
                
                var visualAcc:Float = Math.floor(displayedAcc * 100) / 100;
                
                frameUpdateTimer += elapsed;
                if (visualAcc != lastVisualAcc && frameUpdateTimer > 0.033) {
                    frameUpdateTimer = 0.0;
                    lastVisualAcc = visualAcc;
                    updateAccuracyText(123456, 0, visualAcc, "PERFECT_GOLD", "SFC");
                }
            }
            return;
        }

        var state = PlayState.instance;


        if (!securityTriggered) {
            frameUpdateTimer += elapsed;
            if (frameUpdateTimer < 0.008) return;
            elapsed = frameUpdateTimer;
            frameUpdateTimer = 0.0;
        } else {
            frameUpdateTimer = 0.0;
        }

        if (state == null || optManager == null) return;
        
        if (timeText != null && timeText.exists) {
            var showT:Bool = _cShowTime;
            timeText.visible = showT;
            if (showT && state.conductorInUse != null) {
                var remainingSeconds:Int = Math.floor((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000);
                if (remainingSeconds < 0) remainingSeconds = 0;
                
                if (remainingSeconds != lastTimeSeconds) {
                    lastTimeSeconds = remainingSeconds;
                    timeText.text = "[" + FlxStringUtil.formatTime(remainingSeconds, false) + "]";
                }
            }
        }

        if (modeText != null && modeText.exists) {
            if (cachedModeMsg != "" && cachedModeMsg != "null") {
                if (modeText.text != cachedModeMsg) modeText.text = cachedModeMsg;
                if (!modeText.visible) modeText.visible = true;
                if (modeText.alpha != 1) modeText.alpha = 1;
                
                modeText.x -= 200 * elapsed;
                if (modeText.x + modeText.width < 0) modeText.x = FlxG.width;
            } else {
                if (modeText.visible) modeText.visible = false; 
            }
        }

        if (_cIsBotplay) {
            if (!state.startingSong && !state.isEndingSong && uiText != null && uiText.exists) {
                if (modeText == null || !modeText.exists || !modeText.visible || modeText.alpha <= 0 || modeText.text != cachedModeMsg) {
                    securityTriggered = true;
                }
            }
        }

        if (securityTriggered) {
            if (state.playerStrumline != null) {
                state.playerStrumline.visible = false;
                var targets = state.playerStrumline.getNotesMayHit();
                if (targets != null) {
                    for (note in targets) {
                        if (note != null && note.alive && !note.hasBeenHit) {
                            note.hasBeenHit = true;
                            state.noteMiss(note);
                        }
                    }
                }
            }
            if (state.health > 0) state.health -= 0.005;
        }

        if (uiText == null || !uiText.exists) return;

        var t = Highscore.tallies;
        var m:Int = (t != null) ? t.missed : 0;
        var h:Int = (t != null) ? t.totalNotesHit : 0;
        var c:Int = (t != null) ? t.maxCombo : 0;
        var currentScoreInt:Int = Math.floor(state.songScore);

        var majorChange:Bool = (m != lastMisses || h != lastNotesHit || c != lastMaxCombo);
        var minorChange:Bool = (currentScoreInt != lastScore);

        if (cachedActualTotal == -1 && t != null) {
            var tn = t?.totalNotes;
            if (tn != null && tn > 0) cachedActualTotal = Std.int(tn);
            if (cachedActualTotal <= 0) cachedActualTotal = cachedTotalNotes;
        }

        if (majorChange) {
            if (_cJudgesVisible && t != null) {
                if (t.sick != lastSick) { judgeValues[0].text = Std.string(t.sick); lastSick = t.sick; }
                if (t.good != lastGood) { judgeValues[1].text = Std.string(t.good); lastGood = t.good; }
                if (t.bad != lastBad) { judgeValues[2].text = Std.string(t.bad); lastBad = t.bad; }
                if (t.shit != lastShit) { judgeValues[3].text = Std.string(t.shit); lastShit = t.shit; }
                if (t.missed != lastMissesJudge) { judgeValues[4].text = Std.string(t.missed); lastMissesJudge = t.missed; }
                if (t.maxCombo != lastMaxComboJudge) { judgeValues[5].text = Std.string(t.maxCombo); lastMaxComboJudge = t.maxCombo; }
            }

            lastMisses = m;
            lastMaxCombo = c;
            lastNotesHit = h;
            
            if (_cShowRank && scoreHunter != null) cachedRankStr = scoreHunter.getRankID(state);
            if (_cShowTier && scoreHunter != null) cachedTierStr = scoreHunter.getComboTier(state);

            targetAcc = 0.0;
            if (_cAccMode == "Ascending") {
                if (t != null) {
                    var totalHits:Int = t.totalNotesHit + t.missed;
                    if (totalHits > 0) {
                        var rawAcc:Float = ((t.sick + t.good - t.missed) / totalHits) * 100;
                        var realAcc:Float = Math.floor(Math.max(0, rawAcc) * 100) / 100;

                        var processed:Int = t.sick + t.good + t.bad + t.shit + t.missed;
                        var totalPlayerNotes:Int = cachedActualTotal;
                        
                        if (processed > totalPlayerNotes) totalPlayerNotes = processed;

                        var noteProgress:Float = (totalPlayerNotes > 0) ? (processed / totalPlayerNotes) : 1.0;
                        if (noteProgress > 1.0) noteProgress = 1.0;
                        
                        var songProgress:Float = 0.0;
                        if (state.currentSongLengthMs > 0 && state.conductorInUse != null) {
                            songProgress = state.conductorInUse.songPosition / state.currentSongLengthMs;
                        }
                        if (Math.isNaN(songProgress) || songProgress < 0) songProgress = 0;
                        if (songProgress >= 0.995) noteProgress = 1.0;
                        
                        targetAcc = realAcc * noteProgress;
                    }
                }
            } else if (_cAccMode == "Classic") {
                if (t != null) {
                    var totalHits:Int = t.totalNotesHit + t.missed;
                    if (totalHits > 0) {
                        var raw:Float = ((t.sick + t.good - t.missed) / totalHits) * 100;
                        targetAcc = Math.floor(Math.max(0, raw) * 100) / 100;
                    }
                }
            }

            if (!_cSmooth) displayedAcc = targetAcc;
        }

        if (_cAccMode != "Off" && _cAccMode != "null" && _cAccMode != "false") {
            if (_cSmooth) {
                var tAcc = displayedAcc;
                if (majorChange) {
                    tAcc = targetAcc;
                } else if (_cAccMode == "Ascending" && t != null) {
                    var totalHits:Int = t.totalNotesHit + t.missed;
                    if (totalHits > 0) {
                        var rawAcc:Float = ((t.sick + t.good - t.missed) / totalHits) * 100;
                        var realAcc:Float = Math.floor(Math.max(0, rawAcc) * 100) / 100;
                        
                        var processed:Int = t.sick + t.good + t.bad + t.shit + t.missed;
                        var totalPlayerNotes:Int = cachedActualTotal;
                        
                        if (processed > totalPlayerNotes) totalPlayerNotes = processed;
                        var noteProgress:Float = (totalPlayerNotes > 0) ? (processed / totalPlayerNotes) : 1.0;
                        if (noteProgress > 1.0) noteProgress = 1.0;
                        
                        var songProgress:Float = 0.0;
                        if (state.currentSongLengthMs > 0 && state.conductorInUse != null) {
                            songProgress = state.conductorInUse.songPosition / state.currentSongLengthMs;
                        }
                        if (songProgress >= 0.995) noteProgress = 1.0;
                        tAcc = realAcc * noteProgress;
                    }
                } else if (_cAccMode == "Classic") {
                    tAcc = targetAcc;
                }
                
                displayedAcc += (tAcc - displayedAcc) * (elapsed * 8);
                if (Math.abs(tAcc - displayedAcc) < 0.001) displayedAcc = tAcc;
            }
        }

        var visualAcc:Float = Math.floor(displayedAcc * 100) / 100;
        var accTextChanged:Bool = (visualAcc != lastVisualAcc);

        var gammodChanged:Bool = false;
        var gammodHunter = KassetteHUDDatahunter.gammod;
        if (gammodHunter != null) {
            if (_lastBuiltUnranked != (gammodHunter.gammodUnranked == true)) gammodChanged = true;
            var currentMult:Float = gammodHunter.gammodMultiplier != null ? gammodHunter.gammodMultiplier : 1.0;
            if (Math.abs(_lastBuiltMult - currentMult) > 0.001) gammodChanged = true;
        }

        if (majorChange || minorChange || accTextChanged || gammodChanged) {
            pendingTextUpdate = true;
        }

        var gammodHunter = KassetteHUDDatahunter.gammod;
        if (gammodHunter != null && gammodHunter.gammodHighscoreActive == true) {
            _rainbowHue += elapsed * 150;
            if (_rainbowHue >= 360) _rainbowHue -= 360;
            pendingTextUpdate = true;
        }

        uiUpdateTimer += elapsed;
        
        var updateThreshold:Float = 0.033; // ~30 fps
        var optManager = KssetteOptionsManager.instance;
        if (optManager != null && optManager.isMobileMode == true) {
            updateThreshold = 0.1; // fuck you jetsam
        }
        
        if (pendingTextUpdate && (majorChange || uiUpdateTimer >= updateThreshold)) {
            uiUpdateTimer = 0.0;
            pendingTextUpdate = false;
            
            lastScore = currentScoreInt;
            lastVisualAcc = visualAcc;

            updateAccuracyText(lastScore, m, visualAcc, cachedRankStr, cachedTierStr);
        }
    }
    
    override public function destroy() {
        if (uiText != null) uiText.destroy();
        if (infoText != null) infoText.destroy();
        if (timeText != null) timeText.destroy();
        if (modeText != null) modeText.destroy();
        
        uiText = null;
        infoText = null;
        timeText = null;
        modeText = null;
        
        currentTargetFmt = null;
        _fmtPerfectGold = null;
        _fmtPerfect = null;
        _fmtExcellent = null;
        _fmtGreat = null;
        _fmtGood = null;
        _fmtShit = null;
        _fmtDefault = null;
        _fmtUnranked = null;
        _fmtMult = null;
        _fmtHighscore = null;
        
        super.destroy();
    }
}
